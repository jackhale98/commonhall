{
  "name": "civic-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "site",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w site",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run check -w site",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "backfill": "tsx scripts/backfill.ts",
    "gen:types": "openapi-typescript packages/congress-client/openapi/openapi.json -o packages/congress-client/src/generated/openapi.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "verify:votes": "tsx scripts/verify-votes.ts --sample 10",
    "verify:reps": "tsx scripts/verify-reps.ts",
    "seed:make": "tsx scripts/make-seed.ts",
    "demo:export": "tsx scripts/export-demo.ts",
    "load-districts": "tsx scripts/load-districts.ts",
    "job": "tsx scripts/run-job.ts",
    "check:polis": "tsx scripts/check-polis-privacy.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.56.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
