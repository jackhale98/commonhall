# Site build (public: these end up in the browser bundle; safe only because RLS is on everywhere)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SITE_NAME=Civic Tracker

# GitHub Pages project page: SITE_URL=https://<user>.github.io BASE_PATH=/<repo>/
SITE_URL=http://localhost:4321
BASE_PATH=/

# Server-side only: Edge Function secrets and GitHub Actions secrets. Never prefix with PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=
CONGRESS_API_KEY=
OPENSTATES_API_KEY=
