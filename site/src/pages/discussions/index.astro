---
import LiveDiscussions from '../../components/LiveDiscussions';
import Base from '../../layouts/Base.astro';
import { loadDiscussions } from '../../lib/build-data';
import { href } from '../../lib/paths';

const discussions = await loadDiscussions();
---

<Base
  title="Discussions"
  description="Public discussions on Boston council matters, Massachusetts and federal bills, executive orders and Supreme Court decisions, powered by Pol.is."
  section="discussions"
>
  <header class="page-head wash">
    <p class="kicker">Discussions</p>
    <h1>Have your say</h1>
    <p class="lede">
      Each discussion asks one question about a council matter, a bill, an executive order or a Supreme Court decision.
      It takes a minute: vote on short statements, add your own, and see where people agree and where opinion splits.
    </p>
    <ol class="how">
      <li>
        <span>1</span>
        <p>
          <strong>Vote</strong> agree, disagree or pass on statements from other people.
        </p>
      </li>
      <li>
        <span>2</span>
        <p>
          <strong>Add</strong> your own point in a sentence or two.
        </p>
      </li>
      <li>
        <span>3</span>
        <p>
          <strong>See</strong> the groups of opinion form, and what nearly everyone agrees on.
        </p>
      </li>
    </ol>
    <p class="small muted">
      Maintainers choose topics; you can ask for one from any council matter, bill, executive order or decision page.{' '}
      <a href={href('moderation/')}>Discussion rules</a> · <a href={href('privacy/')}>Privacy</a>
    </p>
  </header>

  <LiveDiscussions client:idle initial={discussions} grouped empty="No open discussions right now." />
</Base>

<style>
  .how {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 var(--space-4);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .how li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    align-items: start;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .how p {
    margin: 0;
  }
  .how span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-weight: 700;
  }
  .how strong {
    color: var(--text);
  }
</style>
