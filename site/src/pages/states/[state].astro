---
import LiveDiscussions from '../../components/LiveDiscussions';
import FollowButton from '../../components/FollowButton';
import MemberChip from '../../components/MemberChip';
import MemberPhoto from '../../components/MemberPhoto';
import StateBills from '../../components/StateBills';
import DistrictMap from '../../components/viz/DistrictMap';
import Hemicycle from '../../components/viz/Hemicycle';
import Base from '../../layouts/Base.astro';
import {
  loadDiscussions,
  loadCouncilDistricts,
  loadLocalOfficials,
  loadMembers,
  loadRecentStateBills,
  loadStateLegislators,
} from '../../lib/build-data';
import { LEGISLATURE_STATES, STATE_CODES, memberRole, stateName } from '../../lib/format';
import { href, localOfficialHref } from '../../lib/paths';

export function getStaticPaths() {
  return STATE_CODES.map((code) => ({ params: { state: code.toLowerCase() }, props: { code } }));
}

interface Props {
  code: string;
}

const { code } = Astro.props;
const name = stateName(code);
const members = [...(await loadMembers()).values()].filter((m) => m.current && m.state === code);
const senators = members.filter((m) => m.chamber === 'senate').sort((a, b) => a.name.localeCompare(b.name));
const reps = members.filter((m) => m.chamber === 'house').sort((a, b) => (a.district ?? 0) - (b.district ?? 0));
const hasLegislature = LEGISLATURE_STATES.includes(code);
const legislators = hasLegislature ? ((await loadStateLegislators()).get(code) ?? []) : [];
const { bills: stateBills } = hasLegislature ? await loadRecentStateBills(code) : { bills: [] };
const districtSort = (a: { district: string | null; name: string }, b: { district: string | null; name: string }) =>
  (Number(a.district) || 0) - (Number(b.district) || 0) ||
  (a.district ?? '').localeCompare(b.district ?? '') ||
  a.name.localeCompare(b.name);
const chambers = [
  { key: 'upper', label: code === 'NE' ? 'Legislature' : code === 'DC' ? 'Council' : 'Senate' },
  { key: 'lower', label: 'House' },
  { key: 'legislature', label: code === 'DC' ? 'Council' : 'Legislature' },
]
  .map((c) => ({ ...c, people: legislators.filter((l) => l.chamber === c.key).sort(districtSort) }))
  .filter((c) => c.people.length > 0);
const partyGroups = (people: { party: string | null }[]) => {
  const n = { D: 0, I: 0, R: 0 };
  for (const p of people) {
    const k = (p.party ?? '').charAt(0);
    n[k === 'D' || k === 'R' ? k : 'I'] += 1;
  }
  return [
    { label: 'Democrats', seats: n.D, tone: 'fill-party-d' },
    { label: 'Other', seats: n.I, tone: 'fill-party-i' },
    { label: 'Republicans', seats: n.R, tone: 'fill-party-r' },
  ];
};
// Massachusetts: the Boston City Council is covered too.
const [districts, officials] =
  code === 'MA' ? await Promise.all([loadCouncilDistricts(), loadLocalOfficials()]) : [[], []];
// Massachusetts and Boston discussions, on the Massachusetts page.
const localDiscussions =
  code === 'MA'
    ? (await loadDiscussions()).filter(
        (d) => d.status === 'open' && (d.jurisdiction === 'ma' || d.jurisdiction === 'boston'),
      )
    : [];
const districtFeatures = districts.map((d) => {
  const o = officials.find((x) => x.district === d.district);
  return {
    district: d.district,
    geojson: d.geojson,
    href: o ? localOfficialHref(o.id) : href('boston/'),
    title: `District ${d.district}${o ? `: ${o.name}` : ''}`,
  };
});
---

<Base title={name} description={`${name}’s members of Congress, state legislators and state bills.`} section="states">
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('states/')}>States</a> › {name}
  </nav>
  <h1>{name}</h1>

  {chambers.length > 0 && (
    <section aria-labelledby="glance-h">
      <h2 id="glance-h" class="h-small">
        Legislature at a glance
      </h2>
      <div class="panel glance">
        {chambers.map((c) => (
          <Hemicycle title={`${c.label} (${c.people.length})`} groups={partyGroups(c.people)} />
        ))}
      </div>
    </section>
  )}

  {code === 'MA' && (
    <section aria-labelledby="local-h">
      <h2 id="local-h">Local government</h2>
      <a class="card local-card" href={href('boston/')}>
        <div>
          <p class="kicker">City of Boston</p>
          <strong>Boston City Council</strong>
          <p class="small muted">
            {officials.length > 0 ? `${officials.length} councilors` : 'Councilors'} across nine districts and four
            at-large seats: ordinances, orders, resolutions and meetings.
          </p>
        </div>
        {districtFeatures.length > 0 && (
          <div class="local-map" aria-hidden="true">
            <DistrictMap
              features={districtFeatures.map((f) => ({ ...f, href: undefined }))}
              label="Boston council districts"
              width={240}
            />
          </div>
        )}
      </a>
      <h3>Have your say</h3>
      <LiveDiscussions
        client:idle
        initial={localDiscussions}
        jurisdictions={['ma', 'boston']}
        empty="No Massachusetts or Boston discussion is open right now."
      />
      <p class="small muted">
        You can ask for a public discussion on any Massachusetts bill or Boston council matter from its page.
      </p>
    </section>
  )}

  <section aria-labelledby="fed-h">
    <h2 id="fed-h">In Congress</h2>
    {members.length === 0 && <p class="muted">No members on file.</p>}
    <ul class="grid people">
      {[...senators, ...reps].map((m) => (
        <li class="card person">
          <MemberPhoto name={m.name} url={m.photo_url} bioguideId={m.bioguide_id} size={56} />
          <div>
            <MemberChip member={m} />
            <p class="small muted">{memberRole(m)}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  {hasLegislature && (
    <>
      <section aria-labelledby="bills-h">
        <h2 id="bills-h">Recent state bills</h2>
        <StateBills client:visible state={code} initial={stateBills} />
      </section>
      <section aria-labelledby="leg-h">
        <h2 id="leg-h">State legislators</h2>
        {legislators.length === 0 && <p class="muted">Not loaded yet.</p>}
        {chambers.map((c) => (
          <details class="chamber" open={chambers.length === 1}>
            <summary>
              <h3 class="h-small">
                {c.label} <span class="muted">({c.people.length})</span>
              </h3>
            </summary>
            <ul class="list">
              {c.people.map((l) => (
                <li class="legislator">
                  <span>
                    {l.openstates_url ? (
                      <a href={l.openstates_url} rel="noopener">
                        {l.name}
                      </a>
                    ) : (
                      l.name
                    )}
                    <span class="small muted">
                      {' '}
                      · {l.party ?? 'Party unknown'}
                      {l.district && ` · District ${l.district}`}
                    </span>
                  </span>
                  <FollowButton client:visible targetType="state_legislator" targetId={l.id} label={l.name} />
                </li>
              ))}
            </ul>
          </details>
        ))}
        <p class="small muted">
          State data from <a href="https://openstates.org/">Open States</a>, refreshed nightly.
        </p>
      </section>
    </>
  )}
</Base>

<style is:global>
  .legislator,
  .state-bill {
    display: flex;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
  }
  .state-bill p {
    margin: 0;
  }
  .bill-title-sm {
    font-family: var(--font-serif);
    font-size: var(--step-1);
  }
  .bill-title-sm a {
    color: var(--text);
  }
  details.chamber summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  details.chamber summary::before {
    content: '▸';
  }
  details.chamber[open] summary::before {
    content: '▾';
  }
  details.chamber summary::-webkit-details-marker {
    display: none;
  }
  details.chamber summary {
    list-style: none;
  }
  details.chamber summary h3 {
    display: inline;
  }
</style>

<style>
  .glance {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .local-card {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    grid-template-columns: 1fr;
    border-left: 5px solid var(--highlight);
  }
  @media (min-width: 40rem) {
    .local-card {
      grid-template-columns: 1fr 14rem;
    }
  }
  .local-card strong {
    font-size: var(--step-1);
  }
  .people {
    list-style: none;
    padding: 0;
  }
  .person {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .person p {
    margin: 0;
  }
</style>
