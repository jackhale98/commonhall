---
import Hemicycle from '../../components/viz/Hemicycle';
import MemberPhoto from '../../components/MemberPhoto';
import StateHeader from '../../components/StateHeader.astro';
import Base from '../../layouts/Base.astro';
import {
  loadRecentStateBills,
  loadStateExecutives,
  loadStateLegislators,
  loadStateSessions,
} from '../../lib/build-data';
import { LEGISLATURE_STATES, STATE_CODES, formatDate, stateName } from '../../lib/format';
import { href, stateBillHref } from '../../lib/paths';
import { chamberLabel, executiveRank, linkHost, sessionStatus } from '../../lib/state-people';
import { LOCAL_GOVERNMENTS, legislatureChambers, partyGroups } from '../../lib/state-tabs';

export function getStaticPaths() {
  return STATE_CODES.map((code) => ({ params: { state: code.toLowerCase() }, props: { code } }));
}

interface Props {
  code: string;
}

const { code } = Astro.props;
const name = stateName(code);
const base = `states/${code.toLowerCase()}/`;
const hasLegislature = LEGISLATURE_STATES.includes(code);
const legislators = hasLegislature ? ((await loadStateLegislators()).get(code) ?? []) : [];
const chambers = legislatureChambers(code, legislators, (c) => chamberLabel(code, c));
const { bills } = hasLegislature ? await loadRecentStateBills(code) : { bills: [] };
const LATEST = 3;
// Statewide officials, governor first; and where the legislature is in its calendar.
const executives = ((await loadStateExecutives()).get(code) ?? []).sort(
  (a, b) => executiveRank(a.role) - executiveRank(b.role) || a.name.localeCompare(b.name),
);
const session = sessionStatus((await loadStateSessions()).get(code) ?? [], new Date().toISOString().slice(0, 10));
const cities = LOCAL_GOVERNMENTS[code] ?? [];
---

<Base
  title={name}
  description={`${name}’s legislature, statewide officials, state bills and members of Congress.`}
  section="states"
>
  <StateHeader code={code} current="overview" />

  {session && <p class="small muted session-line">{session}</p>}

  {chambers.length > 0 && (
    <section aria-labelledby="glance-h">
      <div class="section-head">
        <h2 id="glance-h" class="h-small">
          State legislature at a glance
        </h2>
        <a class="see-all" href={href(`${base}legislature/`)}>
          Legislators
        </a>
      </div>
      <div class={`panel glance glance-${chambers.length}`}>
        {chambers.map((c) => (
          <Hemicycle title={`${c.label} (${c.people.length})`} groups={partyGroups(c.people)} />
        ))}
      </div>
    </section>
  )}

  {executives.length > 0 && (
    <section class="officials-section" aria-labelledby="officials-h">
      <h2 id="officials-h" class="h-small">
        Statewide officials
      </h2>
      <ul class="plain-rows officials">
        {executives.map((e) => (
          <li>
            <MemberPhoto name={e.name} url={e.photo_url} size={40} />
            <span class="official-text">
              {e.links[0] ? (
                <a href={e.links[0]} rel="noopener" title={`Official site (${linkHost(e.links[0])})`}>
                  {e.name}
                </a>
              ) : (
                <strong>{e.name}</strong>
              )}
              <span class="small muted">
                {e.role}
                {e.party && ` · ${e.party}`}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {bills.length > 0 && (
    <section aria-labelledby="latest-h">
      <div class="section-head">
        <h2 id="latest-h" class="h-small">
          Latest state bills
        </h2>
        <a class="see-all" href={href(`${base}bills/`)}>
          All bills
        </a>
      </div>
      <ul class="plain-rows latest-bills">
        {bills.slice(0, LATEST).map((b) => (
          <li>
            <p class="meta">
              {b.identifier}
              {b.latest_action_date && ` · ${formatDate(b.latest_action_date)}`}
            </p>
            <p class="bill-title-sm">
              <a href={stateBillHref(b.state, b.session, b.identifier)}>{b.title}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {cities.map((c) => (
    <a class="card local-card" href={href(c.path)}>
      <span class="kicker">Local government</span>
      <strong>{c.name}</strong>
      <span class="small muted">{c.summary} →</span>
    </a>
  ))}
</Base>

<style>
  .glance {
    display: grid;
    gap: var(--space-3);
  }
  /* Two chambers sit side by side, even on a phone. */
  .glance-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .glance :global(.legend) {
    font-size: 0.78rem;
  }
  .local-card {
    display: grid;
    gap: var(--space-1);
    border-left: 5px solid var(--highlight);
    text-decoration: none;
    color: var(--text);
    margin-block: var(--space-5);
  }
  .local-card .kicker {
    margin: 0;
  }
  .local-card strong {
    font-size: var(--step-1);
  }
</style>
