---
import { safeUrl } from '@civic/congress-client/safe-url';
import Hemicycle from '../../components/viz/Hemicycle';
import MemberPhoto from '../../components/MemberPhoto';
import StateHeader from '../../components/StateHeader.astro';
import Base from '../../layouts/Base.astro';
import {
  loadBallotQuestions,
  loadRecentStateBills,
  loadStateCourtCases,
  loadStateExecutives,
  loadStateLegislators,
  loadStateOrders,
  loadStateSessions,
} from '../../lib/build-data';
import { LEGISLATURE_STATES, STATE_CODES, formatDate, stateName } from '../../lib/format';
import {
  ballotHref,
  cityHref,
  href,
  stateBillHref,
  stateCourtCaseHref,
  stateOrderHref,
  stateOrderId,
} from '../../lib/paths';
import { chamberLabel, executiveRank, linkHost, sessionStatus } from '../../lib/state-people';
import { STATE_COURT_NAMES, legislatureChambers, partyGroups } from '../../lib/state-tabs';
import { citiesIn } from '../../lib/cities';
import { electionLabel } from '../../lib/ballot';

export function getStaticPaths() {
  return STATE_CODES.map((code) => ({ params: { state: code.toLowerCase() }, props: { code } }));
}

interface Props {
  code: string;
}

const { code } = Astro.props;
const name = stateName(code);
const base = `states/${code.toLowerCase()}/`;
const hasLegislature = LEGISLATURE_STATES.includes(code);
const legislators = hasLegislature ? ((await loadStateLegislators()).get(code) ?? []) : [];
const chambers = legislatureChambers(code, legislators, (c) => chamberLabel(code, c));
const { bills } = hasLegislature ? await loadRecentStateBills(code) : { bills: [] };
const LATEST = 3;
// Statewide officials, governor first; and where the legislature is in its calendar.
const executives = ((await loadStateExecutives()).get(code) ?? []).sort(
  (a, b) => executiveRank(a.role) - executiveRank(b.role) || a.name.localeCompare(b.name),
);
const session = sessionStatus(
  (await loadStateSessions()).get(code) ?? [],
  new Date().toISOString().slice(0, 10),
  bills[0]?.latest_action_date,
);
// The next election's statewide questions, until Election Day.
const ballotToday = new Date().toISOString().slice(0, 10);
const upcomingBallot = ((await loadBallotQuestions()).get(code) ?? []).filter((q) => q.election_date >= ballotToday);
const ballotDate = upcomingBallot.map((q) => q.election_date).sort()[0];
const ballot = upcomingBallot.filter((q) => q.election_date === ballotDate);
const cities = citiesIn(code);
// The governor's latest order and the high court's latest decision, when we have them.
const [stateOrders, stateCases] = await Promise.all([loadStateOrders(), loadStateCourtCases()]);
const latestOrder = stateOrders.get(code)?.[0];
const latestCase = stateCases.get(code)?.[0];
---

<Base
  title={name}
  description={`${name}’s legislature, statewide officials, state bills and members of Congress.`}
  section="states"
>
  <StateHeader code={code} current="overview" />

  {session && <p class="small muted session-line">{session}</p>}

  {ballot.length > 0 && (
    <section aria-labelledby="ballot-h">
      <div class="section-head">
        <h2 id="ballot-h" class="h-small">
          On the ballot: {electionLabel(ballotDate!)}
        </h2>
        <a class="see-all" href={ballotHref(code)}>
          All {ballot.length} questions
        </a>
      </div>
      <div class="panel">
        <ol class="list ballot-glance">
          {ballot.map((q) => (
            <li>
              <a href={ballotHref(code, q.election_date, q.number)}>
                <span class="small muted">Question {q.number}</span> {q.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
      <p class="small muted">What a yes and a no vote do, and the arguments on each side, in the state’s own guide.</p>
    </section>
  )}

  {chambers.length > 0 && (
    <section aria-labelledby="glance-h">
      <div class="section-head">
        <h2 id="glance-h" class="h-small">
          State legislature at a glance
        </h2>
        <a class="see-all" href={href(`${base}legislature/`)}>
          Legislators
        </a>
      </div>
      <div class={`panel glance glance-${chambers.length}`}>
        {chambers.map((c) => (
          <Hemicycle title={`${c.label} (${c.people.length})`} groups={partyGroups(c.people)} />
        ))}
      </div>
    </section>
  )}

  {executives.length > 0 && (
    <section class="officials-section" aria-labelledby="officials-h">
      <h2 id="officials-h" class="h-small">
        Statewide officials
      </h2>
      <ul class="plain-rows officials">
        {executives.map((e) => (
          <li>
            <MemberPhoto name={e.name} url={e.photo_url} size={40} />
            <span class="official-text">
              {e.links[0] ? (
                <a
                  href={safeUrl(e.links[0]) ?? undefined}
                  rel="noopener"
                  title={`Official site (${linkHost(e.links[0])})`}
                >
                  {e.name}
                </a>
              ) : (
                <strong>{e.name}</strong>
              )}
              <span class="small muted">
                {e.role}
                {e.party && ` · ${e.party}`}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {bills.length > 0 && (
    <section aria-labelledby="latest-h">
      <div class="section-head">
        <h2 id="latest-h" class="h-small">
          Latest state bills
        </h2>
        <a class="see-all" href={href(`${base}bills/`)}>
          All bills
        </a>
      </div>
      <ul class="plain-rows latest-bills">
        {bills.slice(0, LATEST).map((b) => (
          <li>
            <p class="meta">
              {b.identifier}
              {b.latest_action_date && ` · ${formatDate(b.latest_action_date)}`}
            </p>
            <p class="bill-title-sm">
              <a href={stateBillHref(b.state, b.session, b.identifier)}>{b.title}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(latestOrder || latestCase) && (
    <section aria-labelledby="exec-h">
      <div class="section-head">
        <h2 id="exec-h" class="h-small">
          Governor and courts
        </h2>
        <span class="cluster small">
          {latestOrder && <a href={href(`${base}governor/`)}>All orders</a>}
          {latestCase && <a href={href(`${base}courts/`)}>All decisions</a>}
        </span>
      </div>
      <ul class="plain-rows latest-bills">
        {latestOrder && (
          <li>
            <p class="meta">
              Executive order No. {latestOrder.label}
              {latestOrder.signed_date && ` · ${formatDate(latestOrder.signed_date)}`}
            </p>
            <p class="bill-title-sm">
              <a href={stateOrderHref(stateOrderId(code, latestOrder.label))}>{latestOrder.title}</a>
            </p>
          </li>
        )}
        {latestCase && (
          <li>
            <p class="meta">
              {STATE_COURT_NAMES[latestCase.court_id] ?? 'Supreme Court'} · {formatDate(latestCase.date_filed)}
            </p>
            <p class="bill-title-sm">
              <a href={stateCourtCaseHref(`${code.toLowerCase()}-${latestCase.cluster_id}`)}>{latestCase.case_name}</a>
            </p>
          </li>
        )}
      </ul>
    </section>
  )}

  {cities.map((c) => (
    <a class="card local-card" href={cityHref(c)}>
      <span class="kicker">Local government</span>
      <strong>{c.name}</strong>
      <span class="small muted">{c.summary} →</span>
    </a>
  ))}
</Base>

<style>
  .ballot-glance > li {
    padding-block: var(--space-2);
  }
  .glance {
    display: grid;
    gap: var(--space-3);
  }
  /* Two chambers sit side by side, even on a phone. */
  .glance-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .glance :global(.legend) {
    font-size: 0.78rem;
  }
  .local-card {
    display: grid;
    gap: var(--space-1);
    border-left: 5px solid var(--highlight);
    text-decoration: none;
    color: var(--text);
    margin-block: var(--space-5);
  }
  .local-card .kicker {
    margin: 0;
  }
  .local-card strong {
    font-size: var(--step-1);
  }
</style>
