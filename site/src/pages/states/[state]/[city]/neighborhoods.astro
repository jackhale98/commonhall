---
import CityHeader from '../../../../components/CityHeader.astro';
import District311 from '../../../../components/District311';
import ZoningExplorer from '../../../../components/ZoningExplorer';
import BarList from '../../../../components/viz/BarList';
import Base from '../../../../layouts/Base.astro';
import { loadCity311, loadCityOfficials, loadZbaAppeals, loadZbaDecisionCounts } from '../../../../lib/build-data';
import { districtName, type City } from '../../../../lib/cities';
import { cityPaths } from '../../../../lib/city-pages';
import { zbaRow } from '../../../../lib/local';
import { cityHref } from '../../../../lib/paths';

export const getStaticPaths = () => cityPaths('neighborhoods');

interface Props {
  city: City;
}

const { city } = Astro.props;
const [appeals, report, officials, decisions] = await Promise.all([
  loadZbaAppeals(city.key),
  loadCity311(city.key),
  loadCityOfficials(city.key),
  loadZbaDecisionCounts(city.key),
]);
const districtLabels = Array.from({ length: city.districts }, (_, i) => {
  const o = officials.find((x) => x.district === i + 1);
  return { district: i + 1, label: `${districtName(city, i + 1)}${o ? ` · ${o.name}` : ''}` };
});
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
const upcoming = appeals
  .filter((z) => z.hearing_date && z.hearing_date >= today)
  .sort((a, b) => a.hearing_date!.localeCompare(b.hearing_date!));
// The last year's decisions, as counts only (no addresses are kept once a case is heard).
const decided = decisions.reduce((n, d) => n + d.cases, 0);
const outcome = (test: (d: string) => boolean) =>
  decisions.filter((d) => test(d.decision)).reduce((n, d) => n + d.cases, 0);
const approved = outcome((d) => d.startsWith('Approved'));
const denied = outcome((d) => d === 'Denied');
const withdrawn = outcome((d) => d === 'Withdrawn');
const pct = (n: number) => (decided ? `${Math.round((n / decided) * 100)}%` : '—');
const byHood = [...Map.groupBy(decisions, (d) => d.neighborhood)]
  .map(([label, list]) => {
    const total = list.reduce((n, d) => n + d.cases, 0);
    const yes = list.filter((d) => d.decision.startsWith('Approved')).reduce((n, d) => n + d.cases, 0);
    return { label, value: total, note: `(${Math.round((yes / total) * 100)}% approved)` };
  })
  .sort((a, b) => b.value - a.value);
const topHoods = byHood.slice(0, 8);
const restHoods = byHood.slice(8);
if (restHoods.length)
  topHoods.push({
    label: 'Everywhere else',
    value: restHoods.reduce((n, r) => n + r.value, 0),
    note: `(${restHoods.length} more)`,
  });
const neighborhoods = [...new Set(appeals.map((z) => z.neighborhood).filter((n): n is string => !!n))].sort();
const zoning = appeals.length > 0 || decided > 0;
const { requests, zoning: zoningSource } = city.sources;
---

<Base
  title={`${city.name} neighborhoods${report && zoning ? ': 311 and zoning' : ''}`}
  description={`${city.name} by district: ${report ? '311 requests and how fast the city closes them' : ''}${report && zoning ? ', and ' : ''}${zoning ? 'zoning appeal hearings and decisions' : ''}.`}
  section="states"
  noindex
>
  <CityHeader
    city={city}
    current="neighborhoods"
    lede={`Your street: ${report ? 'what neighbors ask the city to fix' : ''}${report && zoning ? ', and ' : ''}${zoning ? 'what is being built' : ''}.`}
  />

  {report && (
    <section aria-labelledby="h311">
      <h2 id="h311">311 requests, last 30 days</h2>
      <District311
        client:visible
        report={report}
        districts={districtLabels}
        cityName={city.name}
        districtWord={city.districtWord}
      />
    </section>
  )}

  {appeals.length > 0 && (
    <section aria-labelledby="zba-h">
      <h2 id="zba-h">Upcoming zoning hearings</h2>
      <p class="small muted lede-note">
        Building something the zoning code doesn’t allow (an extra unit, a taller roof, a new use) needs the board’s
        approval at a public hearing, where neighbors can speak. Cases are listed here until their hearing.
      </p>
      <ZoningExplorer
        client:visible
        initial={upcoming.slice(0, 10).map(zbaRow)}
        jsonUrl={cityHref(city, 'zoning.json')}
        neighborhoods={neighborhoods}
        today={today}
      />
    </section>
  )}

  {decided > 0 && (
    <section aria-labelledby="zbad-h">
      <h2 id="zbad-h">Zoning decisions, last 12 months</h2>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Decided</dt>
          <dd>{decided.toLocaleString()}</dd>
        </div>
        <div class="stat">
          <dt>Approved</dt>
          <dd>{pct(approved)}</dd>
          <p class="small muted stat-note">including with conditions</p>
        </div>
        <div class="stat">
          <dt>Denied</dt>
          <dd>{pct(denied)}</dd>
        </div>
        <div class="stat">
          <dt>Withdrawn</dt>
          <dd>{pct(withdrawn)}</dd>
        </div>
      </dl>
      <div class="panel decisions-panel">
        <h3 class="h-small">By neighborhood</h3>
        <BarList items={topHoods} label="Zoning decisions in the last 12 months by neighborhood" tone="fill-sky" />
      </div>
      <p class="small muted">
        Totals only: CommonHall doesn’t keep a list of past cases by address.
        {zoningSource && (
          <>
            {' '}
            Look up a past decision in the city’s <a href={zoningSource.board}>board records</a>.
          </>
        )}
      </p>
    </section>
  )}

  <p class="small muted tab-note">
    {requests && report && (
      <>
        311 summaries from <a href={requests.url}>{requests.label}</a>
        {requests.cadence && `, checked ${requests.cadence}`}; where the city runs more than one 311 system, they are
        counted together.{' '}
      </>
    )}
    {zoningSource && zoning && (
      <>
        Zoning cases from <a href={zoningSource.url}>{zoningSource.label}</a>
        {zoningSource.cadence && `, checked ${zoningSource.cadence}`}. Hearing times, documents and how to comment are
        on the <a href={zoningSource.board}>board’s page</a>.
      </>
    )}
  </p>
</Base>

<style>
  .decisions-panel {
    margin-top: var(--space-4);
  }
  .decisions-panel .h-small {
    margin-top: 0;
  }
  .lede-note {
    max-width: 60ch;
  }
  :global(.zoning-list p) {
    margin: 0;
  }
  :global(.zoning-desc) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
