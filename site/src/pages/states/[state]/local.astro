---
import StateHeader from '../../../components/StateHeader.astro';
import Base from '../../../layouts/Base.astro';
import { loadCityMeetings, loadCityOfficials } from '../../../lib/build-data';
import { CITY_LIST, citiesIn } from '../../../lib/cities';
import { formatDate, stateName } from '../../../lib/format';
import { cityHref } from '../../../lib/paths';

/** Only states with a city we cover. */
export function getStaticPaths() {
  return [...new Set(CITY_LIST.map((c) => c.state))].map((code) => ({
    params: { state: code.toLowerCase() },
    props: { code },
  }));
}

interface Props {
  code: string;
}

const { code } = Astro.props;
const name = stateName(code);
// Each city's next council meeting and committee meeting make its card useful at a glance.
const today = new Date().toISOString().slice(0, 10);
const cities = await Promise.all(
  citiesIn(code).map(async (city) => {
    const [officials, meetings] = await Promise.all([loadCityOfficials(city.key), loadCityMeetings(city.key)]);
    const next = (committee: boolean) =>
      meetings
        .filter((m) => m.date >= today && m.status !== 'Cancelled' && m.committees.length > 0 === committee)
        .at(-1)?.date;
    return {
      city,
      councilors: officials.length || city.districts + city.atLarge,
      meeting: next(false),
      committee: next(true),
    };
  }),
);
---

<Base title={`Local government in ${name}`} description={`Cities in ${name} that CommonHall covers.`} section="states">
  <StateHeader code={code} current="local" />
  <h2 class="h-small">Cities</h2>
  {cities.map(({ city, councilors, meeting, committee }) => (
    <a class="card local-card" href={cityHref(city)}>
      <strong>{city.name}</strong>
      <span class="small muted">{city.summary}</span>
      <span class="small">
        {councilors} councilors
        {meeting && ` · Next council meeting ${formatDate(meeting)}`}
        {committee && ` · Next committee ${city.committeeSession} ${formatDate(committee)}`}
      </span>
    </a>
  ))}
  <p class="small muted tab-note">More cities as their records become available in a form we can read.</p>
</Base>

<style>
  .local-card {
    display: grid;
    gap: var(--space-1);
    border-left: 5px solid var(--highlight);
    text-decoration: none;
    color: var(--text);
    margin-block: var(--space-3);
  }
  .local-card strong {
    font-size: var(--step-1);
  }
</style>
