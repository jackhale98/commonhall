---
import DiscussionLink from '../../../../components/DiscussionLink.astro';
import Base from '../../../../layouts/Base.astro';
import { loadDiscussionsByTarget, loadStateOrders, type StateExecutiveOrder } from '../../../../lib/build-data';
import { formatDate, stateName } from '../../../../lib/format';
import { maOrderParts } from '@civic/congress-client/mass-orders';
import { href } from '../../../../lib/paths';

export async function getStaticPaths() {
  return [...(await loadStateOrders()).values()].flat().map((order) => ({
    params: { state: order.state.toLowerCase(), number: String(order.number) },
    props: { order },
  }));
}

interface Props {
  order: StateExecutiveOrder;
}

const { order: o } = Astro.props;
const name = stateName(o.state);
const id = `${o.state.toLowerCase()}-${o.number}`;
const discussion = (await loadDiscussionsByTarget()).get(`state_order:${id}`);
const parts = o.body ? maOrderParts(o.body) : null;
const WHY_FIRST = 3;
const SECTIONS_FIRST = 3;
---

<Base
  title={`Executive Order No. ${o.number}: ${o.title.slice(0, 80)}`}
  description={`${name} Governor${o.governor ? ` ${o.governor}` : ''}'s Executive Order No. ${o.number}: ${o.title}`.slice(
    0,
    300,
  )}
  section="states"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href(`states/${o.state.toLowerCase()}/governor/`)}>{name} governor’s orders</a>
  </nav>
  <header class="page-head">
    <p class="kicker">
      Executive Order No. {o.number}
      {o.signed_date && ` · ${formatDate(o.signed_date)}`}
    </p>
    <h1>{o.title}</h1>
    <p class="muted">
      {o.governor ? `Issued by Governor ${o.governor}.` : 'Issued by the governor.'}
      {o.revokes && ` Revokes ${o.revokes}.`}
      {o.register && ` Massachusetts Register ${o.register}.`}
    </p>
  </header>

  <DiscussionLink discussion={discussion} targetType="state_order" targetId={id} />

  {parts && parts.sections.length > 0 && (
    <section class="order-part" aria-labelledby="orders-h">
      <h2 id="orders-h" class="h-small">
        What it orders
      </h2>
      <ol class="order-sections">
        {parts.sections.slice(0, SECTIONS_FIRST).map((sec) => (
          <li>
            {sec.heading && <h3 class="order-heading">{sec.heading}</h3>}
            {sec.text.split('\n\n').map((t) => (
              <p>{t}</p>
            ))}
          </li>
        ))}
      </ol>
      {parts.sections.length > SECTIONS_FIRST && (
        <details class="more-why">
          <summary>{parts.sections.length - SECTIONS_FIRST} more sections</summary>
          <ol class="order-sections">
            {parts.sections.slice(SECTIONS_FIRST).map((sec) => (
              <li>
                {sec.heading && <h3 class="order-heading">{sec.heading}</h3>}
                {sec.text.split('\n\n').map((t) => (
                  <p>{t}</p>
                ))}
              </li>
            ))}
          </ol>
        </details>
      )}
    </section>
  )}

  {parts && parts.whereas.length > 0 && (
    <section class="order-part" aria-labelledby="why-h">
      <h2 id="why-h" class="h-small">
        Why, in the order’s words
      </h2>
      <ul class="order-why">
        {parts.whereas.slice(0, WHY_FIRST).map((w) => (
          <li>{w.charAt(0).toUpperCase() + w.slice(1)}</li>
        ))}
      </ul>
      {parts.whereas.length > WHY_FIRST && (
        <details class="more-why">
          <summary>{parts.whereas.length - WHY_FIRST} more reasons</summary>
          <ul class="order-why">
            {parts.whereas.slice(WHY_FIRST).map((w) => (
              <li>{w.charAt(0).toUpperCase() + w.slice(1)}</li>
            ))}
          </ul>
        </details>
      )}
    </section>
  )}

  <p class="cluster" style="margin-block: var(--space-4)">
    <a class="button" href={o.url} rel="noopener">
      Read the order on mass.gov
    </a>
  </p>

  <p class="small muted">
    From the Trial Court Law Libraries’ list of governors’ executive orders on mass.gov, as published there. Any order
    that later changes this one is listed there too.
  </p>
</Base>

<style>
  .order-part {
    max-width: 70ch;
    margin-block: var(--space-5);
  }
  .order-part .h-small {
    margin-top: 0;
  }
  .order-sections {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .order-sections li {
    padding-left: var(--space-3);
    border-left: 3px solid var(--brand-soft);
  }
  .order-heading {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin: 0 0 var(--space-1);
  }
  .order-sections p {
    margin: 0 0 var(--space-2);
    line-height: 1.6;
  }
  .order-why {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
    color: var(--text-muted);
    line-height: 1.55;
  }
  .more-why summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
  }
</style>
