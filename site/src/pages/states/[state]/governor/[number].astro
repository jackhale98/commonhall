---
import DiscussionLink from '../../../../components/DiscussionLink.astro';
import Base from '../../../../layouts/Base.astro';
import { loadDiscussionsByTarget, loadStateOrders, type StateExecutiveOrder } from '../../../../lib/build-data';
import { formatDate, stateName } from '../../../../lib/format';
import { href } from '../../../../lib/paths';

export async function getStaticPaths() {
  return [...(await loadStateOrders()).values()].flat().map((order) => ({
    params: { state: order.state.toLowerCase(), number: String(order.number) },
    props: { order },
  }));
}

interface Props {
  order: StateExecutiveOrder;
}

const { order: o } = Astro.props;
const name = stateName(o.state);
const id = `${o.state.toLowerCase()}-${o.number}`;
const discussion = (await loadDiscussionsByTarget()).get(`state_order:${id}`);
---

<Base
  title={`Executive Order No. ${o.number}: ${o.title.slice(0, 80)}`}
  description={`${name} Governor${o.governor ? ` ${o.governor}` : ''}'s Executive Order No. ${o.number}: ${o.title}`.slice(
    0,
    300,
  )}
  section="states"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href(`states/${o.state.toLowerCase()}/governor/`)}>{name} governor’s orders</a>
  </nav>
  <header class="page-head">
    <p class="kicker">
      Executive Order No. {o.number}
      {o.signed_date && ` · ${formatDate(o.signed_date)}`}
    </p>
    <h1>{o.title}</h1>
    <p class="muted">
      {o.governor ? `Issued by Governor ${o.governor}.` : 'Issued by the governor.'}
      {o.revokes && ` Revokes ${o.revokes}.`}
    </p>
  </header>

  <DiscussionLink discussion={discussion} targetType="state_order" targetId={id} />

  <p class="cluster" style="margin-block: var(--space-4)">
    <a class="button" href={o.url} rel="noopener">
      Read the order on mass.gov
    </a>
  </p>

  <p class="small muted">
    From the Trial Court Law Libraries’ list of governors’ executive orders on mass.gov. The full text, and any order
    that later changes this one, is there.
  </p>
</Base>
