---
import DiscussionLink from '../../../../components/DiscussionLink.astro';
import Base from '../../../../layouts/Base.astro';
import { loadDiscussionsByTarget, loadStateOrders, type StateExecutiveOrder } from '../../../../lib/build-data';
import { formatDate, stateName } from '../../../../lib/format';
import { href, stateOrderId } from '../../../../lib/paths';
import { stateFeatures } from '../../../../lib/states';

/** One page per order, at its label: states/ma/governor/635/, states/ct/governor/26-3/. */
export async function getStaticPaths() {
  return [...(await loadStateOrders()).values()].flat().map((order) => ({
    params: { state: order.state.toLowerCase(), order: order.label.toLowerCase() },
    props: { order },
  }));
}

interface Props {
  order: StateExecutiveOrder;
}

const { order: o } = Astro.props;
const name = stateName(o.state);
const id = stateOrderId(o.state, o.label);
const source = stateFeatures(o.state)?.orders;
const site = source?.site ?? new URL(o.url).hostname.replace(/^www\./, '');
const discussion = (await loadDiscussionsByTarget()).get(`state_order:${id}`);
---

<Base
  title={`Executive Order No. ${o.label}: ${o.title.slice(0, 80)}`}
  description={`${name} Governor${o.governor ? ` ${o.governor}` : ''}'s Executive Order No. ${o.label}: ${o.title}`.slice(
    0,
    300,
  )}
  section="states"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href(`states/${o.state.toLowerCase()}/governor/`)}>{name} governor’s orders</a>
  </nav>
  <header class="page-head">
    <p class="kicker">
      Executive Order No. {o.label}
      {o.signed_date && ` · ${formatDate(o.signed_date)}`}
    </p>
    <h1>{o.title}</h1>
    <p class="muted">
      {o.governor ? `Issued by Governor ${o.governor}.` : 'Issued by the governor.'}
      {o.revokes && ` Revokes ${o.revokes}.`}
      {o.register && ` ${name} Register ${o.register}.`}
    </p>
  </header>

  <DiscussionLink discussion={discussion} targetType="state_order" targetId={id} />

  {(o.summary || o.reason) && (
    <section class="order-part" aria-labelledby="about-h">
      <h2 id="about-h" class="h-small">
        In brief
      </h2>
      {o.summary && (
        <p>
          <strong>What it does:</strong> {o.summary}
        </p>
      )}
      {o.reason && (
        <p class="muted">
          <strong>Why:</strong> {o.reason}
        </p>
      )}
      <p class="small muted">In the order’s own words, shortened. The full text is on {site}.</p>
    </section>
  )}

  <p class="cluster" style="margin-block: var(--space-4)">
    <a class="button" href={o.url} rel="noopener">
      Read the order on {site}
    </a>
  </p>

  <p class="small muted">
    From {source?.list ?? 'the state’s list of governors’ executive orders'} on {site}, as published there.
    {source?.titleNote && ` ${source.titleNote}`} Any order that later changes this one is listed there too.
  </p>
</Base>

<style>
  .order-part {
    max-width: 70ch;
    margin-block: var(--space-5);
  }
  .order-part .h-small {
    margin-top: 0;
  }
  .order-part p {
    line-height: 1.6;
    margin: 0 0 var(--space-2);
  }
</style>
