---
import DiscussionLink from '../../../../../components/DiscussionLink.astro';
import StateBillSponsors from '../../../../../components/StateBillSponsors';
import StateBillView from '../../../../../components/StateBillView';
import Base from '../../../../../layouts/Base.astro';
import { loadDiscussionsByTarget, loadPrerenderStateBills, type StateBill } from '../../../../../lib/build-data';
import { stateName } from '../../../../../lib/format';
import { slug, stateHref } from '../../../../../lib/paths';

export async function getStaticPaths() {
  return (await loadPrerenderStateBills()).map((bill) => ({
    params: { state: bill.state.toLowerCase(), session: slug(bill.session), bill: slug(bill.identifier) },
    props: { bill },
  }));
}

interface Props {
  bill: StateBill;
}

const { bill } = Astro.props;
const discussion = (await loadDiscussionsByTarget()).get(`state_bill:${bill.id}`);
---

<Base
  title={`${bill.identifier}: ${bill.title.slice(0, 80)}`}
  description={`${stateName(bill.state)} ${bill.identifier} (${bill.session}): ${bill.title}`.slice(0, 300)}
  section="states"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={stateHref(bill.state)}>{stateName(bill.state)}</a> › {bill.identifier}
  </nav>
  <DiscussionLink discussion={discussion} targetType="state_bill" targetId={bill.id} />
  <StateBillView bill={bill}>
    <StateBillSponsors client:visible billId={bill.id} />
  </StateBillView>
</Base>
