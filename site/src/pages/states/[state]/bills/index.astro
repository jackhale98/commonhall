---
import { stateFeatures } from '../../../../lib/states';
import LiveDiscussions from '../../../../components/LiveDiscussions';
import FollowedItems from '../../../../components/FollowedItems';
import StateBills from '../../../../components/StateBills';
import StateHeader from '../../../../components/StateHeader.astro';
import Base from '../../../../layouts/Base.astro';
import { loadDiscussions, loadRecentStateBills, loadStateBillCoverage } from '../../../../lib/build-data';
import { LEGISLATURE_STATES, formatDate, stateName } from '../../../../lib/format';
import { href } from '../../../../lib/paths';

export function getStaticPaths() {
  return LEGISLATURE_STATES.map((code) => ({ params: { state: code.toLowerCase() }, props: { code } }));
}

interface Props {
  code: string;
}

const { code } = Astro.props;
const name = stateName(code);
const { bills, total } = await loadRecentStateBills(code);
const coverage = (await loadStateBillCoverage()).get(code);
const shown = coverage ? Math.min(coverage.loaded, coverage.reported_total) : 0;
// Some states' bills can have discussions (a city's are on the city's pages).
const hasDiscussions = Boolean(stateFeatures(code)?.discussions);
const jurisdiction = code.toLowerCase();
const discussions = hasDiscussions
  ? (await loadDiscussions()).filter((d) => d.status === 'open' && d.jurisdiction === jurisdiction)
  : [];
---

<Base title={`${name} state bills`} description={`Recent bills in the ${name} legislature.`} section="states">
  <StateHeader code={code} current="bills" />
  <FollowedItems client:idle kind={{ type: 'state_bill', state: code }} title="State bills you follow" />
  <h2 class="h-small">State bills</h2>
  {coverage && coverage.reported_total > 0 && (
    <p class="small muted coverage-line">
      {coverage.loaded.toLocaleString()} of {coverage.reported_total.toLocaleString()} bills in the {coverage.session}{' '}
      session on file ({Math.floor((shown / coverage.reported_total) * 100)}%), counted{' '}
      {formatDate(coverage.checked_at.slice(0, 10))}.{' '}
      {coverage.loaded < coverage.reported_total && 'The rest are still loading; newest bills come first.'}
    </p>
  )}
  <StateBills client:load state={code} initial={bills} total={total} />
  {hasDiscussions && (
    <section aria-labelledby="say-h">
      <h2 id="say-h">Have your say</h2>
      <LiveDiscussions
        client:idle
        initial={discussions}
        jurisdictions={[jurisdiction]}
        empty={`No ${name} discussion is open right now. Ask for one from any state bill’s page.`}
      />
    </section>
  )}
  <p class="small muted tab-note">
    Bills from <a href="https://openstates.org/">Open States</a>, refreshed daily. Federal bills are under{' '}
    <a href={href('bills/')}>Congress</a>.
  </p>
</Base>
