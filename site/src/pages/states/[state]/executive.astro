---
import StateHeader from '../../../components/StateHeader.astro';
import Base from '../../../layouts/Base.astro';
import { loadStateCourtCases, loadStateOrders } from '../../../lib/build-data';
import { formatDate, stateName } from '../../../lib/format';
import { STATE_COURT_NAMES } from '../../../lib/state-tabs';

/** Only states with a governor's order or a high court decision on file. */
export async function getStaticPaths() {
  const [cases, orders] = await Promise.all([loadStateCourtCases(), loadStateOrders()]);
  return [...new Set([...cases.keys(), ...orders.keys()])].map((code) => ({
    params: { state: code.toLowerCase() },
    props: { code },
  }));
}

interface Props {
  code: string;
}

const { code } = Astro.props;
const name = stateName(code);
const [allCases, allOrders] = await Promise.all([loadStateCourtCases(), loadStateOrders()]);
const cases = allCases.get(code) ?? [];
const orders = allOrders.get(code) ?? [];
const court = STATE_COURT_NAMES[cases[0]?.court_id ?? ''] ?? 'Supreme Court';
const FIRST = 12;
const yearAgo = new Date(Date.now() - 365 * 86_400_000).toISOString().slice(0, 10);
const ordersThisYear = orders.filter((o) => o.signed_date && o.signed_date >= yearAgo).length;
const casesThisYear = cases.filter((c) => c.date_filed >= yearAgo).length;
const governor = orders.find((o) => o.governor)?.governor;
const split = (c: (typeof cases)[number]) =>
  [
    c.per_curiam && 'Per curiam',
    c.dissents > 0 && `${c.dissents} ${c.dissents === 1 ? 'dissent' : 'dissents'}`,
    c.concurrences > 0 && `${c.concurrences} ${c.concurrences === 1 ? 'concurrence' : 'concurrences'}`,
  ]
    .filter(Boolean)
    .join(' · ');
---

<Base
  title={`${name} governor and courts`}
  description={`${name}: the governor's executive orders and decisions of the ${court}.`}
  section="states"
>
  <StateHeader code={code} current="executive" />

  <dl class="stat-grid glance-stats">
    {orders.length > 0 && (
      <div class="stat">
        <dt>Executive orders, last 12 months</dt>
        <dd>{ordersThisYear}</dd>
        {governor && <p class="small muted stat-note">Latest by Governor {governor}</p>}
      </div>
    )}
    {cases.length > 0 && (
      <div class="stat">
        <dt>{court} decisions, last 12 months</dt>
        <dd>{casesThisYear}</dd>
      </div>
    )}
  </dl>

  {orders.length > 0 && (
    <section aria-labelledby="orders-h">
      <h2 id="orders-h">Governor’s executive orders</h2>
      <p class="small muted section-note">
        Orders the governor issues to run the executive branch: creating councils and task forces, directing agencies,
        and revoking earlier orders.
      </p>
      <ol class="plain-rows exec-list">
        {orders.slice(0, FIRST).map((o) => (
          <li>
            <span class="small muted">
              No. {o.number}
              {o.signed_date && ` · ${formatDate(o.signed_date)}`}
              {o.governor && ` · ${o.governor}`}
            </span>
            <a href={o.url} rel="noopener">
              {o.title}
            </a>
            {o.revokes && <span class="small muted">Revokes {o.revokes.replace(/^Executive Order /i, 'order ')}</span>}
          </li>
        ))}
      </ol>
      {orders.length > FIRST && (
        <details class="more-rows">
          <summary>{orders.length - FIRST} earlier orders</summary>
          <ol class="plain-rows exec-list">
            {orders.slice(FIRST).map((o) => (
              <li>
                <span class="small muted">
                  No. {o.number}
                  {o.signed_date && ` · ${formatDate(o.signed_date)}`}
                  {o.governor && ` · ${o.governor}`}
                </span>
                <a href={o.url} rel="noopener">
                  {o.title}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <p class="small muted">
        From the Trial Court Law Libraries’ list on{' '}
        <a href="https://www.mass.gov/massachusetts-executive-orders" rel="noopener">
          mass.gov
        </a>
        , checked weekly. Each order links to its full text there.
      </p>
    </section>
  )}

  {cases.length > 0 && (
    <section aria-labelledby="court-h">
      <h2 id="court-h">{court} decisions</h2>
      <p class="small muted section-note">
        The state’s highest court: its decisions settle what state law and the state constitution mean.
      </p>
      <ol class="plain-rows exec-list">
        {cases.slice(0, FIRST).map((c) => (
          <li>
            <span class="small muted">
              {formatDate(c.date_filed)}
              {c.docket_number && ` · ${c.docket_number}`}
              {c.citations[0] && ` · ${c.citations[0]}`}
            </span>
            <a href={c.url} rel="noopener">
              {c.case_name}
            </a>
            {split(c) && <span class="small muted">{split(c)}</span>}
          </li>
        ))}
      </ol>
      {cases.length > FIRST && (
        <details class="more-rows">
          <summary>{cases.length - FIRST} earlier decisions</summary>
          <ol class="plain-rows exec-list">
            {cases.slice(FIRST).map((c) => (
              <li>
                <span class="small muted">
                  {formatDate(c.date_filed)}
                  {c.docket_number && ` · ${c.docket_number}`}
                </span>
                <a href={c.url} rel="noopener">
                  {c.case_name}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <p class="small muted">
        From{' '}
        <a href="https://www.courtlistener.com/" rel="noopener">
          CourtListener
        </a>{' '}
        (Free Law Project), checked every three hours. Each decision links to its opinions there.
      </p>
    </section>
  )}
</Base>

<style>
  .glance-stats {
    margin-bottom: var(--space-5);
  }
  .section-note {
    margin-top: 0;
    max-width: 65ch;
  }
  .exec-list {
    list-style: none;
    padding: 0;
  }
  .exec-list li {
    display: grid;
    gap: 0.15rem;
  }
  .exec-list a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .exec-list a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .more-rows summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
  }
  section + section {
    margin-top: var(--space-6);
  }
</style>
