---
import StateTiles from '../../components/viz/StateTiles';
import Base from '../../layouts/Base.astro';
import { loadMembers } from '../../lib/build-data';
import { LEGISLATURE_STATES, STATE_CODES, stateName } from '../../lib/format';
import { href, stateHref } from '../../lib/paths';

const members = [...(await loadMembers()).values()].filter((m) => m.current && m.chamber === 'house');
const seats = new Map<string, number>();
for (const m of members) if (m.state) seats.set(m.state, (seats.get(m.state) ?? 0) + 1);
const states = LEGISLATURE_STATES.slice().sort((a, b) => stateName(a).localeCompare(stateName(b)));
const territories = STATE_CODES.filter((c) => !LEGISLATURE_STATES.includes(c));
const tiles = LEGISLATURE_STATES.map((code) => ({
  code,
  name: stateName(code),
  href: stateHref(code),
  note:
    code === 'DC'
      ? 'delegate'
      : seats.get(code)
        ? `${seats.get(code)} ${seats.get(code) === 1 ? 'rep' : 'reps'}`
        : undefined,
  featured: code === 'MA',
}));
---

<Base
  title="States and local government"
  description="Congressional delegations, legislators and bills for every state, plus the Boston City Council."
  section="states"
>
  <header class="page-head wash">
    <p class="kicker">States &amp; local</p>
    <h1>Beyond Washington</h1>
    <p class="lede">Pick a state for its members of Congress, state legislators and recent state bills.</p>
  </header>

  <div class="featured-row">
    <a class="card feature" href={stateHref('MA')}>
      <span class="kicker">Featured state</span>
      <strong>Massachusetts</strong>
      <span class="small muted">Advancing state bills get their own pages, and its bills sync first.</span>
    </a>
    <a class="card feature" href={href('boston/')}>
      <span class="kicker">Local government</span>
      <strong>Boston City Council</strong>
      <span class="small muted">City Council, zoning hearings and the capital budget.</span>
    </a>
  </div>

  <section aria-labelledby="map-h">
    <div class="section-head">
      <h2 id="map-h" class="h-small">
        Pick a state
      </h2>
      <form class="state-jump" action={href('states/')} onsubmit="return false">
        <label for="state-pick" class="visually-hidden">
          Go to a state
        </label>
        <select id="state-pick" data-base={href('states/')}>
          <option value="">Go to a state…</option>
          {states.map((s) => (
            <option value={s.toLowerCase()}>{stateName(s)}</option>
          ))}
          <optgroup label="Territories">
            {territories.map((s) => (
              <option value={s.toLowerCase()}>{stateName(s)}</option>
            ))}
          </optgroup>
        </select>
      </form>
    </div>
    <div class="panel">
      <StateTiles tiles={tiles} label="States, arranged roughly by location" />
      <p class="small muted legend-note">
        <span class="swatch fill-present"></span> Featured state. Numbers are House seats. Territories:{' '}
        {territories.map((t, i) => (
          <>
            {i > 0 && ', '}
            <a href={stateHref(t)}>{stateName(t)}</a>
          </>
        ))}
        .
      </p>
    </div>
  </section>
</Base>

<script>
  // The menu jumps straight to the chosen state's page.
  const pick = document.getElementById('state-pick') as HTMLSelectElement | null;
  pick?.addEventListener('change', () => {
    if (pick.value) window.location.href = `${pick.dataset.base}${pick.value}/`;
  });
</script>

<style>
  .featured-row {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: var(--space-4) 0 var(--space-5);
  }
  .feature {
    display: grid;
    gap: var(--space-1);
    border-left: 5px solid var(--highlight);
  }
  .feature strong {
    font-size: var(--step-1);
  }
  .legend-note {
    margin: var(--space-3) 0 0;
  }
  .state-jump select {
    width: auto;
    min-height: 40px;
    border-radius: 999px;
    padding: 0 2rem 0 0.9rem;
    font-size: var(--step--1);
    font-weight: 560;
  }
</style>
