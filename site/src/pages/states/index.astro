---
import Base from '../../layouts/Base.astro';
import { LEGISLATURE_STATES, STATE_CODES, stateName } from '../../lib/format';
import { stateHref } from '../../lib/paths';

const states = LEGISLATURE_STATES.slice().sort((a, b) => stateName(a).localeCompare(stateName(b)));
const territories = STATE_CODES.filter((c) => !LEGISLATURE_STATES.includes(c));
---

<Base title="States" description="Congressional delegations, legislators and bills for every state." section="states">
  <h1>States</h1>
  <p class="muted">Each state’s members of Congress, state legislators and recent state bills.</p>
  <ul class="state-grid">
    {states.map((s) => (
      <li>
        <a href={stateHref(s)}>{stateName(s)}</a>
      </li>
    ))}
  </ul>
  <h2 class="h-small">Territories</h2>
  <ul class="state-grid">
    {territories.map((s) => (
      <li>
        <a href={stateHref(s)}>{stateName(s)}</a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .state-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-1) var(--space-4);
  }
  .state-grid a {
    display: inline-block;
    padding-block: var(--space-2);
  }
</style>
