---
import { CITY_LIST } from '../../lib/cities';
import StateTiles from '../../components/viz/StateTiles';
import Base from '../../layouts/Base.astro';
import { loadMembers, loadStateBillCoverage } from '../../lib/build-data';
import { LEGISLATURE_STATES, STATE_CODES, stateName } from '../../lib/format';
import { cityHref, href, stateHref } from '../../lib/paths';

const members = [...(await loadMembers()).values()].filter((m) => m.current && m.chamber === 'house');
const seats = new Map<string, number>();
for (const m of members) if (m.state) seats.set(m.state, (seats.get(m.state) ?? 0) + 1);
const states = LEGISLATURE_STATES.slice().sort((a, b) => stateName(a).localeCompare(stateName(b)));
// How many of each state's current-session bills we hold, as Open States counts them.
const coverage = [...(await loadStateBillCoverage()).values()].sort((a, b) =>
  stateName(a.state).localeCompare(stateName(b.state)),
);
const reported = coverage.reduce((n, c) => n + c.reported_total, 0);
const loaded = coverage.reduce((n, c) => n + Math.min(c.loaded, c.reported_total), 0);
const pct = (part: number, whole: number) => (whole ? Math.floor((part / whole) * 100) : 0);
const territories = STATE_CODES.filter((c) => !LEGISLATURE_STATES.includes(c));
// Each tile shows its House seats as a bare number (the legend says so); the full wording is in its label.
const tiles = LEGISLATURE_STATES.map((code) => {
  const n = seats.get(code);
  return {
    code,
    name:
      code === 'DC'
        ? `${stateName(code)}, a non-voting delegate`
        : n
          ? `${stateName(code)}, ${n} House ${n === 1 ? 'seat' : 'seats'}`
          : stateName(code),
    href: stateHref(code),
    note: code === 'DC' ? 'del.' : n ? String(n) : undefined,
    featured: code === 'MA',
  };
});
---

<Base
  title="States and local government"
  description={`Congressional delegations, legislators and bills for every state, plus city councils in ${CITY_LIST.map((c) => c.name).join(' and ')}.`}
  section="states"
>
  <header class="page-head wash">
    <p class="kicker">States &amp; local</p>
    <h1>Beyond Washington</h1>
    <p class="lede">Pick a state for its members of Congress, state legislators and recent state bills.</p>
  </header>

  <div class="featured-row">
    <a class="card feature" href={stateHref('MA')}>
      <span class="kicker">Most detailed coverage</span>
      <strong>Massachusetts</strong>
      <span class="small muted">Bills with their full history, roll-call votes and co-sponsors.</span>
    </a>
    {CITY_LIST.map((c) => (
      <a class="card feature" href={cityHref(c)}>
        <span class="kicker">Local government</span>
        <strong>{c.council}</strong>
        <span class="small muted">{c.summary}.</span>
      </a>
    ))}
  </div>

  <section aria-labelledby="map-h">
    <div class="section-head">
      <h2 id="map-h" class="h-small">
        Pick a state
      </h2>
      <form class="state-jump" action={href('states/')} onsubmit="return false">
        <label for="state-pick" class="visually-hidden">
          Go to a state
        </label>
        <select id="state-pick" data-base={href('states/')}>
          <option value="">Go to a state…</option>
          {states.map((s) => (
            <option value={s.toLowerCase()}>{stateName(s)}</option>
          ))}
          <optgroup label="Territories">
            {territories.map((s) => (
              <option value={s.toLowerCase()}>{stateName(s)}</option>
            ))}
          </optgroup>
        </select>
      </form>
    </div>
    <div class="panel tiles-panel">
      <StateTiles tiles={tiles} label="States, arranged roughly by location" />
      <p class="small muted legend-note">
        <span class="swatch fill-present"></span> Most detailed coverage (Massachusetts). Numbers are House seats.
        Territories:{' '}
        {territories.map((t, i) => (
          <>
            {i > 0 && ', '}
            <a href={stateHref(t)}>{stateName(t)}</a>
          </>
        ))}
        .
      </p>
    </div>
  </section>

  {coverage.length > 0 && (
    <section aria-labelledby="coverage-h">
      <h2 id="coverage-h" class="h-small">
        State bill coverage
      </h2>
      <p class="small muted">
        {loaded.toLocaleString()} of {reported.toLocaleString()} bills in the current sessions of {coverage.length}{' '}
        {coverage.length === 1 ? 'legislature' : 'legislatures'} are on file ({pct(loaded, reported)}%), as Open States
        counts them. States load newest bills first, a few pages a night within Open States’ free limits.
      </p>
      <details class="coverage">
        <summary>Coverage by state</summary>
        <table class="coverage-table">
          <thead>
            <tr>
              <th scope="col">State</th>
              <th scope="col">Session</th>
              <th scope="col">On file</th>
              <th scope="col">Bills</th>
              <th scope="col">Share</th>
            </tr>
          </thead>
          <tbody>
            {coverage.map((c) => (
              <tr>
                <th scope="row">
                  <a href={href(`states/${c.state.toLowerCase()}/bills/`)}>{stateName(c.state)}</a>
                </th>
                <td>{c.session}</td>
                <td>{c.loaded.toLocaleString()}</td>
                <td>{c.reported_total.toLocaleString()}</td>
                <td>{pct(Math.min(c.loaded, c.reported_total), c.reported_total)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </section>
  )}
</Base>

<script>
  // The menu jumps straight to the chosen state's page.
  const pick = document.getElementById('state-pick') as HTMLSelectElement | null;
  pick?.addEventListener('change', () => {
    if (pick.value) window.location.href = `${pick.dataset.base}${pick.value}/`;
  });
</script>

<style>
  .coverage summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
  }
  .coverage-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .coverage-table th,
  .coverage-table td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .coverage-table th[scope='row'],
  .coverage-table thead th:first-child,
  .coverage-table td:nth-child(2),
  .coverage-table thead th:nth-child(2) {
    text-align: left;
  }
  .featured-row {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: var(--space-4) 0 var(--space-5);
  }
  .feature {
    display: grid;
    gap: var(--space-1);
    border-left: 5px solid var(--highlight);
  }
  .feature strong {
    font-size: var(--step-1);
  }
  /* Phones: the map takes the panel's full width, so each tile is as large as it can be. */
  @media (max-width: 40rem) {
    .tiles-panel {
      padding: var(--space-3) var(--space-2);
    }
  }
  .legend-note {
    margin: var(--space-3) 0 0;
  }
  .state-jump select {
    width: auto;
    min-height: 40px;
    border-radius: 999px;
    padding: 0 2rem 0 0.9rem;
    font-size: var(--step--1);
    font-weight: 560;
  }
</style>
