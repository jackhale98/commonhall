---
import { RES_PUBLICA_URL } from '../lib/respublica';
import BillListItem from '../components/BillListItem';
import DiscussionCard from '../components/DiscussionCard.astro';
import FeedView from '../components/FeedView';
import FindMyReps from '../components/FindMyReps';
import YourArea from '../components/YourArea';
import StackedBar from '../components/viz/StackedBar';
import Base from '../layouts/Base.astro';
import { fiscalYear, fundingYear } from '../lib/appropriations';
import {
  loadBallotQuestions,
  loadBills,
  loadFundingBills,
  loadDiscussions,
  loadExecutiveOrders,
  loadCityMeetings,
  loadScotusCases,
  loadScotusOutcomeMap,
  loadVotesAbout,
} from '../lib/build-data';
import { voteSegments } from '../lib/charts';
import { outcomeSummary } from '../lib/court';
import { CITY_LIST } from '../lib/cities';
import { DEMO } from '../lib/config';
import { formatDate, stateName } from '../lib/format';
import { ballotHref, billHref, cityHref, executiveOrderHref, href, scotusCaseHref, voteHref } from '../lib/paths';

const [bills, votes, discussions, meetings, orders, cases, outcomes] = await Promise.all([
  loadBills(),
  loadVotesAbout(),
  loadDiscussions(),
  Promise.all(CITY_LIST.map(async (city) => (await loadCityMeetings(city.key)).map((m) => ({ ...m, city })))),
  loadExecutiveOrders(),
  loadScotusCases(),
  loadScotusOutcomeMap(),
]);
// Bills that moved past committee, newest action first; simple resolutions (mostly
// commemorative) and bills still in committee only when fewer than six have moved.
const simple = (b: (typeof bills)[number]) => b.bill_type === 'hres' || b.bill_type === 'sres';
const moved = bills.filter((b) => b.status !== 'introduced' && b.status !== 'in_committee' && !simple(b));
const recent =
  moved.length >= 6 ? moved.slice(0, 6) : [...moved, ...bills.filter((b) => !moved.includes(b))].slice(0, 6);
const laws = bills.filter((b) => b.status === 'law');
const latestLaw = [...laws].sort((a, b) => (b.latest_action_date ?? '').localeCompare(a.latest_action_date ?? ''))[0];
const latestVote = votes[0];
const openDiscussions = discussions.filter((d) => d.status === 'open');
const today = new Date().toISOString().slice(0, 10);
// The soonest full council meeting in any city we cover.
const nextMeeting = meetings
  .flat()
  .filter((m) => m.date >= today && m.committees.length === 0 && m.status !== 'Cancelled')
  .sort((a, b) => (a.starts_at ?? a.date).localeCompare(b.starts_at ?? b.date))[0];

// States with statewide questions on an upcoming ballot, soonest election first.
const ballots = [...(await loadBallotQuestions())]
  .map(([state, list]) => {
    const upcoming = list.filter((q) => q.election_date >= today);
    const date = upcoming.map((q) => q.election_date).sort()[0];
    return { state, date, count: upcoming.filter((q) => q.election_date === date).length };
  })
  .filter((b) => b.date)
  .sort((a, b) => a.date!.localeCompare(b.date!));

// Federal funding for the year under way, while any of the twelve spending bills is unfinished.
const funding = fundingYear(await loadFundingBills(), fiscalYear(today));
const fundingOpen = funding.enacted < 12;

const latestOrder = orders.find((o) => o.signing_date);
const monthAgo = new Date(Date.now() - 30 * 86_400_000).toISOString().slice(0, 10);
// The newest order and decision join "Latest" only while they are recent.
const recentOrder = latestOrder?.signing_date && latestOrder.signing_date >= monthAgo ? latestOrder : undefined;
const recentCase = cases[0] && cases[0].date_filed >= monthAgo ? cases[0] : undefined;
const recentCaseOutcome = recentCase && outcomes.get(recentCase.cluster_id);
---

<Base section="home">
  <section class="hero wash">
    <div class="hero-text">
      <p class="kicker">Free · Nonpartisan · Open source</p>
      <h1>
        Your government, <span class="gradient-text">in plain view.</span>
      </h1>
      <p class="lede">
        Follow the bills, votes and people shaping your life, from Congress to City Hall. Then add your voice.
      </p>
      <form class="hero-search" role="search" action={href('bills/')} method="get">
        <label for="home-q" class="visually-hidden">
          Search bills, people, hearings, executive orders and more
        </label>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input id="home-q" name="q" type="search" autocomplete="off" placeholder="Search everything" />
        <button type="submit" class="primary">
          Search
        </button>
      </form>
    </div>

    <div class="this-week" aria-label="Latest">
      <p class="kicker">Latest</p>
      {latestVote && (
        <a class="pulse-card" href={voteHref(latestVote.id)}>
          <span class="pulse-label">
            <span class="dot dot-live" aria-hidden="true" />
            {latestVote.chamber === 'house' ? 'House' : 'Senate'} vote · {formatDate(latestVote.date)}
          </span>
          <strong>
            {latestVote.bill || latestVote.subject
              ? [latestVote.bill, latestVote.subject].filter(Boolean).join(': ')
              : (latestVote.question ?? 'Roll-call vote')}
          </strong>
          <span class="pulse-meta">
            {(latestVote.bill || latestVote.subject) && latestVote.question ? `${latestVote.question} · ` : ''}
            {latestVote.result} · {latestVote.yea_total}–{latestVote.nay_total}
          </span>
          <StackedBar size="sm" segments={voteSegments(latestVote)} />
        </a>
      )}
      {ballots.map((b) => (
        <a class="pulse-card pulse-city" href={ballotHref(b.state)}>
          <span class="pulse-label">
            <span class="dot dot-city" aria-hidden="true" />
            On the ballot · {formatDate(b.date)}
          </span>
          <strong>
            {stateName(b.state)}: {b.count} statewide {b.count === 1 ? 'question' : 'questions'}
          </strong>
          <span class="pulse-meta">What a yes and a no vote do, in the state’s own guide →</span>
        </a>
      ))}
      {fundingOpen && (
        <a class="pulse-card" href={href('budget/')}>
          <span class="pulse-label">
            <span class="dot dot-order" aria-hidden="true" />
            Federal funding · FY{funding.year}
          </span>
          <strong>
            {funding.activeStopgap
              ? `Funded by a stopgap${funding.activeStopgap.end ? ` through ${formatDate(funding.activeStopgap.end)}` : ''}`
              : funding.enacted === 0
                ? 'No spending bill or stopgap has become law'
                : `${funding.enacted} of 12 spending bills are law`}
          </strong>
          <span class="pulse-meta">
            {funding.passedHouse} of 12 passed the House · {funding.passedSenate} the Senate →
          </span>
        </a>
      )}
      {latestLaw && (
        <a class="pulse-card" href={billHref(latestLaw.congress, latestLaw.bill_type, latestLaw.number)}>
          <span class="pulse-label">
            <span class="dot dot-law" aria-hidden="true" />
            Became law · {formatDate(latestLaw.latest_action_date)}
          </span>
          <strong>{latestLaw.short_title ?? latestLaw.title}</strong>
        </a>
      )}
      {recentOrder && (
        <a class="pulse-card" href={executiveOrderHref(recentOrder.document_number)}>
          <span class="pulse-label">
            <span class="dot dot-order" aria-hidden="true" />
            Executive order{recentOrder.eo_number ? ` ${recentOrder.eo_number}` : ''} ·{' '}
            {formatDate(recentOrder.signing_date)}
          </span>
          <strong>{recentOrder.title}</strong>
        </a>
      )}
      {recentCase && (
        <a class="pulse-card" href={scotusCaseHref(recentCase.cluster_id)}>
          <span class="pulse-label">
            <span class="dot dot-court" aria-hidden="true" />
            Supreme Court · {formatDate(recentCase.date_filed)}
          </span>
          <strong>{recentCase.case_name}</strong>
          {recentCaseOutcome && (
            <span class="pulse-meta">{outcomeSummary(recentCase.case_name, recentCaseOutcome)}</span>
          )}
        </a>
      )}
      {nextMeeting && (
        <a class="pulse-card pulse-city" href={cityHref(nextMeeting.city, 'council/')}>
          <span class="pulse-label">
            <span class="dot dot-city" aria-hidden="true" />
            {nextMeeting.city.council} · {formatDate(nextMeeting.date)}
          </span>
          <strong>Next council meeting{nextMeeting.time ? ` at ${nextMeeting.time}` : ''}</strong>
        </a>
      )}
      {openDiscussions[0] && (
        <a class="pulse-card pulse-discuss" href={href(`discussions/${openDiscussions[0].id}/`)}>
          <span class="pulse-label">
            <span class="dot dot-discuss" aria-hidden="true" />
            Open discussion
          </span>
          <strong>{openDiscussions[0].title}</strong>
          <span class="pulse-meta">Add your voice →</span>
        </a>
      )}
    </div>
  </section>

  {!DEMO && (
    <>
      <YourArea client:load />
      <div class="reps-pitch">
        <FindMyReps
          client:visible
          intro="See who represents you, from Congress to your statehouse and city council, and how they voted lately. Remember your address on this device and they’ll be here each time you visit."
        />
      </div>
    </>
  )}
  <FeedView client:idle compact />

  <section aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h">Moving in Congress</h2>
      <a class="see-all" href={href('bills/')}>
        All bills
      </a>
    </div>
    {recent.length > 0 ? (
      <ul class="card-grid list moving">
        {recent.map((b) => (
          <BillListItem bill={b} />
        ))}
      </ul>
    ) : (
      <p class="muted">No bills loaded yet.</p>
    )}
  </section>
  <section class="discuss-band" aria-labelledby="disc-h">
    <div class="discuss-intro">
      <p class="kicker">Discussions</p>
      <h2 id="disc-h">Have your say, and see where people agree</h2>
      <ol class="steps">
        <li>
          <strong>Vote</strong> agree or disagree on short statements.
        </li>
        <li>
          <strong>Add</strong> your own point of view in a sentence.
        </li>
        <li>
          <strong>See</strong> where opinion divides and where it comes together.
        </li>
      </ol>
      <a class="button large discuss-cta" href={href('discussions/')}>
        Browse discussions →
      </a>
    </div>
    {openDiscussions.length > 1 && (
      <ul class="list discuss-list">
        {openDiscussions.slice(1, 4).map((d) => (
          <DiscussionCard discussion={d} />
        ))}
      </ul>
    )}
  </section>
  <section class="library-band" aria-labelledby="library-h">
    <div>
      <p class="kicker">Res Publica, our sister library</p>
      <h2 id="library-h">Read the founding texts behind it all</h2>
      <p>
        The Constitution, the Federalist Papers and the ratification debate, every passage linked to what it cites and
        what answers it. Bill pages link the clauses their sponsors cite.
      </p>
    </div>
    <a class="button" href={RES_PUBLICA_URL} rel="noopener">
      Open Res Publica →
    </a>
  </section>
</Base>

<script>
  // The hero search opens the full search (the header's) once it is ready; before
  // that, or without JavaScript, it submits to the bill search.
  const input = document.getElementById('home-q') as HTMLInputElement | null;
  // Closing the search dialog hands focus back to this box, which would open it again
  // (Cancel seemed to do nothing). Ignore focus that arrives just after a close.
  let closedAt = 0;
  document.addEventListener('close', () => (closedAt = Date.now()), true);
  const openSearch = (e?: Event) => {
    if (!input || !('searchReady' in document.documentElement.dataset)) return;
    e?.preventDefault();
    const q = input.value;
    input.value = '';
    // Blur first, so the dialog doesn't remember this box as the place to return focus to.
    input.blur();
    document.dispatchEvent(new CustomEvent('open-search', { detail: { q } }));
  };
  input?.addEventListener('focus', () => {
    if (Date.now() - closedAt > 500) openSearch();
  });
  input?.addEventListener('input', () => openSearch());
  input?.form?.addEventListener('submit', (e) => openSearch(e));
</script>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-5) var(--space-6);
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.25fr 1fr;
      padding-block: var(--space-7) var(--space-7);
    }
  }
  .hero h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.4rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
    max-width: 13ch;
    margin-bottom: var(--space-4);
  }
  .lede {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    color: var(--text-muted);
    max-width: 34rem;
  }
  .hero-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 36rem;
    margin: var(--space-5) 0 var(--space-4);
    padding: 6px 6px 6px var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: var(--shadow-hover);
    color: var(--text-muted);
  }
  .hero-search:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-soft);
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    min-height: 48px;
    font-size: var(--step-1);
    padding: 0;
  }
  .hero-search input:focus-visible {
    box-shadow: none;
  }
  .this-week {
    display: grid;
    gap: var(--space-3);
  }
  .this-week .kicker {
    margin: 0;
  }
  .pulse-card {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  /* Phones: the four newest items, so your representatives aren't far below. */
  @media (max-width: 40rem) {
    .this-week a.pulse-card:nth-of-type(n + 5) {
      display: none;
    }
    /* A returning visitor (districts saved) has read the pitch; get them to their own government sooner. */
    :global(html[data-area]) .hero .kicker,
    :global(html[data-area]) .hero .lede {
      display: none;
    }
  }
  /* Once Your government shows (districts saved), the address form gives way to it. */
  :global(html[data-area]) .reps-pitch {
    display: none;
  }
  .pulse-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }
  .pulse-card strong {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .pulse-label,
  .pulse-meta {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .pulse-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }
  .library-band {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  @media (min-width: 48rem) {
    .library-band {
      grid-template-columns: 1fr auto;
    }
  }
  .library-band h2 {
    margin: 0 0 var(--space-2);
  }
  .library-band p:last-child {
    margin: 0;
    max-width: 60ch;
    color: var(--text-muted);
  }
  .discuss-band {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    margin: var(--space-7) calc(-1 * var(--space-4));
    padding: var(--space-6) var(--space-5);
    border-radius: 28px;
    background:
      radial-gradient(70% 90% at 0% 0%, rgb(123 92 255 / 55%), transparent 70%),
      radial-gradient(60% 80% at 100% 100%, rgb(31 181 211 / 45%), transparent 70%), #14123a;
    color: #f3f2ff;
  }
  @media (min-width: 60rem) {
    .discuss-band {
      grid-template-columns: 1fr 1.3fr;
      margin-inline: 0;
      padding: var(--space-7);
    }
  }
  .discuss-band h2 {
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
    margin-top: 0;
    color: #fff;
  }
  .discuss-band .kicker {
    color: #c9c3ff;
  }
  .steps {
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: #dcd9ff;
  }
  .steps strong {
    color: #fff;
  }
  .discuss-cta {
    background: #fff;
    color: #2b2380;
    border: 0;
  }
  .discuss-cta:hover {
    background: #ecebff;
  }
  .discuss-list :global(li) {
    background: rgb(255 255 255 / 8%);
    border-color: rgb(255 255 255 / 14%);
    box-shadow: none;
    color: #f3f2ff;
  }
  .discuss-list :global(.bill-title a),
  .discuss-list :global(.meta) {
    color: #fff;
  }
  .discuss-list :global(.join) {
    color: #c9c3ff;
  }
  .discuss-list :global(.status-chip) {
    background: rgb(255 255 255 / 16%);
    color: #fff;
  }
  .pulse-discuss {
    background: var(--grad);
    border: 0;
    color: #fff;
  }
  .pulse-discuss .pulse-label,
  .pulse-discuss .pulse-meta {
    color: rgb(255 255 255 / 85%);
  }
  /* Phones: fewer bills and discussions, so the page doesn't scroll forever. */
  @media (max-width: 40rem) {
    .moving > :global(li:nth-child(n + 4)) {
      display: none;
    }
    .discuss-list :global(li:nth-child(n + 3)) {
      display: none;
    }
    .discuss-list :global(.small) {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .steps {
      display: none;
    }
  }
</style>
