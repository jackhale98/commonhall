---
import BillListItem from '../components/BillListItem';
import FeedView from '../components/FeedView';
import FindMyReps from '../components/FindMyReps';
import StackedBar from '../components/viz/StackedBar';
import Base from '../layouts/Base.astro';
import {
  loadBills,
  loadCommitteeMeetings,
  loadDiscussions,
  loadExecutiveOrders,
  loadLocalMeetings,
  loadScotusCases,
  loadScotusOutcomeMap,
  loadVotes,
} from '../lib/build-data';
import { voteSegments } from '../lib/charts';
import { outcomeSummary } from '../lib/court';
import { DEMO } from '../lib/config';
import { formatDate } from '../lib/format';
import { billHref, executiveOrderHref, href, scotusCaseHref, voteHref } from '../lib/paths';

const [bills, votes, discussions, meetings, orders, cases, hearings, outcomes] = await Promise.all([
  loadBills(),
  loadVotes(),
  loadDiscussions(),
  loadLocalMeetings(),
  loadExecutiveOrders(),
  loadScotusCases(),
  loadCommitteeMeetings(),
  loadScotusOutcomeMap(),
]);
const recent = bills.slice(0, 6);
const laws = bills.filter((b) => b.status === 'law');
const latestLaw = [...laws].sort((a, b) => (b.latest_action_date ?? '').localeCompare(a.latest_action_date ?? ''))[0];
const latestVote = votes[0];
const openDiscussions = discussions.filter((d) => d.status === 'open');
const today = new Date().toISOString().slice(0, 10);
const nextMeeting = [...meetings].reverse().find((m) => m.date >= today);

// Executive orders in the current presidential term (terms start January 20 after a leap-year election).
const latestOrder = orders.find((o) => o.signing_date);
const termYear = latestOrder?.signing_date
  ? (() => {
      const y = Number(latestOrder.signing_date.slice(0, 4));
      const start = y - ((y - 1) % 4);
      return latestOrder.signing_date >= `${start}-01-20` ? start : start - 4;
    })()
  : null;
const termOrders = termYear
  ? orders.filter((o) => o.president === latestOrder!.president && (o.signing_date ?? '') >= `${termYear}-01-20`)
  : [];
// Supreme Court: the most recent term with decisions.
const courtTerm = cases[0]?.term;
const termCases = courtTerm === undefined ? [] : cases.filter((c) => c.term === courtTerm);
const monthAgo = new Date(Date.now() - 30 * 86_400_000).toISOString().slice(0, 10);
// The newest order and decision join "Latest" only while they are recent.
const recentOrder = latestOrder?.signing_date && latestOrder.signing_date >= monthAgo ? latestOrder : undefined;
const recentCase = cases[0] && cases[0].date_filed >= monthAgo ? cases[0] : undefined;
const recentCaseOutcome = recentCase && outcomes.get(recentCase.cluster_id);
const recentHearings = hearings.filter((m) => m.date && m.date >= monthAgo && m.date <= today);

const stats = [
  { value: bills.length, label: 'bills this Congress', href: href('bills/') },
  { value: laws.length, label: laws.length === 1 ? 'new law' : 'new laws', href: href('bills/?status=law') },
  { value: votes.length, label: 'roll-call votes', href: href('votes/') },
  { value: termOrders.length, label: 'executive orders this term', href: href('executive/') },
  {
    value: termCases.length,
    label: courtTerm === undefined ? 'court decisions' : `court decisions, ${courtTerm} term`,
    href: href('court/'),
  },
  { value: recentHearings.length, label: 'hearings in the last 30 days', href: href('committees/') },
].filter((s) => s.value > 0);
---

<Base section="home">
  <section class="hero wash">
    <div class="hero-text">
      <p class="kicker">Free · Nonpartisan · Open source</p>
      <h1>
        Your government, <span class="gradient-text">in plain view.</span>
      </h1>
      <p class="lede">
        Follow the bills, votes and people shaping your life, from Congress to City Hall. Then add your voice.
      </p>
      <form class="hero-search" role="search" action={href('bills/')} method="get">
        <label for="home-q" class="visually-hidden">
          Search bills, people, hearings, executive orders and more
        </label>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input id="home-q" name="q" type="search" autocomplete="off" placeholder="Search everything" />
        <button type="submit" class="primary">
          Search
        </button>
      </form>
    </div>

    <div class="this-week" aria-label="Latest">
      <p class="kicker">Latest</p>
      {latestVote && (
        <a class="pulse-card" href={voteHref(latestVote.id)}>
          <span class="pulse-label">
            <span class="dot dot-live" aria-hidden="true" />
            {latestVote.chamber === 'house' ? 'House' : 'Senate'} vote · {formatDate(latestVote.date)}
          </span>
          <strong>{latestVote.question ?? 'Roll-call vote'}</strong>
          <span class="pulse-meta">
            {latestVote.result} · {latestVote.yea_total}–{latestVote.nay_total}
          </span>
          <StackedBar size="sm" segments={voteSegments(latestVote)} />
        </a>
      )}
      {latestLaw && (
        <a class="pulse-card" href={billHref(latestLaw.congress, latestLaw.bill_type, latestLaw.number)}>
          <span class="pulse-label">
            <span class="dot dot-law" aria-hidden="true" />
            Became law · {formatDate(latestLaw.latest_action_date)}
          </span>
          <strong>{latestLaw.short_title ?? latestLaw.title}</strong>
        </a>
      )}
      {recentOrder && (
        <a class="pulse-card" href={executiveOrderHref(recentOrder.document_number)}>
          <span class="pulse-label">
            <span class="dot dot-order" aria-hidden="true" />
            Executive order{recentOrder.eo_number ? ` ${recentOrder.eo_number}` : ''} ·{' '}
            {formatDate(recentOrder.signing_date)}
          </span>
          <strong>{recentOrder.title}</strong>
        </a>
      )}
      {recentCase && (
        <a class="pulse-card" href={scotusCaseHref(recentCase.cluster_id)}>
          <span class="pulse-label">
            <span class="dot dot-court" aria-hidden="true" />
            Supreme Court · {formatDate(recentCase.date_filed)}
          </span>
          <strong>{recentCase.case_name}</strong>
          {recentCaseOutcome && (
            <span class="pulse-meta">{outcomeSummary(recentCase.case_name, recentCaseOutcome)}</span>
          )}
        </a>
      )}
      {nextMeeting && (
        <a class="pulse-card pulse-city" href={href('boston/')}>
          <span class="pulse-label">
            <span class="dot dot-city" aria-hidden="true" />
            Boston City Council · {formatDate(nextMeeting.date)}
          </span>
          <strong>Next council meeting{nextMeeting.time ? ` at ${nextMeeting.time}` : ''}</strong>
        </a>
      )}
      {openDiscussions[0] && (
        <a class="pulse-card pulse-discuss" href={href(`discussions/${openDiscussions[0].id}/`)}>
          <span class="pulse-label">
            <span class="dot dot-discuss" aria-hidden="true" />
            Open discussion
          </span>
          <strong>{openDiscussions[0].title}</strong>
          <span class="pulse-meta">Add your voice →</span>
        </a>
      )}
    </div>
  </section>

  <ul class="stat-strip" aria-label="By the numbers">
    {stats.map((s) => (
      <li>
        <a href={s.href}>
          <span class="stat-value">{s.value.toLocaleString()}</span>
          <span class="stat-label">{s.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <FeedView client:idle compact />
  {!DEMO && <FindMyReps client:visible />}

  <section aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h">Moving in Congress</h2>
      <a class="see-all" href={href('bills/')}>
        All bills
      </a>
    </div>
    {recent.length > 0 ? (
      <ul class="card-grid list moving">
        {recent.map((b) => (
          <BillListItem bill={b} />
        ))}
      </ul>
    ) : (
      <p class="muted">No bills loaded yet.</p>
    )}
  </section>
</Base>

<script>
  // The hero search opens the full search (the header's) once it is ready; before
  // that, or without JavaScript, it submits to the bill search.
  const input = document.getElementById('home-q') as HTMLInputElement | null;
  const openSearch = (e?: Event) => {
    if (!input || !('searchReady' in document.documentElement.dataset)) return;
    e?.preventDefault();
    document.dispatchEvent(new CustomEvent('open-search', { detail: { q: input.value } }));
    input.value = '';
    input.blur();
  };
  input?.addEventListener('focus', () => openSearch());
  input?.addEventListener('input', () => openSearch());
  input?.form?.addEventListener('submit', (e) => openSearch(e));
</script>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-5) var(--space-6);
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.25fr 1fr;
      padding-block: var(--space-7) var(--space-7);
    }
  }
  .hero h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.4rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
    max-width: 13ch;
    margin-bottom: var(--space-4);
  }
  .lede {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    color: var(--text-muted);
    max-width: 34rem;
  }
  .hero-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 36rem;
    margin: var(--space-5) 0 var(--space-4);
    padding: 6px 6px 6px var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: var(--shadow-hover);
    color: var(--text-muted);
  }
  .hero-search:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-soft);
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    min-height: 48px;
    font-size: var(--step-1);
    padding: 0;
  }
  .hero-search input:focus-visible {
    box-shadow: none;
  }
  .this-week {
    display: grid;
    gap: var(--space-3);
  }
  .this-week .kicker {
    margin: 0;
  }
  .pulse-card {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .pulse-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }
  .pulse-card strong {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .pulse-label,
  .pulse-meta {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .pulse-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }
  .pulse-discuss {
    background: var(--grad);
    border: 0;
    color: #fff;
  }
  .pulse-discuss .pulse-label,
  .pulse-discuss .pulse-meta {
    color: rgb(255 255 255 / 85%);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .dot-live {
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent);
  }
  .dot-law {
    background: var(--highlight);
  }
  .dot-city {
    background: var(--sky);
  }
  .dot-discuss {
    background: #fff;
  }
  .dot-order {
    background: var(--brand);
  }
  .dot-court {
    background: var(--cat-markup);
  }
  .stat-strip {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 40rem) {
    .stat-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 72rem) {
    .stat-strip {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .stat-strip li {
    display: grid;
  }
  .stat-strip a {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .stat-strip a:hover {
    border-color: var(--brand);
  }
  .stat-value {
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.2rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.3;
  }
  /* Phones: fewer bills and discussions, so the page doesn't scroll forever. */
  @media (max-width: 40rem) {
    .moving > :global(li:nth-child(n + 4)) {
      display: none;
    }
    /* An odd number of stat tiles: the last one spans the row. */
    /* Phones: the council meeting gives way; everything else in "Latest" stays. */
    .pulse-city {
      display: none;
    }
    .stat-strip li:last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }
</style>
