---
import BillListItem from '../components/BillListItem';
import FeedView from '../components/FeedView';
import Base from '../layouts/Base.astro';
import VoteList from '../components/VoteList';
import { CURRENT_CONGRESS, loadBills, loadVotes } from '../lib/build-data';
import { congressLabel } from '../lib/format';
import { href } from '../lib/paths';

const [bills, votes] = await Promise.all([loadBills(), loadVotes()]);
const recentVotes = votes.slice(0, 6);
const recent = bills.slice(0, 8);
const laws = bills.filter((b) => b.status === 'law').length;
---

<Base section="home">
  <section class="hero">
    <h1>Follow what Congress and your statehouse are doing</h1>
    <p class="lede">
      Federal and state bills, legislators and roll-call votes, in plain view. Sign in with your email to follow bills
      and legislators and see their activity in one feed.
    </p>
    <form class="hero-search" role="search" action={href('bills/')} method="get">
      <label for="home-q" class="visually-hidden">
        Search bills
      </label>
      <input id="home-q" name="q" type="search" placeholder="Search bills, e.g. “veterans housing”" />
      <button type="submit" class="primary">
        Search
      </button>
    </form>
  </section>

  <FeedView client:idle compact />
  <div data-find-reps></div>

  <section aria-labelledby="recent-h">
    <h2 id="recent-h">Recently active bills</h2>
    {recent.length > 0 ? (
      <>
        <ul class="list">
          {recent.map((b) => (
            <BillListItem bill={b} />
          ))}
        </ul>
        <p>
          <a href={href('bills/')}>
            All {bills.length.toLocaleString()} bills in the {congressLabel(CURRENT_CONGRESS)}
          </a>
          {laws > 0 && <span class="muted"> · {laws} have become law</span>}
        </p>
      </>
    ) : (
      <p class="muted">No bills loaded yet.</p>
    )}
  </section>

  {recentVotes.length > 0 && (
    <section aria-labelledby="votes-h">
      <h2 id="votes-h">Recent roll-call votes</h2>
      <VoteList votes={recentVotes} />
    </section>
  )}
</Base>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-5);
  }
  .hero h1 {
    max-width: 22ch;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3.2rem);
  }
  .lede {
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .hero-search {
    display: flex;
    gap: var(--space-2);
    max-width: 36rem;
  }
</style>
