---
import CommitteeExplorer, { type CommitteeCard } from '../../components/CommitteeExplorer';
import CommitteeMeetingBars from '../../components/viz/CommitteeMeetingBars.astro';
import WeeklyMeetings, { type WeekCount } from '../../components/viz/WeeklyMeetings.astro';
import Base from '../../layouts/Base.astro';
import {
  CURRENT_CONGRESS,
  loadBillCommittees,
  loadCommitteeMeetings,
  loadCommitteeMembers,
  loadCommittees,
  loadMembers,
} from '../../lib/build-data';
import { shortCommitteeName } from '../../lib/committees';
import { congressLabel } from '../../lib/format';
import { href } from '../../lib/paths';
import { isCanceled, KINDS, meetingKind, meetingRow, weekOf, type MeetingKind } from '../../lib/meetings';

const [committees, roster, referrals, meetings, members] = await Promise.all([
  loadCommittees(),
  loadCommitteeMembers(),
  loadBillCommittees(),
  loadCommitteeMeetings(),
  loadMembers(),
]);
const now = new Date();
const nowIso = now.toISOString();
const held = meetings.filter((m) => m.date && !isCanceled(m));
const parentOf = (code: string) => committees.get(code)?.parent_code ?? code;
const zero = (): Record<MeetingKind, number> => ({ hearing: 0, markup: 0, other: 0 });

// Weekly activity: the last 16 weeks and the next 3.
const thisWeek = weekOf(nowIso);
const weekStarts: string[] = [];
for (let i = -15; i <= 3; i++) {
  const d = new Date(`${thisWeek}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + i * 7);
  weekStarts.push(d.toISOString().slice(0, 10));
}
const weeks: WeekCount[] = weekStarts.map((week) => ({ week, counts: zero(), upcoming: week > thisWeek }));
const weekIndex = new Map(weeks.map((w) => [w.week, w]));
for (const m of held) {
  const w = weekIndex.get(weekOf(m.date!));
  if (w) w.counts[meetingKind(m)] += 1;
}

// Busiest committees this Congress (subcommittee meetings count toward their committee).
const perCommittee = new Map<string, Record<MeetingKind, number>>();
for (const m of held) {
  for (const code of new Set(m.committee_codes.map(parentOf))) {
    if (!committees.has(code)) continue;
    const c = perCommittee.get(code) ?? zero();
    c[meetingKind(m)]++;
    perCommittee.set(code, c);
  }
}
const busiest = [...perCommittee]
  .map(([code, counts]) => ({ code, counts, total: KINDS.reduce((n, k) => n + counts[k], 0) }))
  .sort((a, b) => b.total - a.total)
  .slice(0, 12)
  .map(({ code, counts }) => {
    const c = committees.get(code)!;
    return {
      label: `${c.chamber === 'house' ? 'House' : c.chamber === 'senate' ? 'Senate' : 'Joint'} ${shortCommitteeName(c.name)}`,
      href: href(`committees/${code}/`),
      counts,
    };
  });

// Cards for the explorer.
const leader = (code: string, re: RegExp) => {
  const seat = roster.find((r) => r.committee_code === code && r.title && re.test(r.title));
  return seat ? (members.get(seat.member_id)?.name ?? null) : null;
};
const meetingCount = new Map<string, { all: number; upcoming: number }>();
for (const m of held) {
  for (const code of new Set([...m.committee_codes, ...m.committee_codes.map(parentOf)])) {
    const c = meetingCount.get(code) ?? { all: 0, upcoming: 0 };
    c.all++;
    if (m.date! >= nowIso) c.upcoming++;
    meetingCount.set(code, c);
  }
}
const cards: CommitteeCard[] = [...committees.values()].map((c) => ({
  code: c.code,
  parent: c.parent_code,
  chamber: c.chamber,
  name: c.name,
  short: c.parent_code ? c.name : shortCommitteeName(c.name),
  chair: leader(c.code, /^chair/i),
  ranking: leader(c.code, /ranking/i),
  subs: [...committees.values()].filter((s) => s.parent_code === c.code).length,
  meetings: meetingCount.get(c.code)?.all ?? 0,
  upcoming: meetingCount.get(c.code)?.upcoming ?? 0,
  bills: new Set((referrals.byCommittee.get(c.code) ?? []).map((r) => r.bill_id)).size,
}));

// Stats.
const upcoming14 = held.filter(
  (m) => m.date! >= nowIso && m.date! <= new Date(now.getTime() + 14 * 86_400_000).toISOString(),
).length;
const count = (k: MeetingKind) => held.filter((m) => meetingKind(m) === k).length;
const monthAgo = new Date(now.getTime() - 30 * 86_400_000).toISOString();
const initialWhen = held.some((m) => m.date! >= nowIso)
  ? 'upcoming'
  : held.some((m) => m.date! >= monthAgo)
    ? 'month'
    : 'all';
const parentsCount = [...committees.values()].filter((c) => !c.parent_code).length;
const subsCount = committees.size - parentsCount;
---

<Base
  title="Committees"
  description="Every committee of Congress: who sits on it, its hearings and markups, and the bills sent to it."
  section="members"
>
  <header class="page-head wash">
    <p class="kicker">{congressLabel(CURRENT_CONGRESS)}</p>
    <h1>Committees</h1>
    <p class="lede">
      Most bills are decided in committee: they hold hearings, amend bills in markups, and choose which ones reach the
      floor. See what each committee is working on and who sits on it.
    </p>
  </header>

  {committees.size === 0 && <p class="muted">Committees have not loaded yet.</p>}

  <dl class="stat-grid">
    <div class="stat">
      <dt>Coming up in the next two weeks</dt>
      <dd>{upcoming14.toLocaleString()}</dd>
    </div>
    <div class="stat">
      <dt>Hearings this Congress</dt>
      <dd>{count('hearing').toLocaleString()}</dd>
    </div>
    <div class="stat">
      <dt>Markups this Congress</dt>
      <dd>{count('markup').toLocaleString()}</dd>
    </div>
    <div class="stat">
      <dt>Committees and subcommittees</dt>
      <dd>
        {parentsCount} <span class="muted small">+ {subsCount}</span>
      </dd>
    </div>
  </dl>

  {held.length > 0 && (
    <div class="activity-grid">
      <section class="panel" aria-labelledby="weekly-h">
        <h2 id="weekly-h" class="h-small">
          Committee meetings per week
        </h2>
        <WeeklyMeetings weeks={weeks} label="Committee meetings per week, by type" />
      </section>
      <section class="panel" aria-labelledby="busiest-h">
        <h2 id="busiest-h" class="h-small">
          Busiest committees this Congress
        </h2>
        <CommitteeMeetingBars rows={busiest} label="Committees with the most meetings this Congress, by type" />
      </section>
    </div>
  )}

  <CommitteeExplorer
    client:load
    committees={cards}
    meetings={held.map(meetingRow)}
    now={nowIso}
    initialWhen={initialWhen}
  />

  <p class="small muted">
    Rosters from{' '}
    <a href="https://github.com/unitedstates/congress-legislators" rel="noopener">
      congress-legislators
    </a>
    ; hearings, markups and referrals from Congress.gov. Meeting counts cover meetings loaded so far this Congress;
    canceled and postponed meetings are left out of the charts.
  </p>
</Base>

<style>
  .stat-grid {
    margin: var(--space-5) 0;
  }
  .activity-grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 64rem) {
    .activity-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }
</style>
