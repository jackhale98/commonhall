---
import DataFreshness from '../../components/DataFreshness.astro';
import { SOURCES } from '../../lib/freshness';
import { safeUrl } from '@civic/congress-client/safe-url';
import BarList from '../../components/viz/BarList';
import Base from '../../layouts/Base.astro';
import {
  STAGE_LABELS,
  fiscalYear,
  fundingYear,
  trackedYears,
  type FundingBill,
  type FundingStage,
} from '../../lib/appropriations';
import { loadAgencyBudgets, loadAreaSpending, loadFundingBills, loadMtsLines } from '../../lib/build-data';
import { agencyHref, perPerson, statementMonth, statements, type StatementItem } from '../../lib/federal-budget';
import { formatMoney } from '../../lib/finance';
import { billNumberLabel, formatDate, stateName } from '../../lib/format';
import { budgetChange } from '../../lib/local';
import { billHref, href } from '../../lib/paths';

const today = new Date().toISOString().slice(0, 10);
const bills = await loadFundingBills();
const current = fiscalYear(today);
// Each tracked year, whether it has begun, and the stopgap in force.
const years = trackedYears(today).map((year) => {
  const y = fundingYear(bills, year);
  return { ...y, started: !(year > current), stop: y.activeStopgap };
});
const daysUntil = (date: string) =>
  Math.round((Date.parse(`${date}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / 86_400_000);
const fy = (y: number) => `FY${y}`;
const name = (b: FundingBill) => b.short_title?.trim() || b.title;
const label = (b: FundingBill) => billNumberLabel(b);
const chip = (stage: FundingStage) => `status-chip status-${stage}`;

// The Treasury's monthly statement: the last whole year, and the year under way when it has begun.
const [mtsLines, agencies, areas] = await Promise.all([loadMtsLines(), loadAgencyBudgets(), loadAreaSpending()]);
const held = statements(mtsLines);
const whole = held.find((st) => st.months === 12) ?? held[0] ?? null;
const soFar = held[0] && held[0] !== whole ? held[0] : null;
const change = (value: number, prev: number) => budgetChange(value, prev);
const bars = (items: StatementItem[], top: number) => {
  const shown = items.slice(0, top).map((i) => ({ label: i.label, value: i.value, note: change(i.value, i.prev) }));
  const rest = items.slice(top);
  return rest.length
    ? [
        ...shown,
        {
          label: 'Everything else',
          value: rest.reduce((n, i) => n + i.value, 0),
          note: `(${rest.length} more)`,
        },
      ]
    : shown;
};
const deficitWord = (n: number) => (n >= 0 ? 'Deficit' : 'Surplus');

// Agencies' budgets for the year under way, and awards by state for the last closed year.
const agencyYear = agencies[0]?.fiscal_year ?? null;
const funded = agencies.filter((a) => Number(a.budget_authority) > 0);
const agencyBars = funded.slice(0, 10).map((a) => ({
  label: a.name,
  value: Number(a.budget_authority),
  href: agencyHref(a.slug) ?? undefined,
}));
const states = areas
  .filter((a) => a.district === null)
  .sort((a, b) => stateName(a.state).localeCompare(stateName(b.state)));
const areaYear = states[0]?.fiscal_year ?? null;
const statePages = new Set(states.map((a) => a.state));

const jumps = [
  { id: `fy-${years[0]!.year}`, label: 'Spending bills' },
  ...(whole ? [{ id: 'money-h', label: 'Money in and out' }] : []),
  ...(funded.length ? [{ id: 'agencies-h', label: 'Agencies' }] : []),
  ...(states.length ? [{ id: 'states-h', label: 'By state' }] : []),
];
---

<Base
  title="Federal budget"
  description="How Congress funds the government each year, where each of the twelve spending bills stands, and where the money comes from and goes."
  section="bills"
>
  <header class="page-head wash">
    <p class="kicker">Congress</p>
    <h1>Federal budget</h1>
    <p class="lede">
      Each year Congress passes twelve spending bills, one for each part of the government, or a stopgap to keep it
      funded while it finishes them. Here is where each one stands, and where the money comes from and goes.
    </p>
  </header>
  <DataFreshness {...SOURCES.federalBudget} />

  {jumps.length > 1 && (
    <nav class="page-jumps" aria-label="On this page">
      {jumps.map((j) => (
        <a href={`#${j.id}`}>{j.label}</a>
      ))}
    </nav>
  )}

  {years.map(({ started, stop, ...y }) => (
    <section aria-labelledby={`fy-${y.year}`} class="funding-year">
      <h2 id={`fy-${y.year}`}>Fiscal year {y.year}</h2>
      <p class="small muted section-note">
        October 1, {y.year - 1} to September 30, {y.year}
        {started ? '' : `: the year starts in ${daysUntil(`${y.year - 1}-10-01`)} days`}.
      </p>

      <div class:list={['funding-banner', { 'is-open': started && y.enacted < 12 && !stop }]} role="status">
        {y.enacted === 12 ? (
          <p>
            <strong>All twelve spending bills have become law</strong> for {fy(y.year)}.
          </p>
        ) : stop ? (
          <p>
            <strong>
              Funded by a stopgap{stop.end ? ` through ${formatDate(stop.end)}` : ''}
              {stop.end && daysUntil(stop.end) >= 0 ? ` (${daysUntil(stop.end)} days from today)` : ''}.
            </strong>{' '}
            The <a href={billHref(stop.congress, stop.bill_type, stop.number)}>{name(stop)}</a> ({label(stop)}
            {stop.law_number ? `, Public Law ${stop.law_number}` : ''}) continues funding at last year’s levels for
            anything without its own spending law{stop.end ? '; the date is from its official summary' : ''}.
          </p>
        ) : started ? (
          <p>
            <strong>
              {y.enacted === 0
                ? `No ${fy(y.year)} spending bill or stopgap has become law.`
                : `${y.enacted} of the twelve spending bills have become law; no stopgap covers the rest.`}
            </strong>{' '}
            The fiscal year began on October 1, {y.year - 1}.
          </p>
        ) : (
          <p>
            <strong>{y.enacted} of 12 have become law so far.</strong> Anything not funded by October 1 needs a stopgap.
          </p>
        )}
      </div>

      <dl class="stat-grid funding-stats">
        <div class="stat">
          <dt>Became law</dt>
          <dd>{y.enacted} of 12</dd>
        </div>
        <div class="stat">
          <dt>Passed the House</dt>
          <dd>{y.passedHouse} of 12</dd>
        </div>
        <div class="stat">
          <dt>Passed the Senate</dt>
          <dd>{y.passedSenate} of 12</dd>
        </div>
      </dl>

      <table class="funding-table">
        <caption class="visually-hidden">The twelve {fy(y.year)} spending bills by chamber</caption>
        <thead>
          <tr>
            <th scope="col">Spending bill</th>
            <th scope="col">House</th>
            <th scope="col">Senate</th>
            <th scope="col">Law</th>
          </tr>
        </thead>
        <tbody>
          {y.rows.map((r) => (
            <tr>
              <th scope="row">{r.sub.label}</th>
              {[r.house, r.senate].map((b, i) => (
                <td data-label={i === 0 ? 'House' : 'Senate'}>
                  {b ? (
                    <>
                      <a href={billHref(b.congress, b.bill_type, b.number)}>{label(b)}</a>{' '}
                      <span class={chip(b.stage)}>{STAGE_LABELS[b.stage]}</span>
                    </>
                  ) : (
                    <span class="muted">No bill yet</span>
                  )}
                </td>
              ))}
              <td data-label="Law">
                {r.law ? (
                  <span class="status-chip status-law">
                    {r.law.law_number ? `Public Law ${r.law.law_number}` : 'Became law'}
                  </span>
                ) : (
                  <span class="muted">Not yet</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {y.packages.length > 0 && (
        <>
          <h3 class="h-small">Bills that combine several</h3>
          <ul class="plain-rows">
            {y.packages.map((p) => (
              <li>
                <p class="meta">
                  {label(p)} · <span class={chip(p.stage)}>{STAGE_LABELS[p.stage]}</span>
                  {p.latest_action_date && ` · ${formatDate(p.latest_action_date)}`}
                </p>
                <p class="bill-title-sm">
                  <a href={billHref(p.congress, p.bill_type, p.number)}>{name(p)}</a>
                </p>
              </li>
            ))}
          </ul>
        </>
      )}

      {y.stopgaps.length > 0 && (
        <>
          <h3 class="h-small">Stopgaps (continuing resolutions)</h3>
          <ul class="plain-rows">
            {y.stopgaps.map((s) => (
              <li>
                <p class="meta">
                  {label(s)} · <span class={chip(s.stage)}>{STAGE_LABELS[s.stage]}</span>
                  {s.latest_action_date && ` · ${formatDate(s.latest_action_date)}`}
                  {s.end && ` · would fund through ${formatDate(s.end)}`}
                </p>
                <p class="bill-title-sm">
                  <a href={billHref(s.congress, s.bill_type, s.number)}>{name(s)}</a>
                </p>
                {s.latest_action_text && <p class="small muted">{s.latest_action_text}</p>}
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  ))}

  <p class="small muted source-note">
    Where each bill stands is Congress.gov’s record, checked every 10 minutes; this page is rebuilt nightly. Bills are
    matched to the twelve Appropriations subcommittees by their titles, and bills that combine several by the divisions
    named in their Congressional Research Service summaries. “Reported by committee” means the bill is on the floor
    calendar.
  </p>

  {whole && (
    <section aria-labelledby="money-h" class="budget-part">
      <h2 id="money-h">Money in and out</h2>
      {soFar && (
        <>
          <p class="small muted section-note">
            Fiscal year {soFar.fiscalYear} so far: {soFar.months} {soFar.months === 1 ? 'month' : 'months'}, through{' '}
            {statementMonth(soFar.date)}, beside the same months a year before.
          </p>
          <dl class="stat-grid">
            <div class="stat">
              <dt>Took in</dt>
              <dd>{formatMoney(soFar.receipts)}</dd>
              <p class="small muted stat-note">{change(soFar.receipts, soFar.prior.receipts)}</p>
            </div>
            <div class="stat">
              <dt>Spent</dt>
              <dd>{formatMoney(soFar.outlays)}</dd>
              <p class="small muted stat-note">{change(soFar.outlays, soFar.prior.outlays)}</p>
            </div>
            <div class="stat">
              <dt>{deficitWord(soFar.deficit)}</dt>
              <dd>{formatMoney(Math.abs(soFar.deficit))}</dd>
              <p class="small muted stat-note">
                {`${deficitWord(soFar.prior.deficit).toLowerCase()} of ${formatMoney(Math.abs(soFar.prior.deficit))} a year before`}
              </p>
            </div>
          </dl>
        </>
      )}
      <h3 class="h-small">
        Fiscal year {whole.fiscalYear}
        {whole.months === 12 ? '' : `, through ${statementMonth(whole.date)}`}
      </h3>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Took in</dt>
          <dd>{formatMoney(whole.receipts)}</dd>
          <p class="small muted stat-note">
            {`${change(whole.receipts, whole.prior.receipts)} on FY${whole.fiscalYear - 1} (${formatMoney(whole.prior.receipts)})`}
          </p>
        </div>
        <div class="stat">
          <dt>Spent</dt>
          <dd>{formatMoney(whole.outlays)}</dd>
          <p class="small muted stat-note">
            {`${change(whole.outlays, whole.prior.outlays)} on FY${whole.fiscalYear - 1} (${formatMoney(whole.prior.outlays)})`}
          </p>
        </div>
        <div class="stat">
          <dt>{deficitWord(whole.deficit)}</dt>
          <dd>{formatMoney(Math.abs(whole.deficit))}</dd>
          <p class="small muted stat-note">
            {`${deficitWord(whole.prior.deficit).toLowerCase()} of ${formatMoney(Math.abs(whole.prior.deficit))} in FY${whole.fiscalYear - 1}`}
          </p>
        </div>
      </dl>
      <div class="budget-charts">
        <section class="panel" aria-labelledby="sources-h">
          <h4 id="sources-h" class="h-small">
            Where it came from
          </h4>
          <BarList
            items={bars(whole.sources, 8)}
            label={`Receipts by source, fiscal year ${whole.fiscalYear}`}
            format={formatMoney}
          />
          <p class="small muted">Receipts by source, with the change on FY{whole.fiscalYear - 1}.</p>
        </section>
        <section class="panel" aria-labelledby="functions-h">
          <h4 id="functions-h" class="h-small">
            Where it went
          </h4>
          <BarList
            items={bars(whole.functions, 10)}
            label={`Outlays by budget function, fiscal year ${whole.fiscalYear}`}
            tone="fill-sky"
            format={formatMoney}
          />
          <p class="small muted">
            Outlays by budget function, with the change on FY{whole.fiscalYear - 1}.
            {whole.negatives.length > 0 &&
              ` Not shown: ${whole.negatives
                .map((n) => `${n.label} (${formatMoney(n.value)})`)
                .join(' and ')}, which reduce outlays to the ${formatMoney(whole.outlays)} total.`}
          </p>
        </section>
      </div>
      <p class="small muted">
        From the Treasury’s Monthly Treasury Statement for {statementMonth(held[0]!.date)}, Table 9, through the{' '}
        <a href="https://fiscaldata.treasury.gov/datasets/monthly-treasury-statement/" rel="noopener">
          Fiscal Data API
        </a>
        . Each month’s statement comes out about the eighth working day of the next.
      </p>
    </section>
  )}

  {funded.length > 0 && (
    <section aria-labelledby="agencies-h" class="budget-part">
      <h2 id="agencies-h">Agencies’ budgets, fiscal year {agencyYear}</h2>
      <p class="small muted section-note">
        Budget authority is the money an agency may commit, including balances carried over from earlier years, so it
        adds up to more than a year’s spending; obligations are what it has committed so far, and outlays what it has
        paid. The ten largest of {funded.length} agencies, as they report to USAspending.gov.
      </p>
      <div class="panel">
        <BarList
          items={agencyBars}
          label={`Budget authority by agency, fiscal year ${agencyYear}`}
          format={formatMoney}
        />
      </div>
      <details class="all-rows">
        <summary>All {funded.length} agencies</summary>
        <table class="money-table">
          <thead>
            <tr>
              <th scope="col">Agency</th>
              <th scope="col">Budget authority</th>
              <th scope="col">Obligated</th>
              <th scope="col">Paid out</th>
            </tr>
          </thead>
          <tbody>
            {funded.map((a) => {
              const link = agencyHref(a.slug);
              return (
                <tr>
                  <th scope="row">
                    {link ? (
                      <a href={link} rel="noopener">
                        {a.name}
                      </a>
                    ) : (
                      a.name
                    )}
                  </th>
                  <td>{formatMoney(a.budget_authority)}</td>
                  <td>{formatMoney(a.obligated)}</td>
                  <td>{formatMoney(a.outlays)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </details>
    </section>
  )}

  {states.length > 0 && (
    <section aria-labelledby="states-h" class="budget-part">
      <h2 id="states-h">Federal awards by state, fiscal year {areaYear}</h2>
      <p class="small muted section-note">
        Contracts and grants for work done or aid used in each state from October {areaYear! - 1} to September{' '}
        {areaYear}, and direct payments, as reported to USAspending.gov. Each state’s Congress tab has its congressional
        districts.
      </p>
      <details class="all-rows">
        <summary>All {states.length} states and territories</summary>
        <table class="money-table">
          <thead>
            <tr>
              <th scope="col">State</th>
              <th scope="col">Contracts and grants</th>
              <th scope="col">Per person</th>
              <th scope="col">Direct payments</th>
            </tr>
          </thead>
          <tbody>
            {states.map((a) => {
              const awards = Number(a.contracts) + Number(a.grants);
              const each = perPerson(awards, a.population);
              return (
                <tr>
                  <th scope="row">
                    {statePages.has(a.state) ? (
                      <a href={href(`states/${a.state.toLowerCase()}/`)}>{stateName(a.state)}</a>
                    ) : (
                      stateName(a.state)
                    )}
                  </th>
                  <td>{formatMoney(awards)}</td>
                  <td>{each === null ? '—' : `$${Math.round(each).toLocaleString()}`}</td>
                  <td>{formatMoney(a.other)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </details>
      <p class="small muted">
        Amounts are obligations: money committed in the year, some of it paid later. A contract counts where its work is
        done; direct payments (benefits, payments to insurers and the like) count where they are recorded, which can be
        far from the people they serve. Loans count at their cost to the government. From{' '}
        <a href={safeUrl('https://www.usaspending.gov/search') ?? undefined} rel="noopener">
          USAspending.gov
        </a>
        , read weekly.
      </p>
    </section>
  )}
</Base>

<style>
  .section-note {
    margin-top: 0;
  }
  .funding-year + .funding-year {
    margin-top: var(--space-7);
  }
  .funding-banner {
    margin: var(--space-3) 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--brand);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--bg-subtle);
  }
  .funding-banner.is-open {
    border-left-color: var(--highlight);
  }
  .funding-banner p {
    margin: 0;
  }
  .funding-stats {
    margin-bottom: var(--space-4);
  }
  .funding-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-bottom: var(--space-5);
  }
  .funding-table th,
  .funding-table td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .funding-table thead th {
    color: var(--text-muted);
    font-weight: 600;
  }
  .funding-table th[scope='row'] {
    font-weight: 600;
  }
  /* Phones: each bill as a block, its chambers and law on labelled lines. */
  @media (max-width: 40rem) {
    .funding-table thead {
      display: none;
    }
    .funding-table tr {
      display: block;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--border);
    }
    .funding-table th,
    .funding-table td {
      display: block;
      border: 0;
      padding: 2px 0;
    }
    .funding-table td::before {
      content: attr(data-label) ': ';
      color: var(--text-muted);
    }
  }
  .source-note {
    margin-top: var(--space-5);
    max-width: 70ch;
  }
  .budget-part {
    margin-top: var(--space-7);
  }
  .budget-part .stat-grid {
    margin-bottom: var(--space-4);
  }
  .budget-part > p.small {
    max-width: 70ch;
  }
  .budget-charts {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 60rem) {
    .budget-charts {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .budget-charts .h-small {
    margin-top: 0;
  }
  .all-rows {
    margin-top: var(--space-3);
  }
  .all-rows summary {
    cursor: pointer;
    color: var(--link);
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
</style>
