---
import DiscussionLink from '../../../../components/DiscussionLink.astro';
import BillFacts from '../../../../components/BillFacts';
import BillLive from '../../../../components/BillLive';
import FollowButton from '../../../../components/FollowButton';
import VoteList from '../../../../components/VoteList';
import Base from '../../../../layouts/Base.astro';
import {
  loadActions,
  loadDiscussionsByTarget,
  loadPrerenderBills,
  loadCosponsors,
  loadMembers,
  loadSubjects,
  loadBillCommittees,
  loadCommittees,
  loadVotesByBill,
} from '../../../../lib/build-data';
import { billDisplayTitle, billNumberLabel, congressLabel, formatDate, paragraphs } from '../../../../lib/format';
import { href } from '../../../../lib/paths';
import type { Bill } from '../../../../lib/types';

export async function getStaticPaths() {
  const bills = await loadPrerenderBills();
  return bills.map((bill) => ({
    params: { congress: String(bill.congress), type: bill.bill_type, number: String(bill.number) },
    props: { bill },
  }));
}

interface Props {
  bill: Bill;
}

const { bill } = Astro.props;
const [members, actionsByBill, cosponsorsByBill, subjectsByBill, votesByBill] = await Promise.all([
  loadMembers(),
  loadActions(),
  loadCosponsors(),
  loadSubjects(),
  loadVotesByBill(),
]);
const votes = votesByBill.get(bill.id) ?? [];
const [{ byBill: committeesByBill }, committeeIndex] = await Promise.all([loadBillCommittees(), loadCommittees()]);
const billCommittees = committeesByBill.get(bill.id) ?? [];
const discussion = (await loadDiscussionsByTarget()).get(`bill:${bill.id}`);
const actions = actionsByBill.get(bill.id) ?? [];
const cosponsors = (cosponsorsByBill.get(bill.id) ?? [])
  .filter((c) => !c.withdrawn_date)
  .sort(
    (a, b) => (a.sponsored_date ?? '').localeCompare(b.sponsored_date ?? '') || a.member_id.localeCompare(b.member_id),
  );
const withdrawn = (cosponsorsByBill.get(bill.id) ?? []).filter((c) => c.withdrawn_date);
const subjects = subjectsByBill.get(bill.id) ?? [];
const sponsor = bill.sponsor_id ? members.get(bill.sponsor_id) : undefined;
const title = billDisplayTitle(bill);
const label = billNumberLabel(bill);
const summary = paragraphs(bill.summary_text);
const description = `${label} (${congressLabel(bill.congress)}): ${bill.title}`.slice(0, 300);
const liveActions = actions.map(({ seq, action_date, text, chamber, source_system }) => ({
  seq,
  action_date,
  text,
  chamber,
  source_system,
}));

// Long summaries (H.R. 1's runs to tens of thousands of words) open with their first
// paragraphs; the rest is a tap away, so the page doesn't scroll for minutes on a phone.
const SUMMARY_LEAD_CHARS = 1200;
let leadChars = 0;
const leadCount = summary.findIndex((p, i) => {
  leadChars += p.length;
  return i >= 1 && leadChars > SUMMARY_LEAD_CHARS;
});
const summaryLead = leadCount === -1 ? summary : summary.slice(0, leadCount);
const summaryRest = leadCount === -1 ? [] : summary.slice(leadCount);
const summaryWords = summary.join(' ').split(/\s+/).length;
/** A summary paragraph, or a bulleted list ("• " lines). */
const summaryBlock = (p: string) =>
  p.includes('\n• ') || p.startsWith('• ')
    ? {
        items: p
          .split('\n')
          .map((line) => line.replace(/^• /, '').trim())
          .filter(Boolean),
      }
    : { text: p };
const leadBlocks = summaryLead.map(summaryBlock);
const restBlocks = summaryRest.map(summaryBlock);
---

<Base title={`${label}: ${title}`} description={description} section="bills">
  <nav aria-label="Breadcrumb" class="small breadcrumb">
    <a href={href('bills/')}>Bills</a> › {congressLabel(bill.congress)} › {label}
  </nav>

  <header class="bill-header">
    <p class="eyebrow">
      {label} · {congressLabel(bill.congress)}
    </p>
    <h1>{title}</h1>
    {bill.short_title && bill.short_title !== bill.title && <p class="official-title">{bill.title}</p>}
    <p class="meta cluster small">
      {bill.introduced_date && <span>Introduced {formatDate(bill.introduced_date)}</span>}
      {bill.policy_area && <span>Policy area: {bill.policy_area}</span>}
      {bill.law_number && <span>Public Law {bill.law_number}</span>}
    </p>
    <div class="cluster bill-actions-row">
      <FollowButton client:idle targetType="bill" targetId={bill.id} label={label} />
      {bill.text_url && (
        <a class="button" href={bill.text_url} rel="noopener">
          Read the text
        </a>
      )}
      {bill.congress_gov_url && (
        <a class="button" href={bill.congress_gov_url} rel="noopener">
          On Congress.gov
        </a>
      )}
    </div>
    <BillFacts
      sponsor={sponsor ?? null}
      cosponsors={cosponsors.map((c) => ({
        member_id: c.member_id,
        is_original: c.is_original,
        member: members.get(c.member_id) ?? null,
      }))}
      withdrawn={withdrawn.length}
      committees={billCommittees}
      knownCommittees={new Set(committeeIndex.keys())}
      subjects={subjects}
    />
  </header>
  <DiscussionLink discussion={discussion} targetType="bill" targetId={bill.id} />

  <div class="bill-layout">
    <div class="bill-main">
      <section aria-label="Status">
        <BillLive
          client:idle
          part="summary"
          billId={bill.id}
          billType={bill.bill_type}
          status={bill.status}
          latest_action_date={bill.latest_action_date}
          latest_action_text={bill.latest_action_text}
          actions={[]}
        />
      </section>

      <section aria-labelledby="summary-h">
        <h2 id="summary-h">Summary</h2>
        {summary.length > 0 ? (
          <div class="summary">
            {leadBlocks.map((b) =>
              b.items ? (
                <ul>
                  {b.items.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              ) : (
                <p>{b.text}</p>
              ),
            )}
            {restBlocks.length > 0 && (
              <details class="summary-more">
                <summary>Read the full summary ({summaryWords.toLocaleString()} words)</summary>
                {restBlocks.map((b) =>
                  b.items ? (
                    <ul>
                      {b.items.map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{b.text}</p>
                  ),
                )}
              </details>
            )}
            <p class="small muted">Summary by the Congressional Research Service.</p>
          </div>
        ) : (
          <p class="muted">The Congressional Research Service has not summarized this bill yet.</p>
        )}
      </section>

      <section aria-labelledby="actions-h">
        <h2 id="actions-h">Actions</h2>
        <BillLive
          client:visible
          part="timeline"
          billId={bill.id}
          billType={bill.bill_type}
          status={bill.status}
          latest_action_date={bill.latest_action_date}
          latest_action_text={bill.latest_action_text}
          actions={liveActions}
        />
      </section>

      {votes.length > 0 && (
        <section aria-labelledby="votes-h">
          <h2 id="votes-h">Roll-call votes</h2>
          <VoteList votes={votes} />
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .breadcrumb {
    margin-bottom: var(--space-3);
    color: var(--text-muted);
  }
  .bill-actions-row {
    margin-top: var(--space-4);
  }
  .bill-layout {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-5);
  }
  .summary ul {
    max-width: var(--measure);
  }
  .summary-more > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--brand-strong);
    padding-block: var(--space-2);
    min-height: 2.75rem;
  }
  .summary-more[open] > summary {
    margin-bottom: var(--space-3);
  }
</style>
