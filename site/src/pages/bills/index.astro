---
import BillExplorer from '../../components/BillExplorer';
import BarList from '../../components/viz/BarList';
import Pipeline from '../../components/viz/Pipeline';
import { pipeline, topPolicyAreas } from '../../lib/charts';
import Base from '../../layouts/Base.astro';
import { CURRENT_CONGRESS, loadBills, loadDiscussions, loadMembers, loadPolicyAreas } from '../../lib/build-data';
import { DEMO } from '../../lib/config';
import { congressLabel } from '../../lib/format';
import type { BillListItem as Bill } from '../../lib/types';

const [bills, policyAreas, members, discussions] = await Promise.all([
  loadBills(),
  loadPolicyAreas(),
  loadMembers(),
  loadDiscussions(),
]);
const discussed = discussions.filter((d) => d.target_type === 'bill' && d.target_id).map((d) => d.target_id!);
// loadBills() is ordered by latest action, newest first.
const initial: Bill[] = bills
  .slice(0, 50)
  .map(
    ({
      id,
      congress,
      bill_type,
      number,
      title,
      short_title,
      introduced_date,
      latest_action_date,
      latest_action_text,
      status,
      sponsor_id,
      policy_area,
    }) => ({
      id,
      congress,
      bill_type,
      number,
      title,
      short_title,
      introduced_date,
      latest_action_date,
      latest_action_text,
      status,
      sponsor_id,
      policy_area,
    }),
  );
---

<Base title="Bills" description={`Search and filter bills in the ${congressLabel(CURRENT_CONGRESS)}.`} section="bills">
  <h1>Bills in the {congressLabel(CURRENT_CONGRESS)}</h1>
  <p class="muted">
    {bills.length > 0 ? `${bills.length.toLocaleString()} bills and resolutions.` : ''} Search titles and summaries, or
    filter by chamber, status, policy area and the sponsor’s party.
  </p>
  {bills.length > 0 && (
    <div class="glance">
      <section class="panel" aria-labelledby="stage-h">
        <h2 id="stage-h" class="h-small">
          Where bills stand
        </h2>
        <Pipeline stages={pipeline(bills)} label="Bills and joint resolutions by stage" />
      </section>
      <section class="panel" aria-labelledby="topics-h">
        <h2 id="topics-h" class="h-small">
          Most active topics
        </h2>
        <BarList items={topPolicyAreas(bills, 7)} label="Bills by policy area" />
      </section>
    </div>
  )}
  <noscript>
    <p class="notice">Search and filters need JavaScript. The most recently active bills are listed below.</p>
  </noscript>
  {DEMO ? (
    <BillExplorer
      client:load
      local
      congress={CURRENT_CONGRESS}
      discussed={discussed}
      policyAreas={policyAreas}
      initial={bills.map((b, i) => ({
        ...initial[i]!,
        ...(i >= initial.length
          ? {
              id: b.id,
              congress: b.congress,
              bill_type: b.bill_type,
              number: b.number,
              title: b.title,
              short_title: b.short_title,
              introduced_date: b.introduced_date,
              latest_action_date: b.latest_action_date,
              latest_action_text: b.latest_action_text,
              status: b.status,
              sponsor_id: b.sponsor_id,
              policy_area: b.policy_area,
            }
          : {}),
        sponsor_party: b.sponsor_id ? (members.get(b.sponsor_id)?.party ?? null) : null,
        summary_text: b.summary_text,
      }))}
    />
  ) : (
    <BillExplorer
      client:load
      congress={CURRENT_CONGRESS}
      initial={initial}
      policyAreas={policyAreas}
      discussed={discussed}
    />
  )}
</Base>

<style>
  .glance {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 var(--space-5);
  }
  @media (min-width: 60rem) {
    .glance {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
