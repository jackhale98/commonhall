---
import CaseExplorer from '../../components/CaseExplorer';
import BarList from '../../components/viz/BarList';
import CourtOutcomes from '../../components/viz/CourtOutcomes.astro';
import Base from '../../layouts/Base.astro';
import {
  loadCaseAbout,
  loadDiscussionsByTarget,
  loadNominations,
  loadScotusCases,
  loadScotusOutcomeMap,
  loadScotusOutcomes,
} from '../../lib/build-data';
import { caseRows, supremeCourtTerm } from '../../lib/court';
import { NOMINATION_STATUS, nominationUrl } from '../../lib/executive';
import { formatDate } from '../../lib/format';

const [cases, nominations, discussions, outcomes, outcomeMap, about] = await Promise.all([
  loadScotusCases(),
  loadNominations(),
  loadDiscussionsByTarget(),
  loadScotusOutcomes(),
  loadScotusOutcomeMap(),
  loadCaseAbout(),
]);
const term = supremeCourtTerm(new Date());
const perTerm = [...Map.groupBy(cases, (c) => c.term)]
  .sort((a, b) => b[0] - a[0])
  .map(([t, list]) => ({ label: `${t}–${String(t + 1).slice(2)}`, value: list.length }));
// Early in a term few decisions are out yet, so the list leads with the newest across terms.
const rows = caseRows(cases, (id) => discussions.has(`scotus_case:${id}`), outcomeMap, about);
const topics = [...new Set(rows.map((r) => r.ta).filter((t): t is string => !!t))].sort();
const termsWithCases = [...new Set(cases.map((c) => c.term))].sort((a, b) => b - a);
// The newest term with decisions (a new term has none until the first opinions in the fall).
const latestTermYear = cases[0]?.term ?? term;
const latestTerm = cases.filter((c) => c.term === latestTermYear);
const latestTermLabel = `${latestTermYear}–${String(latestTermYear + 1).slice(2)}`;
// The newest term the Supreme Court Database has coded.
const codedTerm = outcomes[0]?.term;
const coded = outcomes.filter((o) => o.term === codedTerm);
const share = (n: number) => (coded.length ? `${Math.round((n / coded.length) * 100)}%` : '—');
const codedLabel = codedTerm === undefined ? '' : `${codedTerm}–${String(codedTerm + 1).slice(2)}`;
const authors = [...new Set(rows.map((r) => r.j).filter((j): j is string => !!j))].sort(
  (a, b) => Number(a === 'Per Curiam') - Number(b === 'Per Curiam') || a.localeCompare(b),
);
const courtNominations = nominations.filter((n) =>
  /supreme court of the united states|justice of the supreme/i.test(n.position ?? n.description ?? ''),
);
---

<Base
  title="Supreme Court"
  description="Recent Supreme Court decisions, with links to the opinions and the Court's docket."
  section="court"
>
  <header class="page-head wash">
    <p class="kicker">Judicial branch</p>
    <h1>The Supreme Court</h1>
    <p class="lede">
      Every decision the Court has released in the last five terms, newest first, with the full opinions and the Court’s
      own docket a click away.
    </p>
  </header>

  <dl class="stat-grid">
    <div class="stat">
      <dt>Decisions, {latestTermLabel} term</dt>
      <dd>{latestTerm.length.toLocaleString()}</dd>
    </div>
    <div class="stat">
      <dt>Argued that term</dt>
      <dd>{latestTerm.filter((c) => c.date_argued).length.toLocaleString()}</dd>
    </div>
    {coded.length > 0 && (
      <>
        <div class="stat">
          <dt>Petitioner won, {codedLabel} term</dt>
          <dd>{share(coded.filter((o) => o.party_winning === 1).length)}</dd>
        </div>
        <div class="stat">
          <dt>Unanimous, {codedLabel} term</dt>
          <dd>{share(coded.filter((o) => o.min_votes === 0).length)}</dd>
        </div>
      </>
    )}
  </dl>

  {cases.length === 0 ? (
    <p class="muted">Supreme Court decisions have not loaded yet.</p>
  ) : (
    <>
      {outcomes.length > 0 && (
        <details class="panel outcomes-panel" id="court-outcomes">
          <summary>
            <span class="h-small">Who won, and how divided the Court was, term by term</span>
          </summary>
          <CourtOutcomes outcomes={outcomes} />
        </details>
      )}
      <div class="court-layout">
        <section aria-labelledby="latest-h">
          <div class="section-head">
            <h2 id="latest-h">Decisions</h2>
            <a class="see-all" href="https://www.supremecourt.gov/opinions/opinions.aspx" rel="noopener">
              supremecourt.gov
            </a>
          </div>
          <CaseExplorer
            client:visible
            initial={rows.slice(0, 10)}
            terms={termsWithCases}
            authors={authors}
            outcomes={outcomes.length > 0}
            topics={topics}
          />
        </section>
        <aside>
          <div class="panel side-panel">
            <h3 class="h-small">Decisions per term</h3>
            <BarList items={perTerm} label="Supreme Court decisions per October Term" tone="fill-sky" />
            <p class="small muted">
              A term starts on the first Monday in October; most decisions come out from spring through June.
            </p>
          </div>
          {courtNominations.length > 0 && (
            <div class="panel side-panel">
              <h3 class="h-small">Nominations to the Court</h3>
              <ul class="plain-list">
                {courtNominations.map((n) => (
                  <li>
                    <a href={nominationUrl(n)} rel="noopener">
                      {n.nominee ?? n.citation}
                    </a>
                    <span class="small muted">
                      {' '}
                      · {NOMINATION_STATUS[n.status].label}, {formatDate(n.latest_action_date)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </>
  )}
  <p class="small muted">
    Decisions and opinions from{' '}
    <a href="https://www.courtlistener.com/" rel="noopener">
      CourtListener
    </a>{' '}
    (Free Law Project), refreshed hourly; who won and the vote split from the{' '}
    <a href="https://scdb.la.psu.edu/" rel="noopener">
      Supreme Court Database
    </a>{' '}
    (refreshed monthly; it codes a term after it ends, and leaves out most emergency applications). The author is the
    Justice CourtListener lists for the opinion; most decisions arrive as one combined document, so separate
    concurrences and dissents are rarely listed.
  </p>
</Base>

<script>
  // The outcome charts start open on wide screens and folded on phones.
  const panel = document.getElementById('court-outcomes');
  if (panel && window.matchMedia('(min-width: 60rem)').matches) panel.setAttribute('open', '');
</script>

<style>
  .stat-grid {
    margin-top: var(--space-5);
  }
  .outcomes-panel {
    margin-block: var(--space-5) var(--space-6);
  }
  .outcomes-panel > summary {
    cursor: pointer;
  }
  .outcomes-panel[open] > summary {
    margin-bottom: var(--space-4);
  }
  .court-layout {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 60rem) {
    .court-layout {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }
  .side-panel {
    margin-bottom: var(--space-4);
  }
  .court-layout :global(.case-list p) {
    margin: 0;
  }
  .court-layout :global(.case-name) {
    font-weight: 650;
  }
  .court-layout :global(.case-name a) {
    text-decoration: none;
  }
  .court-layout :global(.case-name a:hover) {
    text-decoration: underline;
  }
  .court-layout :global(.case-topic) {
    color: var(--brand-strong);
    font-weight: 600;
  }
  .court-layout :global(.case-summary) {
    margin: var(--space-1) 0 !important;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
</style>
