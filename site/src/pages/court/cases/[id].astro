---
import DiscussionLink from '../../../components/DiscussionLink.astro';
import Base from '../../../layouts/Base.astro';
import { loadCaseAbout, loadDiscussionsByTarget, loadScotusCases, loadScotusOutcomeMap } from '../../../lib/build-data';
import {
  DISPOSITION,
  docketUrl,
  opinionAuthor,
  outcomeSummary,
  splitSummary,
  type ScotusCase,
} from '../../../lib/court';
import { formatDate } from '../../../lib/format';
import { href } from '../../../lib/paths';

export async function getStaticPaths() {
  return (await loadScotusCases()).map((c) => ({ params: { id: String(c.cluster_id) }, props: { c } }));
}

interface Props {
  c: ScotusCase;
}

const { c } = Astro.props;
const discussion = (await loadDiscussionsByTarget()).get(`scotus_case:${c.cluster_id}`);
const outcome = (await loadScotusOutcomeMap()).get(c.cluster_id);
const about = (await loadCaseAbout()).get(c.cluster_id);
const [aboutStart, aboutRest] = about?.summary ? splitSummary(about.summary) : ['', ''];
const summary = outcome && outcomeSummary(c.case_name, outcome);
const disposition = outcome?.case_disposition ? DISPOSITION[outcome.case_disposition] : undefined;
const author = opinionAuthor(c);
const opinions = [
  author === 'Per Curiam'
    ? 'Decided per curiam (an unsigned opinion of the Court)'
    : author
      ? `Opinion of the Court by ${author}`
      : null,
  c.concurrences > 0 ? `${c.concurrences} concurring opinion${c.concurrences > 1 ? 's' : ''}` : null,
  c.dissents > 0 ? `${c.dissents} dissenting opinion${c.dissents > 1 ? 's' : ''}` : null,
].filter(Boolean);
---

<Base
  title={c.case_name}
  description={`Supreme Court decision in ${c.case_name}, ${formatDate(c.date_filed)}.`}
  section="court"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('court/')}>Supreme Court</a> › {c.case_name}
  </nav>
  <header class="page-head">
    <p class="kicker">
      Supreme Court · October Term {c.term}
      {about?.area && ` · ${about.area}`}
    </p>
    <h1>{c.case_name}</h1>
    <p class="lede">
      Decided {formatDate(c.date_filed)}
      {c.date_argued && `, argued ${formatDate(c.date_argued)}`}.
    </p>
  </header>

  <DiscussionLink discussion={discussion} targetType="scotus_case" targetId={String(c.cluster_id)} />

  {about?.summary && (
    <section class="panel case-about" aria-labelledby="about-h">
      <h2 id="about-h" class="h-small">
        What the case is about
      </h2>
      <p class="about-text">{aboutStart}</p>
      {aboutRest && (
        <details class="about-more">
          <summary>Read the full background</summary>
          <p class="about-text">{aboutRest}</p>
        </details>
      )}
      <p class="small muted">
        From the Court’s syllabus, prepared by the Reporter of Decisions (not part of the opinion), word for word up to
        the Court’s holding.
        {about.issue && ` Topic (Supreme Court Database): ${about.area ? `${about.area}, ` : ''}${about.issue}.`}
      </p>
    </section>
  )}
  {!about?.summary && (about?.area || about?.issue) && (
    <p class="small muted">Topic (Supreme Court Database): {[about.area, about.issue].filter(Boolean).join(', ')}.</p>
  )}

  <dl class="facts">
    {summary && (
      <div>
        <dt>Outcome</dt>
        <dd>
          <strong>{summary}</strong>
          {disposition && <span class="muted"> · {disposition}</span>}
          <span class="small muted">
            {' '}
            (
            <a href="https://scdb.la.psu.edu/" rel="noopener">
              Supreme Court Database
            </a>
            )
          </span>
        </dd>
      </div>
    )}
    {c.docket_number && (
      <div>
        <dt>Docket</dt>
        <dd>
          <a href={docketUrl(c.docket_number)} rel="noopener">
            No. {c.docket_number}
          </a>{' '}
          <span class="small muted">on supremecourt.gov: filings, briefs and the argument calendar</span>
        </dd>
      </div>
    )}
    {c.citations.length > 0 && (
      <div>
        <dt>Citation</dt>
        <dd>{c.citations.join('; ')}</dd>
      </div>
    )}
    {opinions.length > 0 && (
      <div>
        <dt>Opinions</dt>
        <dd>{opinions.join(' · ')}</dd>
      </div>
    )}
  </dl>

  <p class="cluster">
    <a class="button" href={c.url} rel="noopener">
      Read the opinions
    </a>
  </p>
  <p class="small muted">
    Opinions are hosted by{' '}
    <a href="https://www.courtlistener.com/" rel="noopener">
      CourtListener
    </a>{' '}
    (Free Law Project). Separate concurrences and dissents are listed when CourtListener records them separately.
  </p>
</Base>

<style>
  .case-about {
    margin: var(--space-4) 0;
  }
  .case-about .h-small {
    margin-top: 0;
  }
  .about-text {
    max-width: 70ch;
  }
  .about-more summary {
    cursor: pointer;
    color: var(--link);
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .facts dd {
    margin: 0;
  }
</style>
