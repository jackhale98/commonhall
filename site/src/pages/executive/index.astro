---
import NominationExplorer from '../../components/NominationExplorer';
import OrderExplorer from '../../components/OrderExplorer';
import OrdersPace from '../../components/viz/OrdersPace.astro';
import StackedBar from '../../components/viz/StackedBar';
import Base from '../../layouts/Base.astro';
import {
  CURRENT_CONGRESS,
  loadDiscussionsByTarget,
  loadExecutiveOrders,
  loadNominations,
  loadVotesByNomination,
} from '../../lib/build-data';
import {
  NOMINATION_STATUS,
  nominationRows,
  orderRows,
  orderTerms,
  type Nomination,
  type NominationStatus,
} from '../../lib/executive';
import { congressLabel } from '../../lib/format';
import { voteHref } from '../../lib/paths';

const [orders, nominations, votesByNomination, discussions] = await Promise.all([
  loadExecutiveOrders(),
  loadNominations(),
  loadVotesByNomination(),
  loadDiscussionsByTarget(),
]);
const congress = congressLabel(CURRENT_CONGRESS);

// Executive orders split into presidential terms (consecutive runs of one president); the newest is current.
const terms = orderTerms(orders);
const currentTerm = terms[terms.length - 1];
const currentName = currentTerm?.term.name ?? null;
const currentOrders = [...(currentTerm?.orders ?? [])].reverse();
const rows = orderRows(orders, (doc) => discussions.has(`executive_order:${doc}`));
const initialRows = rows.filter((r) => r.g === currentTerm?.term.key).slice(0, 10);

// Nominations: civilian positions (military promotions come in long lists and are counted separately).
const civilian = nominations.filter((n) => !n.is_military);
const military = nominations.filter((n) => n.is_military);
const count = (list: Nomination[], s: NominationStatus) => list.filter((n) => n.status === s).length;
const statusOrder: NominationStatus[] = [
  'confirmed',
  'floor',
  'on_calendar',
  'reported',
  'in_committee',
  'received',
  'withdrawn',
  'returned',
  'rejected',
];
const segments = statusOrder
  .map((s) => ({ label: NOMINATION_STATUS[s].label, value: count(civilian, s), tone: NOMINATION_STATUS[s].tone }))
  .filter((s) => s.value > 0);
const pendingTotal = civilian.filter((n) => NOMINATION_STATUS[n.status].pending).length;
const nomRows = nominationRows(civilian, (n) => {
  const v = votesByNomination.get(n.id)?.find((x) => /nomination/i.test(x.question ?? ''));
  return v ? { href: voteHref(v.id), yea: v.yea_total, nay: v.nay_total } : undefined;
});
const initialNominations = nomRows.filter((n) => NOMINATION_STATUS[n.s].pending).slice(0, 10);
const agencies = [
  ...Map.groupBy(
    civilian.filter((n) => n.organization),
    (n) => n.organization!,
  ),
]
  .sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]))
  .map(([name]) => name);
---

<Base
  title="Executive branch"
  description="Executive orders signed by the President and nominations sent to the Senate, with how each one stands."
  section="executive"
>
  <header class="page-head wash">
    <p class="kicker">Executive branch</p>
    <h1>The President’s orders and nominees</h1>
    <p class="lede">
      Executive orders as published in the Federal Register, and every nomination the President sends to the Senate,
      from committee to confirmation vote.
    </p>
  </header>

  <dl class="stat-grid">
    <div class="stat">
      <dt>
        Executive orders{currentName && ` by ${currentName}`}
        {currentName && ' (this term)'}
      </dt>
      <dd>{currentOrders.length.toLocaleString()}</dd>
    </div>
    <div class="stat">
      <dt>Nominees confirmed ({congress})</dt>
      <dd>{count(civilian, 'confirmed').toLocaleString()}</dd>
    </div>
    <div class="stat">
      <dt>Awaiting the Senate</dt>
      <dd>{pendingTotal.toLocaleString()}</dd>
    </div>
    <div class="stat">
      <dt>Revoked by later orders (since 2009)</dt>
      <dd>{rows.filter((r) => r.rb).length.toLocaleString()}</dd>
    </div>
  </dl>

  <section aria-labelledby="eo-h">
    <div class="section-head">
      <h2 id="eo-h">Executive orders</h2>
      <a class="see-all" href="https://www.federalregister.gov/presidential-documents/executive-orders" rel="noopener">
        Federal Register
      </a>
    </div>
    {orders.length === 0 ? (
      <p class="muted">Executive orders have not loaded yet.</p>
    ) : (
      <div class="eo-layout">
        <div class="panel pace-panel">
          <h3 class="h-small">The pace of executive orders, term by term</h3>
          <OrdersPace orders={orders} today={new Date().toISOString().slice(0, 10)} />
        </div>
        <OrderExplorer client:visible terms={terms.map((t) => t.term).reverse()} initial={initialRows} />
      </div>
    )}
  </section>

  <section aria-labelledby="nom-h">
    <div class="section-head">
      <h2 id="nom-h">Nominations</h2>
      <a class="see-all" href="https://www.congress.gov/nominations" rel="noopener">
        Congress.gov
      </a>
    </div>
    {civilian.length === 0 ? (
      <p class="muted">Nominations have not loaded yet.</p>
    ) : (
      <>
        <div class="panel">
          <h3 class="h-small">Where {civilian.length.toLocaleString()} civilian nominations stand</h3>
          <StackedBar segments={segments} legend />
          {military.length > 0 && (
            <p class="small muted">
              Plus {military.length.toLocaleString()} lists of military promotions, usually confirmed together without a
              recorded vote.
            </p>
          )}
        </div>
        <div class="nom-explorer">
          <NominationExplorer client:visible initial={initialNominations} agencies={agencies} />
        </div>
      </>
    )}
  </section>
  <p class="small muted">
    Sources: the Federal Register (executive orders since 2009) and Congress.gov (nominations in the {congress}).
    Refreshed hourly.
  </p>
</Base>

<style>
  .stat-grid {
    margin-top: var(--space-5);
  }
  .eo-layout {
    display: grid;
    gap: var(--space-4);
  }
  .pace-panel .h-small {
    margin-top: 0;
  }
  .eo-layout :global(.eo-list p) {
    margin: 0;
  }
  .eo-layout :global(.eo-title a),
  .nom-explorer :global(.nom-name a) {
    text-decoration: none;
  }
  .eo-layout :global(.eo-title a:hover),
  .nom-explorer :global(.nom-name a:hover) {
    text-decoration: underline;
  }
  .eo-layout :global(.eo-title),
  .nom-explorer :global(.nom-name) {
    margin: 0;
    font-weight: 650;
  }
  .nom-explorer :global(.nom-list p) {
    margin: 0;
  }
  .nom-explorer {
    margin-top: var(--space-4);
  }
</style>
