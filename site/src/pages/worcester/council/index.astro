---
import CityMeetingList from '../../../components/CityMeetingList.astro';
import CouncilorFinder from '../../../components/CouncilorFinder';
import FindMyReps from '../../../components/FindMyReps';
import DistrictMap from '../../../components/viz/DistrictMap';
import WorcesterHeader from '../../../components/WorcesterHeader.astro';
import Base from '../../../layouts/Base.astro';
import {
  loadWorcesterCommittees,
  loadWorcesterDistricts,
  loadWorcesterMeetings,
  loadWorcesterOfficials,
} from '../../../lib/build-data';
import { DEMO } from '../../../lib/config';
import { localOfficialHref } from '../../../lib/paths';

const [officials, districts, meetings, committees] = await Promise.all([
  loadWorcesterOfficials(),
  loadWorcesterDistricts(),
  loadWorcesterMeetings(),
  loadWorcesterCommittees(),
]);
const features = districts.map((d) => {
  const o = officials.find((x) => x.district === d.district);
  return {
    district: d.district,
    geojson: d.geojson,
    href: o ? localOfficialHref(o.id) : undefined,
    title: `District ${d.district}${o ? `: ${o.name}` : ''}`,
  };
});
const today = new Date().toISOString().slice(0, 10);
const council = meetings.filter((m) => m.committees.length === 0);
const upcoming = council.filter((m) => m.date >= today).reverse();
const recent = council.filter((m) => m.date < today);
const FIRST = 5;
const slugs = new Map(committees.map((c) => [c.name, c.slug]));
---

<Base
  title="Worcester City Council"
  description="Worcester's eleven city councilors, the council district map, and City Council meetings with agendas and minutes."
  section="states"
>
  <WorcesterHeader current="council" />

  <section aria-labelledby="council-h">
    <h2 id="council-h">Your councilors</h2>
    {officials.length === 0 && <p class="muted">Not loaded yet.</p>}
    <div class="council-layout">
      <div class="panel">
        <CouncilorFinder
          client:visible
          councilors={officials.map((o) => ({
            id: o.id,
            name: o.title === 'Mayor' ? `${o.name} (Mayor)` : o.name,
            seat: o.seat,
            district: o.district,
            photo_url: o.photo_url,
          }))}
        />
        {!DEMO && (
          <details class="by-address">
            <summary>Find your district by address</summary>
            <FindMyReps client:visible />
          </details>
        )}
      </div>
      {features.length > 0 && (
        <details class="panel map-panel">
          <summary class="h-small">District map</summary>
          <DistrictMap features={features} label="Worcester City Council districts; select one for its councilor" />
        </details>
      )}
    </div>
  </section>

  <section aria-labelledby="meetings-h">
    <h2 id="meetings-h">City Council meetings</h2>
    {upcoming.length > 0 && (
      <>
        <h3 class="h-small">Coming up</h3>
        <div class="panel">
          <CityMeetingList meetings={upcoming} slugs={slugs} upcoming />
        </div>
      </>
    )}
    {recent.length > 0 && (
      <>
        <h3 class="h-small">Recent</h3>
        <div class="panel">
          <CityMeetingList meetings={recent.slice(0, FIRST)} slugs={slugs} />
          {recent.length > FIRST && (
            <details class="more-meetings">
              <summary>{recent.length - FIRST} earlier meetings</summary>
              <CityMeetingList meetings={recent.slice(FIRST)} slugs={slugs} />
            </details>
          )}
        </div>
      </>
    )}
    {council.length === 0 && <p class="muted">No meetings loaded yet.</p>}
  </section>

  <p class="small muted tab-note">
    <span>
      Councilors from{' '}
      <a href="https://www.worcesterma.gov/city-council/councilors" rel="noopener">
        the city’s website
      </a>
      , checked weekly.
    </span>{' '}
    <span>
      Meetings, agendas and minutes from the city’s{' '}
      <a href="https://worcesterma.primegov.com/public/portal" rel="noopener">
        PrimeGov portal
      </a>
      , checked hourly.
    </span>{' '}
    <span>The district map is the city’s 2020 Census map, in use since the 2022 elections.</span>
  </p>
</Base>

<style>
  .council-layout {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 60rem) {
    .council-layout {
      grid-template-columns: 1.3fr 1fr;
      align-items: start;
    }
  }
  .map-panel summary,
  .by-address summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .map-panel > summary::before,
  .by-address > summary::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline: 0.15rem 0.1rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }
  .map-panel[open] > summary::before,
  .by-address[open] > summary::before {
    transform: rotate(45deg);
  }
  .map-panel > summary::-webkit-details-marker,
  .by-address > summary::-webkit-details-marker {
    display: none;
  }
  .by-address {
    margin-top: var(--space-3);
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
  }
  .by-address summary {
    color: var(--link);
    font-weight: 600;
  }
  .more-meetings summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
  }
</style>
