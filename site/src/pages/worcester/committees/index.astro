---
import CityMeetingList from '../../../components/CityMeetingList.astro';
import WorcesterHeader from '../../../components/WorcesterHeader.astro';
import Base from '../../../layouts/Base.astro';
import { loadWorcesterCommittees, loadWorcesterMeetings } from '../../../lib/build-data';
import { formatDate } from '../../../lib/format';
import { localOfficialHref, worcesterCommitteeHref } from '../../../lib/paths';

const [committees, meetings] = await Promise.all([loadWorcesterCommittees(), loadWorcesterMeetings()]);
const today = new Date().toISOString().slice(0, 10);
const upcoming = meetings.filter((m) => m.committees.length > 0 && m.date >= today).reverse();
const slugs = new Map(committees.map((c) => [c.name, c.slug]));
// Committees that met but aren't on the standing committee list (Finance is the whole council).
const named = new Set(committees.map((c) => c.name));
const others = [...new Set(meetings.flatMap((m) => m.committees).filter((c) => !named.has(c)))].sort();
const next = (name: string) => meetings.filter((m) => m.committees.includes(name) && m.date >= today).at(-1);
const last = (name: string) => meetings.find((m) => m.committees.includes(name) && m.date < today);
---

<Base
  title="Worcester City Council committees"
  description="Worcester City Council standing committees: members, chairs, what each covers, and their meetings."
  section="states"
>
  <WorcesterHeader
    current="committees"
    lede="Three councilors sit on each standing committee, which takes up items the council refers to it."
  />

  <section aria-labelledby="upcoming-h">
    <h2 id="upcoming-h">Upcoming committee meetings</h2>
    {upcoming.length === 0 ? (
      <p class="muted">None scheduled yet.</p>
    ) : (
      <div class="panel">
        <CityMeetingList meetings={upcoming} slugs={slugs} upcoming />
      </div>
    )}
  </section>

  <section aria-labelledby="committees-h">
    <h2 id="committees-h">Standing committees</h2>
    <ul class="plain-rows city-committees">
      {committees.map((c) => {
        const chair = c.members.find((m) => m.role === 'Chair');
        const n = next(c.name);
        const l = last(c.name);
        return (
          <li>
            <a class="committee-name" href={worcesterCommitteeHref(c.slug)}>
              {c.name}
            </a>
            <span class="small muted">
              {chair && (
                <>
                  Chair:{' '}
                  {chair.official_id ? <a href={localOfficialHref(chair.official_id)}>{chair.name}</a> : chair.name}
                  {' · '}
                </>
              )}
              {n ? `Next meeting ${formatDate(n.date)}` : l ? `Last met ${formatDate(l.date)}` : 'No meetings on file'}
            </span>
          </li>
        );
      })}
    </ul>
    {others.length > 0 && (
      <p class="small muted">
        Also meeting: {others.join(', ')}
        {others.includes('Finance') && ' (the whole council sits as the Finance committee)'}.
      </p>
    )}
  </section>

  <p class="small muted tab-note">
    <span>
      Members and descriptions from{' '}
      <a href="https://www.worcesterma.gov/city-council/standing-committees" rel="noopener">
        the city’s website
      </a>
      , checked weekly;
    </span>{' '}
    <span>
      meetings from the city’s{' '}
      <a href="https://worcesterma.primegov.com/public/portal" rel="noopener">
        PrimeGov portal
      </a>
      , checked hourly.
    </span>
  </p>
</Base>

<style>
  .city-committees li {
    display: grid;
    gap: 0.15rem;
  }
  .committee-name {
    font-size: var(--step-0);
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
  }
  .committee-name:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .city-committees .muted a {
    color: inherit;
  }
</style>
