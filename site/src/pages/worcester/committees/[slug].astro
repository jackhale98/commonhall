---
import CityMeetingList from '../../../components/CityMeetingList.astro';
import MemberPhoto from '../../../components/MemberPhoto';
import WorcesterHeader from '../../../components/WorcesterHeader.astro';
import Base from '../../../layouts/Base.astro';
import { loadWorcesterCommittees, loadWorcesterMeetings, loadWorcesterOfficials } from '../../../lib/build-data';
import { href, localOfficialHref } from '../../../lib/paths';
import type { CityCommittee } from '../../../lib/worcester';

export async function getStaticPaths() {
  return (await loadWorcesterCommittees()).map((committee) => ({
    params: { slug: committee.slug },
    props: { committee },
  }));
}

interface Props {
  committee: CityCommittee;
}

const { committee: c } = Astro.props;
const [meetings, officials, committees] = await Promise.all([
  loadWorcesterMeetings(),
  loadWorcesterOfficials(),
  loadWorcesterCommittees(),
]);
const own = meetings.filter((m) => m.committees.includes(c.name));
const today = new Date().toISOString().slice(0, 10);
const upcoming = own.filter((m) => m.date >= today).reverse();
const past = own.filter((m) => m.date < today);
const FIRST = 8;
const slugs = new Map(committees.map((x) => [x.name, x.slug]));
const photo = (id: string | null) => officials.find((o) => o.id === id)?.photo_url ?? null;
---

<Base
  title={`${c.name} · Worcester City Council`}
  description={`The Worcester City Council's Standing Committee on ${c.name}: members and meetings.`}
  section="states"
>
  <WorcesterHeader current="committees" />
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('worcester/committees/')}>Committees</a> › {c.name}
  </nav>
  <h2 class="committee-title">{c.name}</h2>
  <p class="small muted">
    {past.length} {past.length === 1 ? 'meeting' : 'meetings'} on file
    {upcoming.length > 0 && `, ${upcoming.length} coming up`}.
  </p>
  {c.description && <p class="committee-about">{c.description}</p>}

  <section aria-labelledby="members-h">
    <h3 id="members-h" class="h-small">
      Members
    </h3>
    <ul class="plain-members">
      {c.members.map((m) => (
        <li>
          <MemberPhoto name={m.name} url={photo(m.official_id)} size={36} />
          <span>
            {m.official_id ? <a href={localOfficialHref(m.official_id)}>{m.name}</a> : m.name}
            {m.role && <span class="small muted"> · {m.role}</span>}
          </span>
        </li>
      ))}
    </ul>
  </section>

  {upcoming.length > 0 && (
    <section aria-labelledby="upcoming-h">
      <h3 id="upcoming-h" class="h-small">
        Upcoming meetings
      </h3>
      <div class="panel">
        <CityMeetingList meetings={upcoming} slugs={slugs} committee={c.name} upcoming />
      </div>
    </section>
  )}

  <section aria-labelledby="past-h">
    <h3 id="past-h" class="h-small">
      Past meetings
    </h3>
    {past.length === 0 ? (
      <p class="muted">None on file.</p>
    ) : (
      <>
        <CityMeetingList meetings={past.slice(0, FIRST)} slugs={slugs} committee={c.name} plain />
        {past.length > FIRST && (
          <details class="more-meetings">
            <summary>{past.length - FIRST} earlier meetings</summary>
            <CityMeetingList meetings={past.slice(FIRST)} slugs={slugs} committee={c.name} plain />
          </details>
        )}
      </>
    )}
  </section>

  <p class="small muted tab-note">
    <span>
      From{' '}
      <a href="https://www.worcesterma.gov/city-council/standing-committees" rel="noopener">
        the city’s website
      </a>{' '}
      and its{' '}
      <a href="https://worcesterma.primegov.com/public/portal" rel="noopener">
        PrimeGov portal
      </a>
      .
    </span>{' '}
    <span>Items before the committee are in each agenda.</span>
  </p>
</Base>

<style>
  .committee-title {
    font-size: var(--step-2);
    margin-top: var(--space-2);
  }
  .committee-about {
    max-width: 70ch;
  }
  section + section {
    margin-top: var(--space-5);
  }
  .more-meetings summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
  }
</style>
