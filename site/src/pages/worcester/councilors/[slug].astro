---
import FollowButton from '../../../components/FollowButton';
import MemberPhoto from '../../../components/MemberPhoto';
import DistrictMap from '../../../components/viz/DistrictMap';
import Base from '../../../layouts/Base.astro';
import { loadWorcesterCommittees, loadWorcesterDistricts, loadWorcesterOfficials } from '../../../lib/build-data';
import { href, localOfficialHref, worcesterCommitteeHref } from '../../../lib/paths';
import type { LocalOfficial } from '../../../lib/types';

export async function getStaticPaths() {
  return (await loadWorcesterOfficials()).map((official) => ({
    params: { slug: official.id.replace(/^worcester-/, '') },
    props: { official },
  }));
}

interface Props {
  official: LocalOfficial;
}

const { official } = Astro.props;
const [committees, districts, officials] = await Promise.all([
  loadWorcesterCommittees(),
  loadWorcesterDistricts(),
  loadWorcesterOfficials(),
]);
const seats = committees.flatMap((c) =>
  c.members.filter((m) => m.official_id === official.id).map((m) => ({ committee: c, role: m.role })),
);
const chairs = seats.filter((s) => s.role === 'Chair').length;
const features = districts.map((d) => {
  const o = officials.find((x) => x.district === d.district);
  return {
    district: d.district,
    geojson: d.geojson,
    href: o ? localOfficialHref(o.id) : undefined,
    title: `District ${d.district}${o ? `: ${o.name}` : ''}`,
  };
});
const seat = official.seat ?? 'Councilor';
const role = official.title === 'Mayor' ? `Mayor · ${seat}` : official.title ? `${official.title} · ${seat}` : seat;
---

<Base
  title={official.name}
  description={`${official.name}, Worcester City Council (${seat}): committee seats and contact.`}
  section="states"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('states/')}>States</a> › <a href={href('states/ma/')}>Massachusetts</a> ›{' '}
    <a href={href('worcester/')}>Worcester</a> › {official.name}
  </nav>
  <header class="councilor">
    <MemberPhoto name={official.name} url={official.photo_url} size={96} />
    <div>
      <h1>{official.name}</h1>
      <p class="muted">Worcester City Council · {role}</p>
      <div class="cluster">
        <FollowButton client:load targetType="local_official" targetId={official.id} label={official.name} />
        {official.email && (
          <a class="button" href={`mailto:${official.email}`}>
            Email
          </a>
        )}
      </div>
    </div>
  </header>

  <div class="councilor-glance">
    <dl class="stat-grid">
      <div class="stat">
        <dt>Committee seats</dt>
        <dd>{seats.length}</dd>
      </div>
      <div class="stat">
        <dt>Chairs</dt>
        <dd>{chairs}</dd>
      </div>
    </dl>
    {features.length > 0 && (
      <div class="panel">
        <DistrictMap
          features={features}
          highlight={official.district}
          width={320}
          label={
            official.district
              ? `Worcester council districts, District ${official.district} outlined`
              : 'Worcester council districts; at-large councilors represent the whole city'
          }
        />
        <p class="small muted">
          {official.district ? `Represents District ${official.district}.` : 'Represents the whole city (at-large).'}
        </p>
      </div>
    )}
  </div>

  <section aria-labelledby="committees-h">
    <h2 id="committees-h">Committees</h2>
    {seats.length === 0 ? (
      <p class="muted">No standing committee seats listed.</p>
    ) : (
      <ul class="plain-rows">
        {seats.map((s) => (
          <li>
            <a href={worcesterCommitteeHref(s.committee.slug)}>{s.committee.name}</a>
            {s.role && <span class="small muted"> · {s.role}</span>}
          </li>
        ))}
      </ul>
    )}
  </section>

  <p class="small muted tab-note">
    Worcester publishes agendas and minutes rather than individual items and votes, so sponsored items and roll calls
    are not listed here yet.
  </p>
</Base>

<style>
  .councilor-glance {
    display: grid;
    gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-5);
  }
  @media (min-width: 50rem) {
    .councilor-glance {
      grid-template-columns: 1fr 22rem;
    }
  }
  .councilor {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-5);
  }
  .councilor h1 {
    margin: 0;
  }
</style>
