---
import WorcesterCapital from '../../../components/WorcesterCapital';
import WorcesterHeader from '../../../components/WorcesterHeader.astro';
import BarList from '../../../components/viz/BarList';
import Base from '../../../layouts/Base.astro';
import { loadWorcesterCapital } from '../../../lib/build-data';
import { formatMoney } from '../../../lib/finance';
import { planTotals, spendByDepartment, yearSpend } from '../../../lib/worcester';

const budgets = await loadWorcesterCapital();
const fy = (y: number) => `FY${String(y).slice(2)}`;
const label = (b: (typeof budgets)[number]) => `${fy(b.doc.fiscal_year)} ${b.doc.stage}`;
const current = budgets[0];
const items = current?.items ?? [];
const thisYear = items.reduce((n, i) => n + yearSpend(i), 0);
const newAuth = items.reduce((n, i) => n + i.new_authorization, 0);
const departments = spendByDepartment(items);
const TOP = 8;
const bars = [
  ...departments.slice(0, TOP).map((d) => ({ label: d.department, value: d.amount, note: `(${d.projects})` })),
  ...(departments.length > TOP
    ? [
        {
          label: 'Every other department',
          value: departments.slice(TOP).reduce((n, d) => n + d.amount, 0),
          note: `(${departments.length - TOP} more)`,
        },
      ]
    : []),
];
const plan = current ? planTotals(current.doc) : [];
const previous = budgets[1];
const prevSpend = previous ? previous.items.reduce((n, i) => n + yearSpend(i), 0) : 0;
---

<Base
  title="Worcester budget"
  description="Worcester's capital budget: what the city plans to build, repair and buy this year, by department and project."
  section="states"
>
  <WorcesterHeader current="budget" lede="What the city plans to build, repair and buy, project by project." />

  {!current ? (
    <p class="muted">The capital budget hasn’t loaded yet.</p>
  ) : (
    <>
      <h2 id="cap-h">
        Capital budget, {fy(current.doc.fiscal_year)}
        {current.doc.stage === 'proposed' && <span class="pill status-pill">Proposed</span>}
      </h2>
      <p class="small muted section-note">
        {current.doc.stage === 'proposed'
          ? `The City Manager’s proposal for July ${current.doc.fiscal_year - 1} to June ${current.doc.fiscal_year}; the City Council votes on it, and the adopted budget replaces it here.`
          : `As adopted for July ${current.doc.fiscal_year - 1} to June ${current.doc.fiscal_year}.`}{' '}
        Borrowing is paid back over years from the operating budget; “new borrowing approved” is the loan authority the
        council grants this year.
      </p>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Borrowing and cash this year</dt>
          <dd>{formatMoney(thisYear)}</dd>
          {previous && prevSpend > 0 && (
            <p class="small muted stat-note">
              {formatMoney(prevSpend)} in {label(previous)}
            </p>
          )}
        </div>
        <div class="stat">
          <dt>Projects</dt>
          <dd>{items.length}</dd>
          <p class="small muted stat-note">in {departments.length} departments</p>
        </div>
        <div class="stat">
          <dt>New borrowing approved</dt>
          <dd>{formatMoney(newAuth)}</dd>
        </div>
      </dl>

      <div class="budget-charts">
        <section class="panel" aria-labelledby="dept-h">
          <h3 id="dept-h" class="h-small">
            Where it goes this year
          </h3>
          <BarList
            items={bars}
            label={`Capital spending by department, ${fy(current.doc.fiscal_year)}`}
            format={formatMoney}
          />
        </section>
        {plan.length > 0 && (
          <section class="panel" aria-labelledby="plan-h">
            <h3 id="plan-h" class="h-small">
              Five-year plan, {fy(plan[0]!.year)}–{fy(plan.at(-1)!.year)}
            </h3>
            <BarList
              items={plan.map((p) => ({ label: fy(p.year), value: p.amount }))}
              label="Capital plan by year, all departments"
              tone="fill-sky"
              format={formatMoney}
            />
            <p class="small muted">As printed in the plan, before state and other credits.</p>
          </section>
        )}
      </div>

      <section aria-labelledby="projects-h">
        <h2 id="projects-h">Projects</h2>
        <WorcesterCapital client:visible budgets={budgets.map((b) => ({ label: label(b), items: b.items }))} />
      </section>

      <p class="small muted tab-note">
        From the city’s budget documents on{' '}
        {budgets.map((b, i) => (
          <>
            {i > 0 && ' and '}
            <a href={b.doc.source_url} rel="noopener">
              {b.doc.title}
            </a>
          </>
        ))}{' '}
        (Worcester open data), read from the published PDF; every department’s projects add up to its printed sub-total.
      </p>
    </>
  )}
</Base>

<style>
  .budget-charts {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-4);
  }
  @media (min-width: 50rem) {
    .budget-charts {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .status-pill {
    margin-left: var(--space-2);
    font-size: var(--step--1);
    vertical-align: middle;
  }
  .section-note {
    max-width: 70ch;
  }
</style>
