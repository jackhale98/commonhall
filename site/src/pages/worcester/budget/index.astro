---
import WorcesterCapital from '../../../components/WorcesterCapital';
import WorcesterHeader from '../../../components/WorcesterHeader.astro';
import BarList from '../../../components/viz/BarList';
import Base from '../../../layouts/Base.astro';
import { loadWorcesterCapital, loadWorcesterOperating } from '../../../lib/build-data';
import { formatMoney } from '../../../lib/finance';
import { budgetChange } from '../../../lib/local';
import { operatingGroups, planTotals, spendByDepartment, yearSpend } from '../../../lib/worcester';

const [budgets, operating] = await Promise.all([loadWorcesterCapital(), loadWorcesterOperating()]);
// Operating budget: revenue by printed group, spending by department (largest first).
const opLines = operating?.lines ?? [];
const sumLast = (kind: 'revenue' | 'spending', back = 1) =>
  opLines.filter((l) => l.kind === kind).reduce((n, l) => n + (l.amounts.at(-back) ?? 0), 0);
const opTotal = sumLast('spending');
const opPrev = sumLast('spending', 2);
const opChange = opTotal - opPrev;
const revenueTotal = sumLast('revenue');
const share = (v: number, of: number) => (of > 0 ? `${Math.round((v / of) * 100)}%` : '');
const revenueGroups = operating ? operatingGroups(opLines, 'revenue').filter((g) => g.now > 0) : [];
const revenueBars = revenueGroups.map((g) => ({ label: g.label, value: g.now, note: share(g.now, revenueTotal) }));
const propertyTax = revenueGroups.find((g) => /property tax/i.test(g.label))?.now ?? 0;
const spendingLines = opLines
  .filter((l) => l.kind === 'spending')
  .map((l) => ({ label: l.label, grp: l.grp, now: l.amounts.at(-1) ?? 0, before: l.amounts.at(-2) ?? 0 }))
  .sort((a, b) => b.now - a.now);
const OP_TOP = 8;
const spendingBars = [
  ...spendingLines.slice(0, OP_TOP).map((l) => ({ label: l.label, value: l.now, note: budgetChange(l.now, l.before) })),
  ...(spendingLines.length > OP_TOP
    ? [
        {
          label: 'Everything else',
          value: spendingLines.slice(OP_TOP).reduce((n, l) => n + l.now, 0),
          note: `(${spendingLines.length - OP_TOP} more)`,
        },
      ]
    : []),
];
const columns = operating?.columns ?? [];
const fy = (y: number) => `FY${String(y).slice(2)}`;
const label = (b: (typeof budgets)[number]) => `${fy(b.doc.fiscal_year)} ${b.doc.stage}`;
const current = budgets[0];
const items = current?.items ?? [];
const thisYear = items.reduce((n, i) => n + yearSpend(i), 0);
const newAuth = items.reduce((n, i) => n + i.new_authorization, 0);
const departments = spendByDepartment(items);
const TOP = 8;
const bars = [
  ...departments.slice(0, TOP).map((d) => ({ label: d.department, value: d.amount, note: `(${d.projects})` })),
  ...(departments.length > TOP
    ? [
        {
          label: 'Every other department',
          value: departments.slice(TOP).reduce((n, d) => n + d.amount, 0),
          note: `(${departments.length - TOP} more)`,
        },
      ]
    : []),
];
const plan = current ? planTotals(current.doc) : [];
const previous = budgets[1];
const prevSpend = previous ? previous.items.reduce((n, i) => n + yearSpend(i), 0) : 0;
---

<Base
  title="Worcester budget"
  description="Worcester's capital budget: what the city plans to build, repair and buy this year, by department and project."
  section="states"
>
  <WorcesterHeader
    current="budget"
    lede="What the city spends to run itself, where the money comes from, and what it plans to build."
  />

  {operating && (
    <section aria-labelledby="op-h">
      <h2 id="op-h">
        Operating budget, {fy(operating.fiscal_year)}
        {operating.stage === 'proposed' && <span class="pill status-pill">Proposed</span>}
      </h2>
      <p class="small muted section-note">
        Salaries, services, schools and running costs for a year (July {operating.fiscal_year - 1} to June{' '}
        {operating.fiscal_year})
        {operating.stage === 'proposed' ? ', as the City Manager proposed it to the council' : ', as adopted'}.
      </p>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Operating budget</dt>
          <dd>{formatMoney(opTotal)}</dd>
          {opPrev > 0 && (
            <p class="small muted stat-note">
              {opChange >= 0 ? '+' : '−'}
              {formatMoney(Math.abs(opChange))} ({budgetChange(opTotal, opPrev)}) on {columns.at(-2)}
            </p>
          )}
        </div>
        <div class="stat">
          <dt>Paid for by property tax</dt>
          <dd>{share(propertyTax, revenueTotal)}</dd>
          <p class="small muted stat-note">of {formatMoney(revenueTotal)} in revenue</p>
        </div>
      </dl>
      <div class="budget-charts">
        <section class="panel" aria-labelledby="rev-h">
          <h3 id="rev-h" class="h-small">
            Where the money comes from
          </h3>
          <BarList items={revenueBars} label={`Revenue by source, ${fy(operating.fiscal_year)}`} format={formatMoney} />
        </section>
        <section class="panel" aria-labelledby="spend-h">
          <h3 id="spend-h" class="h-small">
            Where it goes
          </h3>
          <BarList
            items={spendingBars}
            label={`Operating budget by department, ${fy(operating.fiscal_year)}`}
            tone="fill-sky"
            format={formatMoney}
          />
          <p class="small muted">Change on {columns.at(-2)}.</p>
          <details class="all-depts">
            <summary>All {spendingLines.length} lines</summary>
            <table class="dept-table">
              <thead>
                <tr>
                  <th scope="col">Line</th>
                  <th scope="col">{fy(operating.fiscal_year)}</th>
                  <th scope="col">Change</th>
                </tr>
              </thead>
              <tbody>
                {spendingLines.map((l) => (
                  <tr>
                    <th scope="row">
                      {l.label} <span class="muted small">· {l.grp}</span>
                    </th>
                    <td>{formatMoney(l.now)}</td>
                    <td>{budgetChange(l.now, l.before)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
        </section>
      </div>
      <p class="small muted">
        From the revenue and expenditure summary of{' '}
        <a href={operating.source_url} rel="noopener">
          {operating.title}
        </a>
        ; every group adds up to its printed total.
      </p>
    </section>
  )}

  {!current ? (
    <p class="muted">The capital budget hasn’t loaded yet.</p>
  ) : (
    <>
      <h2 id="cap-h">
        Capital budget, {fy(current.doc.fiscal_year)}
        {current.doc.stage === 'proposed' && <span class="pill status-pill">Proposed</span>}
      </h2>
      <p class="small muted section-note">
        {current.doc.stage === 'proposed'
          ? `The City Manager’s proposal for July ${current.doc.fiscal_year - 1} to June ${current.doc.fiscal_year}; the City Council votes on it, and the adopted budget replaces it here.`
          : `As adopted for July ${current.doc.fiscal_year - 1} to June ${current.doc.fiscal_year}.`}{' '}
        Borrowing is paid back over years from the operating budget; “new borrowing approved” is the loan authority the
        council grants this year.
      </p>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Borrowing and cash this year</dt>
          <dd>{formatMoney(thisYear)}</dd>
          {previous && prevSpend > 0 && (
            <p class="small muted stat-note">
              {formatMoney(prevSpend)} in {label(previous)}
            </p>
          )}
        </div>
        <div class="stat">
          <dt>Projects</dt>
          <dd>{items.length}</dd>
          <p class="small muted stat-note">in {departments.length} departments</p>
        </div>
        <div class="stat">
          <dt>New borrowing approved</dt>
          <dd>{formatMoney(newAuth)}</dd>
        </div>
      </dl>

      <div class="budget-charts">
        <section class="panel" aria-labelledby="dept-h">
          <h3 id="dept-h" class="h-small">
            Where it goes this year
          </h3>
          <BarList
            items={bars}
            label={`Capital spending by department, ${fy(current.doc.fiscal_year)}`}
            format={formatMoney}
          />
        </section>
        {plan.length > 0 && (
          <section class="panel" aria-labelledby="plan-h">
            <h3 id="plan-h" class="h-small">
              Five-year plan, {fy(plan[0]!.year)}–{fy(plan.at(-1)!.year)}
            </h3>
            <BarList
              items={plan.map((p) => ({ label: fy(p.year), value: p.amount }))}
              label="Capital plan by year, all departments"
              tone="fill-sky"
              format={formatMoney}
            />
            <p class="small muted">As printed in the plan, before state and other credits.</p>
          </section>
        )}
      </div>

      <section aria-labelledby="projects-h">
        <h2 id="projects-h">Projects</h2>
        <WorcesterCapital client:visible budgets={budgets.map((b) => ({ label: label(b), items: b.items }))} />
      </section>

      <p class="small muted tab-note">
        From the city’s budget documents on{' '}
        {budgets.map((b, i) => (
          <>
            {i > 0 && ' and '}
            <a href={b.doc.source_url} rel="noopener">
              {b.doc.title}
            </a>
          </>
        ))}{' '}
        (Worcester open data), read from the published PDF; every department’s projects add up to its printed sub-total.
      </p>
    </>
  )}
</Base>

<style>
  .budget-charts {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-4);
  }
  @media (min-width: 50rem) {
    .budget-charts {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .all-depts summary {
    cursor: pointer;
    color: var(--link);
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .dept-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .dept-table th,
  .dept-table td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .dept-table th[scope='row'],
  .dept-table thead th:first-child {
    text-align: left;
    font-weight: 500;
  }
  .status-pill {
    margin-left: var(--space-2);
    font-size: var(--step--1);
    vertical-align: middle;
  }
  .section-note {
    max-width: 70ch;
  }
</style>
