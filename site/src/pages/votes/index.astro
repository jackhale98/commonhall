---
import VoteExplorer from '../../components/VoteExplorer';
import StackedBar from '../../components/viz/StackedBar';
import Base from '../../layouts/Base.astro';
import { CURRENT_CONGRESS, loadVotesAbout } from '../../lib/build-data';
import { congressLabel } from '../../lib/format';
import { passed, voteRow } from '../../lib/votes';

const votes = await loadVotesAbout();
const congress = congressLabel(CURRENT_CONGRESS);
const chambers = (['house', 'senate'] as const).map((chamber) => {
  const list = votes.filter((v) => v.chamber === chamber);
  const yes = list.filter((v) => passed(v.result)).length;
  return { chamber, label: chamber === 'house' ? 'House' : 'Senate', list, yes, no: list.length - yes };
});
// The latest ten, prerendered; the explorer loads the rest (votes.json).
const initial = votes.slice(0, 10).map(voteRow);
---

<Base title="Votes" description={`Every roll-call vote in the House and Senate in the ${congress}.`} section="votes">
  <header class="page-head wash">
    <p class="kicker">{congress}</p>
    <h1>Roll-call votes</h1>
    <p class="lede">Every recorded vote in the House and Senate, and exactly how each member voted.</p>
  </header>

  <dl class="stat-grid">
    {chambers.map((c) => (
      <div class="stat">
        <dt>{c.label} roll calls</dt>
        <dd>{c.list.length.toLocaleString()}</dd>
        <StackedBar
          size="sm"
          segments={[
            { label: 'Passed or agreed', value: c.yes, tone: 'fill-yea' },
            { label: 'Failed or rejected', value: c.no, tone: 'fill-nay' },
          ]}
          legend
        />
      </div>
    ))}
  </dl>

  <section aria-labelledby="all-h">
    <div class="section-head">
      <h2 id="all-h">Every roll call</h2>
    </div>
    <VoteExplorer client:load initial={initial} />
  </section>
</Base>

<style>
  .stat-grid {
    margin-top: var(--space-5);
  }
  .stat .stacked {
    margin-top: var(--space-2);
  }
</style>
