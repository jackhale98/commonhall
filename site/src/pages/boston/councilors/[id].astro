---
import FollowButton from '../../../components/FollowButton';
import LocalMatters from '../../../components/LocalMatters';
import MemberPhoto from '../../../components/MemberPhoto';
import DistrictMap from '../../../components/viz/DistrictMap';
import Base from '../../../layouts/Base.astro';
import { loadCouncilDistricts, loadLocalOfficials, loadSponsoredMatters } from '../../../lib/build-data';
import { DEMO } from '../../../lib/config';
import { HIDDEN_MATTER_TYPES } from '../../../lib/local';
import { href, localOfficialHref } from '../../../lib/paths';
import type { LocalOfficial } from '../../../lib/types';

export async function getStaticPaths() {
  const officials = await loadLocalOfficials();
  return officials.map((official) => ({ params: { id: String(official.person_id) }, props: { official } }));
}

interface Props {
  official: LocalOfficial;
}

const { official } = Astro.props;
const [sponsored, districts, officials] = await Promise.all([
  loadSponsoredMatters(official.id),
  loadCouncilDistricts(),
  loadLocalOfficials(),
]);
const features = districts.map((d) => {
  const o = officials.find((x) => x.district === d.district);
  return {
    district: d.district,
    geojson: d.geojson,
    href: o ? localOfficialHref(o.id) : undefined,
    title: `District ${d.district}${o ? `: ${o.name}` : ''}`,
  };
});
// The default list leaves out consent-agenda resolutions (congratulations and commendations).
const substantive = sponsored.filter((m) => !HIDDEN_MATTER_TYPES.includes(m.type ?? ''));
const consent = sponsored.length - substantive.length;
const passed = substantive.filter((m) => m.passed_date || /adopted|passed/i.test(m.status ?? '')).length;
const count = (list: typeof sponsored, key: 'type' | 'status') =>
  [
    ...Map.groupBy(
      list.filter((m) => m[key]),
      (m) => m[key]!,
    ),
  ]
    .map(([value, rows]) => ({ value, count: rows.length }))
    .sort((a, b) => b.count - a.count);
const facets = { types: count(sponsored, 'type'), statuses: count(substantive, 'status'), sponsors: [] };
const seat = official.seat ?? 'Councilor';
---

<Base
  title={official.name}
  description={`${official.name}, Boston City Council (${seat}): sponsored ordinances, resolutions and orders.`}
  section="states"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('states/')}>States</a> › <a href={href('states/ma/')}>Massachusetts</a> ›{' '}
    <a href={href('boston/')}>Boston</a> › {official.name}
  </nav>
  <header class="councilor">
    <MemberPhoto name={official.name} url={official.photo_url} size={96} />
    <div>
      <h1>{official.name}</h1>
      <p class="muted">Boston City Council · {seat}</p>
      <div class="cluster">
        <FollowButton client:load targetType="local_official" targetId={official.id} label={official.name} />
        {official.email && (
          <a class="button" href={`mailto:${official.email}`}>
            Email
          </a>
        )}
      </div>
    </div>
  </header>

  <div class="councilor-glance">
    <dl class="stat-grid">
      <div class="stat">
        <dt>Ordinances, orders and resolutions</dt>
        <dd>{substantive.length}</dd>
      </div>
      <div class="stat">
        <dt>Passed or adopted</dt>
        <dd>{passed}</dd>
      </div>
      <div class="stat">
        <dt>Consent-agenda resolutions</dt>
        <dd>{consent}</dd>
      </div>
    </dl>
    {features.length > 0 && (
      <div class="panel">
        <DistrictMap
          features={features}
          highlight={official.district}
          width={320}
          label={
            official.district
              ? `Boston council districts, District ${official.district} outlined`
              : 'Boston council districts; at-large councilors represent the whole city'
          }
        />
        <p class="small muted">
          {official.district ? `Represents District ${official.district}.` : 'Represents the whole city (at-large).'}
        </p>
      </div>
    )}
  </div>

  <section aria-labelledby="sp-h">
    <h2 id="sp-h">Sponsored</h2>
    {sponsored.length === 0 ? (
      <p class="muted">No sponsored matters loaded.</p>
    ) : (
      <div class="panel">
        <LocalMatters
          client:visible
          initial={substantive.slice(0, 10)}
          total={substantive.length}
          local={DEMO}
          sponsor={official.id}
          facets={facets}
        />
      </div>
    )}
  </section>
  <p class="small muted">
    Boston records roll-call votes in meeting minutes rather than in Legistar, so votes are not listed here.
  </p>
</Base>

<style>
  .councilor-glance {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }
  @media (min-width: 50rem) {
    .councilor-glance {
      grid-template-columns: 1fr 22rem;
    }
  }
  .councilor {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-5);
  }
  .councilor h1 {
    margin: 0;
  }
</style>
