---
import DiscussionLink from '../../../components/DiscussionLink.astro';
import LocalMatterView from '../../../components/LocalMatterView';
import Base from '../../../layouts/Base.astro';
import {
  loadDiscussionsByTarget,
  loadLocalOfficials,
  loadPrerenderLocalMatters,
  type LocalSponsorship,
} from '../../../lib/build-data';
import { DEMO } from '../../../lib/config';
import { href } from '../../../lib/paths';
import type { LocalMatter, LocalMatterAction } from '../../../lib/types';

export async function getStaticPaths() {
  const matters = await loadPrerenderLocalMatters();
  return matters.map((data) => ({ params: { id: String(data.matter.matter_id) }, props: data }));
}

interface Props {
  matter: LocalMatter;
  actions: LocalMatterAction[];
  sponsors: LocalSponsorship[];
}

const { matter, actions, sponsors } = Astro.props;
const officialIds = (await loadLocalOfficials()).map((o) => o.id);
const discussion = (await loadDiscussionsByTarget()).get(`local_matter:${matter.id}`);
const label = matter.file_number ? `Docket #${matter.file_number}` : `Matter ${matter.matter_id}`;
const description = `Boston City Council ${label}: ${matter.title}`.slice(0, 300);
---

<Base title={`${label}: ${matter.title.slice(0, 80)}`} description={description} section="boston">
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('boston/')}>Boston</a> › {label}
  </nav>
  <DiscussionLink discussion={discussion} targetType="local_matter" targetId={matter.id} />
  <LocalMatterView
    client:load
    matter={matter}
    actions={actions}
    sponsors={sponsors}
    officialIds={officialIds}
    live={!DEMO}
  />
</Base>
