---
import BostonHeader from '../../../components/BostonHeader.astro';
import CouncilorFinder from '../../../components/CouncilorFinder';
import FindMyReps from '../../../components/FindMyReps';
import LocalMatters from '../../../components/LocalMatters';
import LocalMeetingRow from '../../../components/LocalMeetingRow.astro';
import DistrictMap from '../../../components/viz/DistrictMap';
import Base from '../../../layouts/Base.astro';
import {
  loadCouncilDistricts,
  loadLocalMatterFacets,
  loadLocalMeetings,
  loadLocalOfficials,
  loadRecentLocalMatters,
} from '../../../lib/build-data';
import { DEMO } from '../../../lib/config';
import { localOfficialHref } from '../../../lib/paths';

const [officials, matters, meetings, matterFacets, districts] = await Promise.all([
  loadLocalOfficials(),
  loadRecentLocalMatters(),
  loadLocalMeetings(),
  loadLocalMatterFacets(),
  loadCouncilDistricts(),
]);
const features = districts.map((d) => {
  const o = officials.find((x) => x.district === d.district);
  return {
    district: d.district,
    geojson: d.geojson,
    href: o ? localOfficialHref(o.id) : undefined,
    title: `District ${d.district}${o ? `: ${o.name}` : ''}`,
  };
});
const byDistrict = officials.filter((o) => o.district !== null).sort((a, b) => a.district! - b.district!);
const atLarge = officials.filter((o) => o.district === null).sort((a, b) => a.name.localeCompare(b.name));
const today = new Date().toISOString().slice(0, 10);
const upcoming = meetings.filter((m) => m.date >= today).reverse();
const recent = meetings.filter((m) => m.date < today);
const FIRST = 5;
---

<Base
  title="Boston City Council"
  description="Boston City Council ordinances, orders, hearing orders and resolutions, and its meetings."
  section="states"
>
  <BostonHeader current="council" />

  <section aria-labelledby="council-h">
    <div class="section-head">
      <h2 id="council-h">Your councilors</h2>
    </div>
    {officials.length === 0 && <p class="muted">Not loaded yet.</p>}
    <div class="council-layout">
      <div class="panel">
        <CouncilorFinder
          client:visible
          councilors={[...byDistrict, ...atLarge].map((o) => ({
            id: o.id,
            name: o.name,
            seat: o.seat,
            district: o.district,
            photo_url: o.photo_url,
          }))}
        />
        {!DEMO && (
          <details class="by-address">
            <summary>Find your district by address</summary>
            <FindMyReps client:visible />
          </details>
        )}
      </div>
      {features.length > 0 && (
        <details class="panel map-panel" id="district-map">
          <summary class="h-small">District map</summary>
          <DistrictMap features={features} label="Boston City Council districts; select one for its councilor" />
        </details>
      )}
    </div>
  </section>

  <section aria-labelledby="matters-h">
    <h2 id="matters-h">Ordinances, orders and resolutions</h2>
    <div class="panel">
      <LocalMatters
        client:visible
        initial={matters}
        local={DEMO}
        total={matterFacets.total}
        facets={{
          ...matterFacets,
          sponsors: [...officials]
            .sort((a, b) => a.name.localeCompare(b.name))
            .map((o) => ({ id: o.id, name: o.name })),
        }}
      />
    </div>
  </section>

  <section aria-labelledby="meetings-h">
    <h2 id="meetings-h">Meetings</h2>
    {upcoming.length > 0 && (
      <>
        <h3 class="h-small">Coming up</h3>
        <div class="panel">
          <ul class="list">
            {upcoming.map((m) => (
              <LocalMeetingRow meeting={m} upcoming />
            ))}
          </ul>
        </div>
      </>
    )}
    <h3 class="h-small">Recent</h3>
    {recent.length === 0 && <p class="muted">None loaded yet.</p>}
    <div class="panel">
      <ul class="list">
        {recent.slice(0, FIRST).map((m) => (
          <LocalMeetingRow meeting={m} />
        ))}
      </ul>
      {recent.length > FIRST && (
        <details class="more-meetings">
          <summary>{recent.length - FIRST} earlier meetings</summary>
          <ul class="list">
            {recent.slice(FIRST).map((m) => (
              <LocalMeetingRow meeting={m} />
            ))}
          </ul>
        </details>
      )}
    </div>
  </section>

  <p class="small muted">
    From the City of Boston’s <a href="https://boston.legistar.com/">Legistar</a>, refreshed every 15 minutes.
    Consent-agenda resolutions (mostly congratulations and commendations) are hidden unless you include them.
  </p>
</Base>

<style>
  .council-layout {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 60rem) {
    .council-layout {
      grid-template-columns: 1.3fr 1fr;
      align-items: start;
    }
  }
  .map-panel summary,
  .by-address summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  /* A chevron marks these as boxes that open (the flex layout hides the browser's own). */
  .map-panel > summary::before,
  .by-address > summary::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline: 0.15rem 0.1rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }
  .map-panel[open] > summary::before,
  .by-address[open] > summary::before {
    transform: rotate(45deg);
  }
  .map-panel > summary::-webkit-details-marker,
  .by-address > summary::-webkit-details-marker {
    display: none;
  }
  .by-address {
    margin-top: var(--space-3);
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
  }
  .by-address summary {
    color: var(--link);
    font-weight: 600;
  }
  .more-meetings summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
  }
</style>
