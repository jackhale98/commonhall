---
import BostonHeader from '../../components/BostonHeader.astro';
import LiveDiscussions from '../../components/LiveDiscussions';
import LocalMatterItem from '../../components/LocalMatterItem';
import LocalMeetingRow from '../../components/LocalMeetingRow.astro';
import Base from '../../layouts/Base.astro';
import {
  loadCapitalProjects,
  loadCityBudget,
  loadBoston311,
  loadDiscussions,
  loadLocalMeetings,
  loadRecentLocalMatters,
  loadZbaAppeals,
} from '../../lib/build-data';
import { formatMoney } from '../../lib/finance';
import { formatDate } from '../../lib/format';
import { CAPITAL_STAGES, capitalStage, change311, closeTime, spentLabel, streetAddress } from '../../lib/local';
import { capitalProjectHref, href } from '../../lib/paths';

const [matters, meetings, discussions, appeals, report, projects, operating] = await Promise.all([
  loadRecentLocalMatters(),
  loadLocalMeetings(),
  loadDiscussions(),
  loadZbaAppeals(),
  loadBoston311(),
  loadCapitalProjects(),
  loadCityBudget(),
]);
const today = new Date().toISOString().slice(0, 10);
const upcoming = meetings
  .filter((m) => m.date >= today)
  .reverse()
  .slice(0, 2);
const recent = meetings.filter((m) => m.date < today).slice(0, upcoming.length > 0 ? 1 : 2);
// Capital Plan at a glance: the whole plan, its first year, and where that year's money goes.
const planTotal = projects.reduce((n, p) => n + p.total_budget, 0);
const planLabel = projects[0]?.plan.replace('-', '–') ?? '';
const planFy = projects[0]?.first_year ? `FY${String(projects[0].first_year).slice(2)}` : 'the first year';
const building = projects.filter((p) => capitalStage(p.status) === 3).length;
const biggestThisYear = [...projects].sort((a, b) => b.year1 - a.year1).slice(0, 3);
const hearings = appeals
  .filter((z) => z.hearing_date && z.hearing_date >= today)
  .sort((a, b) => a.hearing_date!.localeCompare(b.hearing_date!))
  .slice(0, 3);
const bostonDiscussions = discussions.filter((d) => d.jurisdiction === 'boston' && d.status === 'open');
---

<Base
  title="Boston"
  description="Boston city government: the City Council, your councilor, meetings and what the council is working on."
  section="states"
>
  <BostonHeader
    current="overview"
    lede="Thirteen city councilors: one for each of nine districts and four elected citywide."
  />

  <p class="councilor-link">
    <a href={href('boston/council/#council-h')}>Find your councilor and see the district map →</a>
  </p>

  <section aria-labelledby="meet-h">
    <div class="section-head">
      <h2 id="meet-h">Council meetings</h2>
      <a class="see-all" href={href('boston/council/#meetings-h')}>
        All meetings
      </a>
    </div>
    {upcoming.length + recent.length === 0 && <p class="muted">None loaded yet.</p>}
    <div class="panel">
      <ul class="list">
        {upcoming.map((m) => (
          <LocalMeetingRow meeting={m} upcoming />
        ))}
        {recent.map((m) => (
          <LocalMeetingRow meeting={m} />
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="latest-h">
    <div class="section-head">
      <h2 id="latest-h">Latest from the council</h2>
      <a class="see-all" href={href('boston/council/')}>
        All ordinances and orders
      </a>
    </div>
    <div class="panel">
      <ul class="list phone-two">
        {matters.slice(0, 3).map((m) => (
          <LocalMatterItem matter={m} />
        ))}
      </ul>
    </div>
  </section>

  {report && (
    <section aria-labelledby="h311">
      <div class="section-head">
        <h2 id="h311">311 in the last 30 days</h2>
        <a class="see-all" href={href('boston/neighborhoods/')}>
          By district
        </a>
      </div>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Requests</dt>
          <dd>{report.city.opened.toLocaleString()}</dd>
          {change311(report.city) && <p class="small muted stat-note">{change311(report.city)} prior 30 days</p>}
        </div>
        <div class="stat">
          <dt>Closed on time</dt>
          <dd>{report.city.closed ? `${Math.round((report.city.closedOnTime / report.city.closed) * 100)}%` : '—'}</dd>
          {report.city.typicalHours !== null && (
            <p class="small muted stat-note">typically in {closeTime(report.city.typicalHours)}</p>
          )}
        </div>
      </dl>
      <p class="small muted top-requests">
        Most asked for:{' '}
        {report.city.top
          .slice(0, 3)
          .map((t) => t.type.toLowerCase())
          .join(', ')}
        .
      </p>
    </section>
  )}

  {projects.length > 0 && (
    <section aria-labelledby="budget-h">
      <div class="section-head">
        <h2 id="budget-h">The city’s budget</h2>
        <a class="see-all" href={href('boston/budget/')}>
          Budget
        </a>
      </div>
      <dl class="stat-grid">
        {operating && (
          <div class="stat">
            <dt>Operating budget, FY{String(operating.year).slice(2)}</dt>
            <dd>{formatMoney(operating.total)}</dd>
            <p class="small muted stat-note">to run the city for a year</p>
          </div>
        )}
        <div class="stat">
          <dt>Adopted {planLabel} Capital Plan</dt>
          <dd>{formatMoney(planTotal)}</dd>
          <p class="small muted stat-note">
            {projects.length} projects, {building} under construction or underway
          </p>
        </div>
      </dl>
      <div class="panel budget-top">
        <h3 class="h-small">Biggest capital projects in {planFy}</h3>
        <ul class="list phone-two">
          {biggestThisYear.map((p) => (
            <li>
              <p class="meta">{[p.department, p.neighborhood].filter(Boolean).join(' · ')}</p>
              <p class="hearing-addr">
                <a href={capitalProjectHref(p.proj_id)}>
                  <strong>{p.name}</strong>
                </a>
              </p>
              {p.status && (
                <p class="small hearing-addr">
                  {capitalStage(p.status) !== null && (
                    <span class="stage-dots" aria-hidden="true">
                      {CAPITAL_STAGES.map((_, i) => (
                        <span class={i <= capitalStage(p.status)! ? 'on' : ''} />
                      ))}
                    </span>
                  )}
                  {p.status}
                </p>
              )}
              <div class="funding-bar compact" aria-hidden="true">
                {p.spent > 0 && <span class="fund-1" style={{ flex: `${p.spent} 1 0` }} />}
                <span class="fund-rest" style={{ flex: `${Math.max(0, p.total_budget - p.spent)} 1 0` }} />
              </div>
              <p class="small muted hearing-addr">
                {formatMoney(p.year1)} in {planFy} · {formatMoney(p.spent)} {spentLabel(p.first_year)} of{' '}
                {formatMoney(p.total_budget)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {hearings.length > 0 && (
    <section aria-labelledby="zoning-h">
      <div class="section-head">
        <h2 id="zoning-h">Upcoming zoning hearings</h2>
        <a class="see-all" href={href('boston/neighborhoods/')}>
          All hearings
        </a>
      </div>
      <div class="panel">
        <ul class="list hearings phone-two">
          {hearings.map((z) => (
            <li>
              <p class="meta">{[formatDate(z.hearing_date), z.neighborhood].filter(Boolean).join(' · ')}</p>
              <p class="hearing-addr">
                <strong>{streetAddress(z.address, z.neighborhood) ?? z.boa_apno}</strong>
              </p>
              {z.description && <p class="small hearing-desc">{z.description}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section aria-labelledby="disc-h">
    <h2 id="disc-h">Have your say on Boston</h2>
    <LiveDiscussions
      client:idle
      initial={bostonDiscussions}
      jurisdictions={['boston']}
      empty="No Boston discussion is open right now. Ask for one from any council matter’s page."
    />
  </section>

  <p class="small muted">
    Council data from the City of Boston’s <a href="https://boston.legistar.com/">Legistar</a>, refreshed every 15
    minutes.
  </p>
</Base>

<script>
  // The district map starts open on wide screens and folded on phones.
  const map = document.getElementById('district-map');
  if (map && window.matchMedia('(min-width: 60rem)').matches) map.setAttribute('open', '');
</script>

<style>
  .councilor-link {
    margin: 0 0 var(--space-4);
    font-weight: 600;
  }
  /* Phones show two of the three latest matters and hearings. */
  @media (max-width: 40rem) {
    .phone-two > :global(li:nth-child(n + 3)) {
      display: none;
    }
    .phone-two > :global(li:nth-child(2)) {
      border-bottom: 0;
      padding-bottom: 0;
    }
  }
  .budget-top {
    margin-top: var(--space-3);
  }
  .budget-top .h-small {
    margin: 0;
  }
  .budget-top .meta {
    margin: 0;
  }
  .top-requests {
    margin-top: var(--space-2);
  }
  .hearings .meta,
  .hearing-addr,
  .hearing-desc {
    margin: 0;
  }
  .hearing-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
