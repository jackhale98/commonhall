---
import CapitalStages from '../../../components/CapitalStages.astro';
import DiscussionLink from '../../../components/DiscussionLink.astro';
import FundingBar from '../../../components/viz/FundingBar.astro';
import Base from '../../../layouts/Base.astro';
import { loadCapitalProjects, loadDiscussionsByTarget } from '../../../lib/build-data';
import { formatMoney } from '../../../lib/finance';
import { fundingSegments, spentLabel, type CapitalProject } from '../../../lib/local';
import { href } from '../../../lib/paths';

export async function getStaticPaths() {
  return (await loadCapitalProjects()).map((p) => ({ params: { id: p.proj_id }, props: { p } }));
}

interface Props {
  p: CapitalProject;
}

const { p } = Astro.props;
const discussion = (await loadDiscussionsByTarget()).get(`capital_project:${p.proj_id}`);
const plan = p.plan.replace('-', '–');
const segments = fundingSegments(p);
const spentPct = p.total_budget > 0 ? Math.round((p.spent / p.total_budget) * 100) : 0;
---

<Base
  title={`${p.name} (Boston capital project)`}
  description={`${p.name}: ${p.department ?? 'City of Boston'} capital project${p.neighborhood ? ` in ${p.neighborhood}` : ''}, ${formatMoney(p.total_budget)} in the ${plan} Capital Plan.`}
  section="states"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('boston/')}>Boston</a> › <a href={href('boston/budget/')}>Budget</a> › {p.name}
  </nav>
  <header class="page-head">
    <p class="kicker">{[p.department, p.neighborhood].filter(Boolean).join(' · ')}</p>
    <h1>{p.name}</h1>
    {p.scope && <p class="lede scope">{p.scope}</p>}
  </header>

  <DiscussionLink discussion={discussion} targetType="capital_project" targetId={p.proj_id} />

  <div class="project-grid">
    <section class="panel" aria-labelledby="stage-h">
      <h2 id="stage-h" class="h-small">
        Where it stands
      </h2>
      <CapitalStages status={p.status} />
    </section>

    <section class="panel" aria-labelledby="money-h">
      <h2 id="money-h" class="h-small">
        Money
      </h2>
      <p class="money-head">
        <span class="money-big">{formatMoney(p.spent)}</span>
        <span class="muted">
          {spentLabel(p.first_year)}, of a <strong>{formatMoney(p.total_budget)}</strong> total budget
          {p.total_budget > 0 && ` (${spentPct < 1 && p.spent > 0 ? '<1' : spentPct}%)`}
        </span>
      </p>
      <FundingBar
        segments={segments}
        total={p.total_budget}
        label={`${p.name}: ${formatMoney(p.spent)} ${spentLabel(p.first_year)} of a ${formatMoney(p.total_budget)} total budget`}
      />
    </section>
  </div>

  <p class="small muted">
    From the City of Boston’s <a href="https://data.boston.gov/dataset/capital-budget">{plan} Capital Plan</a> on
    Analyze Boston (project {p.proj_id}). The total budget covers the whole project, including years before this plan
    and outside grants. Amounts are as the city published them. <a href={href('boston/budget/')}>All projects</a>.
  </p>
</Base>

<style>
  .scope {
    max-width: 65ch;
  }
  .project-grid {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0;
  }
  @media (min-width: 60rem) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .money-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }
  .money-big {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
</style>
