---
import BostonHeader from '../../../components/BostonHeader.astro';
import CapitalExplorer from '../../../components/CapitalExplorer';
import BarList from '../../../components/viz/BarList';
import Base from '../../../layouts/Base.astro';
import { loadCapitalProjects, loadCityBudget } from '../../../lib/build-data';
import { formatMoney } from '../../../lib/finance';
import { budgetChange, capitalRow, capitalStage, spentLabel } from '../../../lib/local';

const [projects, operating] = await Promise.all([loadCapitalProjects(), loadCityBudget()]);
const fy = (y: number) => `FY${String(y).slice(2)}`;
// The largest parts of a list, the rest folded into one bar.
const topBars = (items: { label: string; value: number; note?: string }[], top: number, restLabel: string) => {
  const rest = items.slice(top);
  return rest.length
    ? [
        ...items.slice(0, top),
        { label: restLabel, value: rest.reduce((n, r) => n + r.value, 0), note: `(${rest.length} more)` },
      ]
    : items;
};
const opChange = operating ? operating.total - operating.prevTotal : 0;
// What links the two budgets: the operating budget's payments on the bonds that fund capital projects.
const debtService = operating?.departments.find((d) => /^debt service$/i.test(d.label))?.value ?? 0;
const share = (v: number, of: number) => (of > 0 ? `${Math.round((v / of) * 100)}%` : '');
const revenueBars = operating
  ? topBars(
      operating.revenue.map((r) => ({ ...r, note: share(r.value, operating.revenueTotal) })),
      5,
      'Everything else',
    )
  : [];
const departmentBars = operating
  ? topBars(
      operating.departments.map((d) => ({ label: d.label, value: d.value, note: budgetChange(d.value, d.prev) })),
      8,
      'Every other department',
    )
  : [];
const plan = projects[0]?.plan ?? 'Capital Plan';
const firstYear = projects[0]?.first_year;
const yearLabel = firstYear ? `FY${String(firstYear).slice(2)}` : 'the first year';
const sum = (list: typeof projects, key: 'total_budget' | 'year1' | 'spent') =>
  list.reduce((n, p) => n + Number(p[key]), 0);
const total = sum(projects, 'total_budget');
const thisYear = sum(projects, 'year1');
const inConstruction = projects.filter((p) => capitalStage(p.status) === 3).length;

// Totals by a column, largest first; the long tail folds into "Other".
const totalsBy = (key: 'department' | 'neighborhood', top = 8) => {
  const all = [...Map.groupBy(projects, (p) => p[key] ?? 'Not given')]
    .map(([label, list]) => ({ label, value: sum(list, 'total_budget'), note: `(${list.length})` }))
    .sort((a, b) => b.value - a.value);
  const rest = all.slice(top);
  return rest.length
    ? [
        ...all.slice(0, top),
        { label: 'Everything else', value: rest.reduce((n, r) => n + r.value, 0), note: `(${rest.length} more)` },
      ]
    : all;
};
const byDepartment = totalsBy('department');
const byNeighborhood = totalsBy('neighborhood');
const distinct = (key: 'department' | 'neighborhood' | 'status') =>
  [...new Set(projects.map((p) => p[key]).filter((v): v is string => !!v))].sort();
const shortPlan = plan.replace('-', '–');
---

<Base
  title="Boston budget"
  description={`Boston’s city budget: what it spends to run departments, where the money comes from, and the ${shortPlan} Capital Plan for what it builds.`}
  section="states"
>
  <BostonHeader
    current="budget"
    lede="What the city spends to run itself, where the money comes from, and what it plans to build."
  />

  {operating && (
    <section aria-labelledby="op-h">
      <h2 id="op-h">Operating budget, {fy(operating.year)}</h2>
      <p class="small muted section-note">
        Salaries, services and running costs for a year (July {operating.year - 1} to June {operating.year}), as adopted
        by the City Council.
      </p>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Operating budget</dt>
          <dd>{formatMoney(operating.total)}</dd>
          {operating.prevTotal > 0 && (
            <p class="small muted stat-note">
              {opChange >= 0 ? '+' : '−'}
              {formatMoney(Math.abs(opChange))} ({budgetChange(operating.total, operating.prevTotal)}) on{' '}
              {fy(operating.prevYear)}
            </p>
          )}
        </div>
        <div class="stat">
          <dt>Paid for by property tax</dt>
          <dd>
            {share(operating.revenue.find((r) => /property tax/i.test(r.label))?.value ?? 0, operating.revenueTotal)}
          </dd>
          <p class="small muted stat-note">of {formatMoney(operating.revenueTotal)} in revenue</p>
        </div>
      </dl>
      <div class="budget-charts">
        <section class="panel" aria-labelledby="rev-h">
          <h3 id="rev-h" class="h-small">
            Where the money comes from
          </h3>
          <BarList items={revenueBars} label={`Revenue by source, ${fy(operating.year)}`} format={formatMoney} />
        </section>
        <section class="panel" aria-labelledby="spend-h">
          <h3 id="spend-h" class="h-small">
            Where it goes
          </h3>
          <BarList
            items={departmentBars}
            label={`Operating budget by department, ${fy(operating.year)}`}
            tone="fill-sky"
            format={formatMoney}
          />
          <p class="small muted">Change on {fy(operating.prevYear)} as appropriated.</p>
          <details class="all-depts">
            <summary>All {operating.departments.length} departments</summary>
            <table class="dept-table">
              <thead>
                <tr>
                  <th scope="col">Department</th>
                  <th scope="col">{fy(operating.year)}</th>
                  <th scope="col">Change</th>
                </tr>
              </thead>
              <tbody>
                {operating.departments.map((d) => (
                  <tr>
                    <th scope="row">{d.label}</th>
                    <td>{formatMoney(d.value)}</td>
                    <td>{budgetChange(d.value, d.prev)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
        </section>
      </div>
    </section>
  )}

  {operating && projects.length > 0 && (
    <aside class="panel two-budgets" aria-labelledby="two-h">
      <h2 id="two-h" class="h-small">
        Two budgets, paid for differently
      </h2>
      <p>
        The <strong>operating budget</strong> is one year: {formatMoney(operating.revenueTotal)} comes in and{' '}
        {formatMoney(operating.total)} is planned to go out, so it balances. The <strong>Capital Plan</strong> adds up
        whole projects over many years, including money already spent, and is paid for mostly with borrowing (city
        bonds) and grants, not with one year’s revenue. It is not extra money left over.
      </p>
      {debtService > 0 && (
        <p>
          The two meet in the operating budget’s debt service: {formatMoney(debtService)} in {fy(operating.year)} to
          repay the bonds that pay for capital projects. The Capital Plan’s own spending planned for {yearLabel} is{' '}
          {formatMoney(thisYear)}.
        </p>
      )}
    </aside>
  )}

  <h2 id="cap-h">Capital Plan, {shortPlan}</h2>
  <p class="small muted section-note">
    What the city plans to build and repair over five years. Open a project to ask for a discussion on it.
  </p>

  {projects.length === 0 ? (
    <p class="muted">The Capital Plan has not loaded yet.</p>
  ) : (
    <>
      <dl class="stat-grid">
        <div class="stat">
          <dt>Total budget, all projects</dt>
          <dd>{formatMoney(total)}</dd>
        </div>
        <div class="stat">
          <dt>Planned spending, {yearLabel}</dt>
          <dd>{formatMoney(thisYear)}</dd>
        </div>
        <div class="stat">
          <dt>Projects</dt>
          <dd>{projects.length}</dd>
        </div>
        <div class="stat">
          <dt>Under construction or underway</dt>
          <dd>{inConstruction}</dd>
        </div>
      </dl>

      <details class="cap-charts" id="cap-charts">
        <summary class="h-small">Capital Plan by department and neighborhood</summary>
        <div class="budget-charts">
          <section class="panel" aria-labelledby="dept-h">
            <h3 id="dept-h" class="h-small">
              By department
            </h3>
            <BarList items={byDepartment} label="Capital Plan total by department" format={formatMoney} />
          </section>
          <section class="panel" aria-labelledby="hood-h">
            <h3 id="hood-h" class="h-small">
              By neighborhood
            </h3>
            <BarList
              items={byNeighborhood}
              label="Capital Plan total by neighborhood"
              tone="fill-sky"
              format={formatMoney}
            />
          </section>
        </div>
      </details>

      <section aria-labelledby="proj-h">
        <h3 id="proj-h">Projects</h3>
        <CapitalExplorer
          client:visible
          initial={projects.slice(0, 10).map(capitalRow)}
          departments={distinct('department')}
          neighborhoods={distinct('neighborhood')}
          statuses={distinct('status')}
          yearLabel={yearLabel}
          spentText={spentLabel(firstYear ?? null)}
        />
      </section>
    </>
  )}

  <p class="small muted">
    {operating && (
      <>
        Operating and revenue budgets from the City of Boston’s adopted
        <a href="https://data.boston.gov/dataset/operating-budget">operating budget</a> and
        <a href="https://data.boston.gov/dataset/revenue-budget">revenue budget</a> on Analyze Boston, checked weekly;
        more at <a href="https://budget.boston.gov/">budget.boston.gov</a>.{' '}
      </>
    )}
    Capital projects from the City of Boston’s adopted{' '}
    <a href="https://data.boston.gov/dataset/capital-budget">{shortPlan} Capital Plan</a>
    on Analyze Boston, checked weekly, with amounts as the city published them. A project’s total budget covers the
    whole project: money spent in earlier years, what is budgeted for each year of the plan, and outside grants. Added
    up, they give the plan’s total. The city’s announced figures come from its April
    <a href="https://www.boston.gov/departments/budget">recommended plan</a>, so they can differ slightly from the
    adopted plan here. “Planned spending, {yearLabel}” is the plan’s first year. Many projects are citywide or span
    several neighborhoods.
  </p>
</Base>

<script>
  // The Capital Plan charts start open on wide screens and folded on phones.
  const charts = document.getElementById('cap-charts');
  if (charts && window.matchMedia('(min-width: 60rem)').matches) charts.setAttribute('open', '');
</script>

<style>
  .cap-charts > summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    margin-bottom: var(--space-3);
  }
  .stat-grid {
    margin-bottom: var(--space-5);
  }
  .two-budgets {
    margin: var(--space-5) 0;
    border-left: 4px solid var(--brand);
  }
  .two-budgets .h-small {
    margin-top: 0;
  }
  .two-budgets p {
    max-width: 70ch;
  }
  .two-budgets p:last-child {
    margin-bottom: 0;
  }
  .section-note {
    margin-top: 0;
    max-width: 65ch;
  }
  .all-depts summary {
    cursor: pointer;
    color: var(--link);
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .dept-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .dept-table th,
  .dept-table td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .dept-table th[scope='row'],
  .dept-table thead th:first-child {
    text-align: left;
    font-weight: 500;
  }
  .budget-charts {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  @media (min-width: 60rem) {
    .budget-charts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .budget-charts .h-small {
    margin-top: 0;
  }
  :global(.capital-list p) {
    margin: 0;
  }
  :global(.capital-scope) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
