---
import { BOSTON_COMMITTEES, committeeSlug } from '@civic/congress-client/boston-committees';
import BostonHeader from '../../../components/BostonHeader.astro';
import HearingList from '../../../components/HearingList.astro';
import Base from '../../../layouts/Base.astro';
import { loadBostonHearings } from '../../../lib/build-data';
import { href } from '../../../lib/paths';

/** A page for each standing committee, and for any other committee a hearing names. */
export async function getStaticPaths() {
  const hearings = await loadBostonHearings();
  const names = [...new Set([...BOSTON_COMMITTEES, ...hearings.flatMap((h) => h.committees)])];
  return names.map((name) => ({ params: { slug: committeeSlug(name) }, props: { name } }));
}

interface Props {
  name: string;
}

const { name } = Astro.props;
const hearings = (await loadBostonHearings()).filter((h) => h.committees.includes(name));
const today = new Date().toISOString().slice(0, 10);
const upcoming = hearings.filter((h) => h.date >= today).reverse();
const past = hearings.filter((h) => h.date < today);
const FIRST = 10;
// Dockets this committee has heard, most recent hearing first, once each.
const dockets = [
  ...new Map(past.flatMap((h) => h.items.filter((i) => i.matter_id).map((i) => [i.matter_id!, i] as const))).values(),
];
---

<Base
  title={`${name} · Boston City Council`}
  description={`Hearings of the Boston City Council's ${name} committee and the dockets it takes up.`}
  section="states"
>
  <BostonHeader current="committees" />
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('boston/committees/')}>Committees</a> › {name}
  </nav>
  <h2 class="committee-title">{name}</h2>
  <p class="small muted">
    {hearings.length === 0
      ? 'No hearings on file.'
      : `${past.length} ${past.length === 1 ? 'hearing' : 'hearings'} on file${dockets.length ? ` on ${dockets.length} ${dockets.length === 1 ? 'docket' : 'dockets'}` : ''}${upcoming.length ? `, ${upcoming.length} coming up` : ''}.`}
  </p>

  {upcoming.length > 0 && (
    <section aria-labelledby="upcoming-h">
      <h3 id="upcoming-h">Upcoming hearings</h3>
      <div class="panel">
        <HearingList hearings={upcoming} committee={name} upcoming />
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section aria-labelledby="past-h">
      <h3 id="past-h">Past hearings</h3>
      <HearingList hearings={past.slice(0, FIRST)} committee={name} />
      {past.length > FIRST && (
        <details class="more-hearings">
          <summary>{past.length - FIRST} earlier hearings</summary>
          <HearingList hearings={past.slice(FIRST)} committee={name} />
        </details>
      )}
    </section>
  )}

  <p class="small muted">
    Hearings and agendas from{' '}
    <a href="https://boston.legistar.com/Calendar.aspx" rel="noopener">
      Boston’s Legistar
    </a>
    , checked every 15 minutes. Legistar doesn’t list committee members.
  </p>
</Base>

<style>
  .committee-title {
    font-size: var(--step-2);
    margin-top: var(--space-2);
  }
  .more-hearings summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
  }
</style>
