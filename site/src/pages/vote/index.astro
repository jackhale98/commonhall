---
import VoteView from '../../components/VoteView';
import Base from '../../layouts/Base.astro';
---

<Base title="Roll-call vote" section="bills" noindex>
  <noscript>
    <p class="notice">This page needs JavaScript.</p>
  </noscript>
  <VoteView client:load />
</Base>

<style is:global>
  .positions {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .plain-members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
</style>
