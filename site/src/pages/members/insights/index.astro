---
import Base from '../../../layouts/Base.astro';
import { CURRENT_CONGRESS, loadMemberFinance, loadMembers, loadPartyUnity } from '../../../lib/build-data';
import { formatMoney } from '../../../lib/finance';
import { congressLabel } from '../../../lib/format';
import {
  donorName,
  employerBoard,
  pacBoard,
  unityBoard,
  type DonorEntry,
  type UnityEntry,
} from '../../../lib/insights';
import { href, memberHref } from '../../../lib/paths';

const [members, unity, finance] = await Promise.all([loadMembers(), loadPartyUnity(), loadMemberFinance()]);
const chambers = (['house', 'senate'] as const).map((chamber) => ({
  chamber,
  label: chamber === 'house' ? 'House' : 'Senate',
  D: unityBoard(unity, members, chamber, 'D'),
  R: unityBoard(unity, members, chamber, 'R'),
}));
const current = [...members.values()].filter((m) => m.current);
const withFinance = [...finance.values()].filter((f) => members.get(f.member_id)?.current);
const pacs = pacBoard(withFinance, members, 10);
const employers = employerBoard(withFinance, members, 10);
const pct = (share: number) => `${(share * 100).toFixed(1)}%`;
const seat = (e: UnityEntry) =>
  e.state ? `${e.state}${e.district !== null && e.district > 0 ? `-${e.district}` : ''}` : '';
const split = (d: DonorEntry) => {
  const t = d.total || 1;
  return [
    { key: 'D', label: 'Democrats', value: d.byParty.D, share: d.byParty.D / t, tone: 'split-d' },
    { key: 'R', label: 'Republicans', value: d.byParty.R, share: d.byParty.R / t, tone: 'split-r' },
    { key: 'other', label: 'Independents', value: d.byParty.other, share: d.byParty.other / t, tone: 'split-o' },
  ].filter((p) => p.value > 0);
};
const splitText = (d: DonorEntry) =>
  split(d)
    .map((p) => `${p.label} ${Math.round(p.share * 100)}%`)
    .join(', ');
---

<Base
  title="Party unity and campaign money"
  description={`Which members of the ${congressLabel(CURRENT_CONGRESS)} vote with their party most and least often, and which PACs and employers' workers give the most to members, by party.`}
  section="members"
>
  <nav aria-label="Breadcrumb" class="small muted">
    <a href={href('members/')}>Members</a> › Party unity and campaign money
  </nav>
  <header class="page-head">
    <p class="kicker">{congressLabel(CURRENT_CONGRESS)}</p>
    <h1>Party unity and campaign money</h1>
    <p class="lede">Who votes with their party most and least often, and where members’ campaign money comes from.</p>
  </header>

  <section aria-labelledby="unity-h">
    <h2 id="unity-h">Party unity</h2>
    <p class="small muted section-note">
      On roll calls where most Democrats and most Republicans voted on opposite sides, the share of the time each member
      voted with their own party. Members who voted on fewer than half of those roll calls aren’t ranked; independents
      aren’t included.
    </p>
    {chambers.map((c) =>
      c.D.ranked + c.R.ranked === 0 ? null : (
        <section class="unity-chamber" aria-labelledby={`unity-${c.chamber}`}>
          <h3 id={`unity-${c.chamber}`} class="h-small">
            {c.label} <span class="muted">· {c.D.partyLineVotes.toLocaleString()} party-line roll calls</span>
          </h3>
          <div class="unity-grid">
            {(['D', 'R'] as const).map((party) => {
              const b = c[party];
              return (
                <div class="panel unity-panel">
                  <p class={`unity-party ${party === 'D' ? 'party-d' : 'party-r'}`}>
                    <strong>{party === 'D' ? 'Democrats' : 'Republicans'}</strong>
                    {b.median !== null && <span class="muted"> · typical member {pct(b.median)}</span>}
                  </p>
                  {[
                    { title: 'Most often with their party', list: b.most },
                    { title: 'Least often with their party', list: b.least },
                  ].map((group) => (
                    <>
                      <p class="small muted unity-label">{group.title}</p>
                      <ol class="unity-list">
                        {group.list.map((e) => (
                          <li>
                            <a href={memberHref(e.id)}>{e.name}</a>
                            <span class="small muted">{seat(e)}</span>
                            <span class="unity-pct" title={`${e.with} of ${e.of} party-line votes`}>
                              {pct(e.share)}
                            </span>
                          </li>
                        ))}
                      </ol>
                    </>
                  ))}
                </div>
              );
            })}
          </div>
        </section>
      ),
    )}
    {chambers.every((c) => c.D.ranked + c.R.ranked === 0) && <p class="muted">Votes have not loaded yet.</p>}
  </section>

  <section aria-labelledby="money-h">
    <h2 id="money-h">Campaign money</h2>
    <p class="small muted section-note">
      From the Federal Election Commission, for the {withFinance.length} of {current.length} members whose campaign
      reports have loaded so far. Each member’s report lists their 10 largest PAC contributors and the 10 employers
      whose workers gave the most; totals here add those up across members, so they are a floor, not everything a PAC
      gave. Employer totals are money from people who work there, not from the company.
    </p>
    <p class="split-legend small" aria-hidden="true">
      <span>
        <span class="swatch split-d"></span>To Democrats
      </span>
      <span>
        <span class="swatch split-r"></span>To Republicans
      </span>
      <span>
        <span class="swatch split-o"></span>To independents
      </span>
    </p>
    <div class="money-grid">
      {[
        { id: 'pac-h', title: 'PACs giving the most', list: pacs },
        { id: 'emp-h', title: 'Employers of donors', list: employers },
      ].map((b) => (
        <section class="panel" aria-labelledby={b.id}>
          <h3 id={b.id} class="h-small">
            {b.title}
          </h3>
          {b.list.length === 0 ? (
            <p class="muted">Campaign reports have not loaded yet.</p>
          ) : (
            <ol class="donor-list">
              {b.list.map((d) => (
                <li>
                  <p class="donor-row">
                    <span class="donor-name">{donorName(d.name)}</span>
                    <strong class="donor-total">{formatMoney(d.total)}</strong>
                  </p>
                  <div class="split-bar" role="img" aria-label={`${donorName(d.name)}: ${splitText(d)}`}>
                    {split(d).map((p) => (
                      <span class={p.tone} style={{ flex: `${p.value} 1 0` }} />
                    ))}
                  </div>
                  <p class="small muted">
                    {d.members} {d.members === 1 ? 'member' : 'members'} · {splitText(d)}
                  </p>
                </li>
              ))}
            </ol>
          )}
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .section-note {
    margin-top: 0;
    max-width: 70ch;
  }
  .unity-chamber {
    margin-bottom: var(--space-5);
  }
  .unity-grid,
  .money-grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 50rem) {
    .unity-grid,
    .money-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .unity-party {
    margin: 0 0 var(--space-2);
  }
  .unity-label {
    margin: var(--space-3) 0 var(--space-1);
  }
  .unity-list,
  .donor-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .unity-list li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-2);
    align-items: baseline;
  }
  .unity-pct,
  .donor-total {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .unity-pct {
    font-weight: 700;
    min-width: 4.5ch;
  }
  .donor-list li p {
    margin: 0;
  }
  .donor-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }
  .split-bar {
    display: flex;
    gap: 2px;
    height: 8px;
    margin: var(--space-1) 0;
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .split-d,
  .split-legend .split-d {
    background: var(--party-d);
  }
  .split-r {
    background: var(--party-r);
  }
  .split-o {
    background: var(--text-muted);
  }
  .split-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    color: var(--text-muted);
  }
  .split-legend .swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
    margin-right: var(--space-1);
    vertical-align: -1px;
  }
</style>
