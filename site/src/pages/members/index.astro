---
import MemberChip from '../../components/MemberChip';
import MemberPhoto from '../../components/MemberPhoto';
import Hemicycle from '../../components/viz/Hemicycle';
import { chamberGroups } from '../../lib/charts';
import Base from '../../layouts/Base.astro';
import { CURRENT_CONGRESS, loadMembers } from '../../lib/build-data';
import { congressLabel, stateName } from '../../lib/format';
import { stateHref } from '../../lib/paths';

const members = [...(await loadMembers()).values()].filter((m) => m.current && m.state);
const byState = new Map<string, typeof members>();
for (const m of members) byState.set(m.state!, [...(byState.get(m.state!) ?? []), m]);
const states = [...byState.keys()].sort((a, b) => stateName(a).localeCompare(stateName(b)));
const counts = {
  senate: members.filter((m) => m.chamber === 'senate').length,
  house: members.filter((m) => m.chamber === 'house').length,
};
const house = chamberGroups((await loadMembers()).values(), 'house');
const senate = chamberGroups((await loadMembers()).values(), 'senate');
const sortKey = (m: (typeof members)[number]) => m.sort_name ?? m.name;
---

<Base
  title="Members"
  description={`Senators and representatives in the ${congressLabel(CURRENT_CONGRESS)}, by state.`}
  section="members"
>
  <header class="page-head wash members-head">
    <div>
      <p class="kicker">{congressLabel(CURRENT_CONGRESS)}</p>
      <h1>Members of Congress</h1>
      <p class="lede">
        {counts.senate} senators and {counts.house} representatives and delegates. Find anyone by name or state, see how
        they vote and what they sponsor.
      </p>
    </div>
    <div class="panel chambers">
      <Hemicycle title="House" groups={house} />
      <Hemicycle title="Senate" groups={senate} />
    </div>
  </header>

  <form class="explorer-search" id="member-filter" aria-label="Filter members" role="search">
    <div class="explorer-query">
      <label for="f-name" class="visually-hidden">
        Name or state
      </label>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input id="f-name" name="name" type="search" autocomplete="off" placeholder="Search by name or state" />
    </div>
    <div class="explorer-filters">
      <label for="f-party" class="visually-hidden">
        Party
      </label>
      <select id="f-party" name="party">
        <option value="">All parties</option>
        <option value="D">Democrats</option>
        <option value="R">Republicans</option>
        <option value="I">Independents</option>
      </select>
      <label for="f-chamber" class="visually-hidden">
        Chamber
      </label>
      <select id="f-chamber" name="chamber">
        <option value="">Both chambers</option>
        <option value="senate">Senate</option>
        <option value="house">House</option>
      </select>
    </div>
  </form>
  <p class="small muted" id="member-count" aria-live="polite"></p>

  <div class="states">
    {states.map((state) => {
      const list = byState.get(state)!;
      const senators = list.filter((m) => m.chamber === 'senate').sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
      const reps = list.filter((m) => m.chamber === 'house').sort((a, b) => (a.district ?? 0) - (b.district ?? 0));
      return (
        <section class="state" data-state={state} aria-labelledby={`st-${state}`}>
          <h2 id={`st-${state}`} class="h-small">
            <a href={stateHref(state)}>{stateName(state)}</a>
          </h2>
          <ul class="plain-members">
            {[...senators, ...reps].map((m) => (
              <li
                data-party={(m.party ?? '').charAt(0)}
                data-chamber={m.chamber}
                data-name={`${m.name} ${stateName(state)} ${state}`.toLowerCase()}
              >
                <MemberPhoto name={m.name} url={m.photo_url} bioguideId={m.bioguide_id} size={36} />
                <MemberChip member={m} />
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</Base>

<script>
  const form = document.getElementById('member-filter') as HTMLFormElement | null;
  const count = document.getElementById('member-count');
  const apply = () => {
    if (!form) return;
    const data = new FormData(form);
    const party = String(data.get('party') ?? '');
    const chamber = String(data.get('chamber') ?? '');
    const name = String(data.get('name') ?? '')
      .trim()
      .toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.state').forEach((section) => {
      let visible = 0;
      section.querySelectorAll<HTMLElement>('li[data-party]').forEach((li) => {
        const ok =
          (!party || li.dataset.party === party) &&
          (!chamber || li.dataset.chamber === chamber) &&
          (!name || (li.dataset.name ?? '').includes(name));
        li.hidden = !ok;
        if (ok) visible += 1;
      });
      section.hidden = visible === 0;
      shown += visible;
    });
    if (count) count.textContent = party || chamber || name ? `${shown} members shown` : '';
  };
  form?.addEventListener('input', apply);
  form?.addEventListener('submit', (e) => e.preventDefault());
</script>

<style>
  .states {
    columns: 18rem;
    column-gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .state {
    break-inside: avoid;
    margin-bottom: var(--space-5);
  }
  .plain-members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .plain-members li[hidden] {
    display: none;
  }
  .plain-members li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .members-head {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .members-head {
      grid-template-columns: 1fr 1fr;
    }
  }
  .chambers {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-4);
    align-items: end;
  }
  .state {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow);
  }
  .state h2 {
    margin-top: 0;
  }
  .state h2 a {
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 1.15rem;
  }
  .state h2 a:hover {
    color: var(--link);
  }
</style>
