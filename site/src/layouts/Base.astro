---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SearchPalette from '../components/SearchPalette';
import { DEMO, POLIS_SITE_ID, SITE_NAME } from '../lib/config';
import AdminLink from '../components/AdminLink';
import NavStatus from '../components/NavStatus';
import { href } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** Path of the current section, used to mark the active nav item. */
  section?:
    | 'home'
    | 'bills'
    | 'members'
    | 'votes'
    | 'executive'
    | 'court'
    | 'states'
    | 'discussions'
    | 'feed'
    | 'following'
    | 'account';
  noindex?: boolean;
}

const {
  title,
  description = 'Follow federal and state bills, legislators and votes.',
  section,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const sources = [
  { name: 'Congress.gov', url: 'https://api.congress.gov/' },
  { name: 'senate.gov', url: 'https://www.senate.gov/legislative/votes.htm' },
  { name: 'congress-legislators', url: 'https://github.com/unitedstates/congress-legislators' },
  { name: 'Open States', url: 'https://openstates.org/' },
  { name: 'Boston Legistar', url: 'https://boston.legistar.com/' },
  { name: 'the Census Geocoder', url: 'https://geocoding.geo.census.gov/' },
  { name: 'the Federal Register', url: 'https://www.federalregister.gov/' },
  { name: 'OpenFEC', url: 'https://api.open.fec.gov/developers/' },
  { name: 'CourtListener', url: 'https://www.courtlistener.com/' },
];
const explore = [
  { label: 'Bills', path: 'bills/' },
  { label: 'Members of Congress', path: 'members/' },
  { label: 'Committees', path: 'committees/' },
  { label: 'Votes', path: 'votes/' },
  { label: 'Executive orders and nominations', path: 'executive/' },
  { label: 'Supreme Court', path: 'court/' },
  { label: 'States', path: 'states/' },
  { label: 'Massachusetts', path: 'states/ma/' },
  { label: 'Boston City Council', path: 'boston/' },
  { label: 'Discussions', path: 'discussions/' },
];
const nav = [
  { key: 'bills', label: 'Bills', path: 'bills/' },
  { key: 'members', label: 'Members', path: 'members/' },
  { key: 'votes', label: 'Votes', path: 'votes/' },
  { key: 'executive', label: 'Executive', path: 'executive/' },
  { key: 'court', label: 'Court', path: 'court/' },
  { key: 'states', label: 'States & local', path: 'states/' },
  { key: 'discussions', label: 'Discuss', path: 'discussions/' },
  { key: 'feed', label: 'Feed', path: 'feed/' },
  { key: 'account', label: 'Account', path: 'account/' },
].filter((item) => !DEMO || !['feed', 'account'].includes(item.key));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c14" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Mark that scripts run, so the collapsible menu starts closed (it stays open without JS).
      document.documentElement.classList.add('js');
      // Apply a saved theme before first paint. Storage may be unavailable; ignore errors.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // Storage unavailable; fall back to the system theme.
      }
    </script>
    <script is:inline>
      // Photos load from their public sources; on error try data-fallback, then show initials.
      document.addEventListener(
        'error',
        (e) => {
          const img = e.target;
          if (!(img instanceof HTMLImageElement) || !img.classList.contains('photo')) return;
          if (img.dataset.fallback) {
            img.src = img.dataset.fallback;
            delete img.dataset.fallback;
            return;
          }
          const span = document.createElement('span');
          span.className = 'photo photo-fallback';
          span.setAttribute('aria-hidden', 'true');
          span.style.cssText = img.style.cssText;
          span.textContent = img.dataset.initials || '';
          img.replaceWith(span);
        },
        true,
      );
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href()}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <defs>
              <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#5b4cf0" />
                <stop offset=".55" stop-color="#7b5cff" />
                <stop offset="1" stop-color="#1fb5d3" />
              </linearGradient>
            </defs>
            <rect width="32" height="32" rx="9" fill="url(#brand-g)" />
            <path
              d="M9 8.5h14a3 3 0 0 1 3 3v7.5a3 3 0 0 1-3 3h-6.5L11 26v-4H9a3 3 0 0 1-3-3v-7.5a3 3 0 0 1 3-3z"
              fill="#fff"
            />
            <path
              d="M11.8 15.2l2.9 2.9 5.6-5.6"
              stroke="#5b4cf0"
              stroke-width="2.4"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{SITE_NAME}</span>
        </a>
        <div class="site-menu" id="site-menu">
          <nav aria-label="Main">
            <ul class="nav-list">
              {nav.map((item) => (
                <li class={['feed', 'account'].includes(item.key) ? 'nav-personal' : undefined}>
                  <a href={href(item.path)} aria-current={section === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        <div class="header-actions">
          <SearchPalette client:idle />
          {!DEMO && (
            <>
              <a
                class="icon-link"
                href={href('feed/')}
                aria-label="Your feed"
                title="Your feed"
                aria-current={section === 'feed' ? 'page' : undefined}
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    d="M6 10a6 6 0 1 1 12 0c0 4.5 2 6 2 6H4s2-1.5 2-6M10 20a2 2 0 0 0 4 0"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <NavStatus client:idle />
              </a>
              <a
                class="icon-link"
                href={href('account/')}
                aria-label="Account"
                title="Account"
                aria-current={section === 'account' ? 'page' : undefined}
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                  <path
                    d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </a>
            </>
          )}
          <noscript>
            <a class="search-trigger" href={href('bills/')}>
              Search bills
            </a>
          </noscript>
          <button
            type="button"
            class="menu-toggle"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label="Menu"
          >
            <span class="menu-icon" aria-hidden="true">
              <span></span>
            </span>
          </button>
        </div>
      </div>
    </header>
    {DEMO && (
      <div class="demo-banner" role="note">
        <div class="container">
          <details>
            <summary>
              <span class="demo-pill">Preview</span>
              <span class="demo-text">You’re viewing a demo built from a sample of real data.</span>
              <span class="demo-text-short">Demo with sample data.</span>
              <span class="demo-more">Details</span>
            </summary>
            <p>
              It includes 50 bills, all current members, 6 roll-call votes, recent Boston City Council matters,
              Massachusetts legislators and two example discussions. Accounts, following, the feed and Find my reps
              switch on once the database is connected
              {POLIS_SITE_ID ? '; the example discussions are an open preview anyone can try.' : '.'}
            </p>
          </details>
        </div>
      </div>
    )}
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href={href()}>
            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
              <rect width="32" height="32" rx="9" fill="url(#brand-g)" />
              <path
                d="M9 8.5h14a3 3 0 0 1 3 3v7.5a3 3 0 0 1-3 3h-6.5L11 26v-4H9a3 3 0 0 1-3-3v-7.5a3 3 0 0 1 3-3z"
                fill="#fff"
              />
              <path
                d="M11.8 15.2l2.9 2.9 5.6-5.6"
                stroke="#5b4cf0"
                stroke-width="2.4"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{SITE_NAME}</span>
          </a>
          <p>
            Free, nonpartisan and open source. No ads, no tracking. Built so anyone can follow their government and have
            a say.
          </p>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false">
            <span class="theme-icon" aria-hidden="true"></span>
            <span>Dark mode</span>
          </button>
        </div>
        <nav class="footer-col" aria-label="Explore">
          <h2>Explore</h2>
          <ul>
            {explore.map((item) => (
              <li>
                <a href={href(item.path)}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="footer-col" aria-label="About">
          <h2>About</h2>
          <ul>
            <li>
              <a href={href('privacy/')}>Privacy</a>
            </li>
            <li>
              <a href={href('moderation/')}>Discussion rules</a>
            </li>
            <li>
              <a href="https://github.com/jackhale98/opencongress">Source code</a>
            </li>
            {!DEMO && <AdminLink client:idle />}
          </ul>
        </nav>
        <div class="footer-col">
          <h2>Data from</h2>
          <ul>
            {sources.map((source) => (
              <li>
                <a href={source.url}>{source.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </footer>
    <script>
      const button = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const sync = () => button?.setAttribute('aria-pressed', String(isDark()));
      sync();
      button?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage unavailable (private mode); the choice lasts for this page only.
        }
        sync();
      });
    </script>
    <script is:inline>
      // Expanding menu on narrow screens: toggle, close on Escape or when a link is chosen.
      (function () {
        const button = document.getElementById('menu-toggle');
        const menu = document.getElementById('site-menu');
        if (!button || !menu) return;
        const set = (open) => {
          button.setAttribute('aria-expanded', String(open));
          menu.toggleAttribute('data-open', open);
        };
        button.addEventListener('click', () => {
          const open = button.getAttribute('aria-expanded') !== 'true';
          set(open);
          if (open) menu.querySelector('a, input')?.focus();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
            set(false);
            button.focus();
          }
        });
        menu.addEventListener('click', (e) => {
          if (e.target instanceof Element && e.target.closest('a')) set(false);
        });
        window.matchMedia('(min-width: 60rem)').addEventListener('change', (e) => e.matches && set(false));
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    position: relative;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    flex: none;
  }
  .brand-mark {
    width: 2rem;
    height: 2rem;
    filter: drop-shadow(0 4px 10px rgb(91 76 240 / 30%));
  }
  .site-menu {
    flex: 1;
  }
  .nav-list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.75rem;
    white-space: nowrap;
    border-radius: 999px;
    color: var(--text-muted);
    font-weight: 560;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .nav-list a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .nav-list a[aria-current='page'] {
    color: var(--brand-strong);
    background: var(--brand-soft);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }
  .menu-toggle {
    display: none;
  }
  /* Feed and account sit beside search as icons on wide screens, and in the menu on small ones. */
  .icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    color: var(--text-muted);
  }
  .icon-link:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .icon-link[aria-current='page'] {
    color: var(--brand-strong);
    background: var(--brand-soft);
  }
  .icon-link :global(.badge) {
    position: absolute;
    top: 2px;
    right: -2px;
    margin: 0;
  }
  @media (min-width: 64rem) {
    .nav-personal {
      display: none;
    }
  }
  @media (max-width: 63.99rem) {
    .icon-link {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
      width: 44px;
      padding: 0;
      border-radius: 12px;
      background: var(--bg-raised);
      border-color: var(--border);
    }
    .menu-icon,
    .menu-icon::before,
    .menu-icon::after,
    .menu-icon > span {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }
    .menu-icon {
      position: relative;
      background: transparent;
    }
    .menu-icon::before,
    .menu-icon::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .menu-icon::before {
      top: -6px;
    }
    .menu-icon::after {
      top: 6px;
    }
    .menu-toggle[aria-expanded='true'] .menu-icon > span {
      opacity: 0;
    }
    .menu-toggle[aria-expanded='true'] .menu-icon::before {
      transform: translateY(6px) rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] .menu-icon::after {
      transform: translateY(-6px) rotate(-45deg);
    }
    .site-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--border);
      padding: var(--space-2) var(--space-4) var(--space-4);
      box-shadow: 0 18px 30px rgb(18 19 31 / 12%);
    }
    :global(html.js) .site-menu:not([data-open]) {
      display: none;
    }
    .nav-list {
      flex-direction: column;
    }
    .nav-list a {
      width: 100%;
      min-height: 48px;
      font-size: var(--step-1);
      border-radius: 12px;
    }
  }
  main {
    padding-block: var(--space-6) var(--space-7);
  }
  .demo-banner {
    border-bottom: 1px solid var(--border);
    background: var(--bg-raised);
    font-size: var(--step--1);
  }
  .demo-banner summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    min-height: 40px;
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
  }
  .demo-banner summary::-webkit-details-marker {
    display: none;
  }
  .demo-pill {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    color: var(--highlight-strong);
    background: var(--highlight-soft);
  }
  .demo-text-short {
    display: none;
  }
  @media (max-width: 40rem) {
    .demo-banner summary {
      flex-wrap: nowrap;
    }
    .demo-text {
      display: none;
    }
    .demo-text-short {
      display: inline;
    }
  }
  .demo-more {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  details[open] .demo-more {
    display: none;
  }
  .demo-banner p {
    margin: 0 0 var(--space-3);
    color: var(--text-muted);
  }
  .site-footer {
    margin-top: var(--space-7);
    border-top: 1px solid var(--border);
    background: var(--bg-raised);
    padding-block: var(--space-7) var(--space-6);
    font-size: var(--step--1);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  @media (min-width: 60rem) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
  .footer-brand p {
    color: var(--text-muted);
    margin: var(--space-3) 0;
    max-width: 30ch;
  }
  .footer-col h2 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .footer-col a {
    color: var(--text);
    text-decoration: none;
  }
  .footer-col a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .theme-toggle {
    min-height: 40px;
    border-radius: 999px;
    font-size: var(--step--1);
    gap: var(--space-2);
  }
  .theme-icon {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: linear-gradient(90deg, var(--text) 50%, transparent 50%);
    border: 2px solid var(--text);
  }
</style>
