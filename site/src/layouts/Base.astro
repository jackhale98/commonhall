---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SearchPalette from '../components/SearchPalette';
import { DEMO, POLIS_SITE_ID, SITE_NAME } from '../lib/config';
import AdminLink from '../components/AdminLink';
import NavStatus from '../components/NavStatus';
import { LoaderMark } from '../components/Loader';
import { activeNav, localTrail, NAV, orderedItems, PHONE_NAV } from '../lib/nav';
import { href } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** The page's section. The header works out the active section from the path (lib/nav.ts). */
  section?:
    | 'home'
    | 'bills'
    | 'members'
    | 'votes'
    | 'executive'
    | 'court'
    | 'states'
    | 'discussions'
    | 'feed'
    | 'following'
    | 'account';
  noindex?: boolean;
}

const { title, description = 'Follow federal and state bills, legislators and votes.', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const sources = [
  { name: 'Congress.gov', url: 'https://api.congress.gov/' },
  { name: 'senate.gov', url: 'https://www.senate.gov/legislative/votes.htm' },
  { name: 'congress-legislators', url: 'https://github.com/unitedstates/congress-legislators' },
  { name: 'Open States', url: 'https://openstates.org/' },
  { name: 'Boston Legistar', url: 'https://boston.legistar.com/' },
  { name: 'Analyze Boston', url: 'https://data.boston.gov/' },
  { name: 'Worcester PrimeGov', url: 'https://worcesterma.primegov.com/public/portal' },
  { name: 'Worcester open data', url: 'https://opendata.worcesterma.gov/' },
  { name: 'Somerville Legistar', url: 'https://somervillema.legistar.com/' },
  { name: 'Somerville open data', url: 'https://data.somervillema.gov/' },
  { name: 'MassGIS', url: 'https://www.mass.gov/orgs/massgis-bureau-of-geographic-information' },
  { name: 'the Census Geocoder', url: 'https://geocoding.geo.census.gov/' },
  { name: 'the Federal Register', url: 'https://www.federalregister.gov/' },
  { name: 'OpenFEC', url: 'https://api.open.fec.gov/developers/' },
  { name: 'CourtListener', url: 'https://www.courtlistener.com/' },
  { name: 'mass.gov', url: 'https://www.mass.gov/massachusetts-executive-orders' },
  { name: 'portal.ct.gov', url: 'https://portal.ct.gov/governor/governors-actions/executive-orders' },
];
const nav = NAV.filter((g) => !DEMO || !g.personal);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pagePath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const here = activeNav(pagePath);
const subnav = here.group?.items ? here.group : undefined;
// Congress shows its sections as tabs; States & local shows a trail to where you are.
const subnavItems = subnav ? (subnav.trail ? localTrail(pagePath) : orderedItems(subnav)) : [];
const currentKey = here.item?.key ?? here.group?.key;
const phoneNav = PHONE_NAV.map((section) => ({
  ...section,
  items: section.items.filter((i) => !DEMO || !['feed', 'account'].includes(i.key)),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c14" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={href('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="manifest" href={href('site.webmanifest')} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Mark that scripts run, so the collapsible menu starts closed (it stays open without JS).
      document.documentElement.classList.add('js');
      // Apply a saved theme before first paint. Storage may be unavailable; ignore errors.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // Storage unavailable; fall back to the system theme.
      }
    </script>
    <script is:inline>
      // Photos load from their public sources; on error try data-fallback, then show initials.
      document.addEventListener(
        'error',
        (e) => {
          const img = e.target;
          if (!(img instanceof HTMLImageElement) || !img.classList.contains('photo')) return;
          if (img.dataset.fallback) {
            img.src = img.dataset.fallback;
            delete img.dataset.fallback;
            return;
          }
          const span = document.createElement('span');
          span.className = 'photo photo-fallback';
          span.setAttribute('aria-hidden', 'true');
          span.style.cssText = img.style.cssText;
          span.style.fontSize = Math.min(19, Math.round((img.width || 96) * 0.4)) + 'px';
          span.textContent = img.dataset.initials || '';
          img.replaceWith(span);
        },
        true,
      );
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href()}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <g class="brand-seats">
              <circle cx="25.08" cy="6.94" r="2.7" />
              <circle cx="17.06" cy="4.54" r="2.7" />
              <circle cx="9.54" cy="8.21" r="2.7" />
              <circle cx="6.5" cy="16" r="2.7" />
              <circle cx="9.54" cy="23.79" r="2.7" />
              <circle cx="17.06" cy="27.46" r="2.7" />
              <circle cx="25.08" cy="25.06" r="2.7" />
            </g>
            <circle class="brand-you" cx="18" cy="16" r="3.4" />
          </svg>
          <span>{SITE_NAME}</span>
        </a>
        <div class="site-menu" id="site-menu">
          <nav aria-label="Main" class="phone-nav">
            {phoneNav.map((section) => (
              <section>
                <h2>{section.heading}</h2>
                <ul>
                  {section.items.map((item) => (
                    <li>
                      <a href={href(item.path)} aria-current={currentKey === item.key ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </nav>
          <nav aria-label="Main" class="wide-nav">
            <ul class="nav-list">
              {nav.map((group) =>
                group.items ? (
                  <li class="nav-group">
                    <span class="nav-group-label" aria-hidden="true">
                      {group.label}
                    </span>
                    <button
                      type="button"
                      class:list={['nav-group-button', { 'is-current': here.group?.key === group.key }]}
                      aria-expanded="false"
                      aria-controls={`nav-${group.key}`}
                    >
                      {group.label}
                      <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                        <path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" />
                      </svg>
                    </button>
                    <ul class="nav-pop" id={`nav-${group.key}`} aria-label={group.label}>
                      {orderedItems(group).map((item) => (
                        <li>
                          <a href={href(item.path)} aria-current={here.item?.key === item.key ? 'page' : undefined}>
                            {item.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class={group.personal ? 'nav-personal' : undefined}>
                    <a href={href(group.path!)} aria-current={here.group?.key === group.key ? 'page' : undefined}>
                      {group.label}
                    </a>
                  </li>
                ),
              )}
            </ul>
          </nav>
        </div>
        <div class="header-actions">
          <SearchPalette client:idle />
          {!DEMO && (
            <>
              <a
                class="icon-link"
                href={href('feed/')}
                aria-label="Your feed"
                title="Your feed"
                aria-current={here.group?.key === 'feed' ? 'page' : undefined}
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    d="M6 10a6 6 0 1 1 12 0c0 4.5 2 6 2 6H4s2-1.5 2-6M10 20a2 2 0 0 0 4 0"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <NavStatus client:idle />
              </a>
              <a
                class="icon-link"
                href={href('account/')}
                aria-label="Account"
                title="Account"
                aria-current={here.group?.key === 'account' ? 'page' : undefined}
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                  <path
                    d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </a>
            </>
          )}
          <noscript>
            <a class="search-trigger" href={href('bills/')}>
              Search bills
            </a>
          </noscript>
          <button
            type="button"
            class="menu-toggle"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label="Menu"
          >
            <span class="menu-icon" aria-hidden="true">
              <span></span>
            </span>
          </button>
        </div>
      </div>
    </header>
    {DEMO && (
      <div class="demo-banner" role="note">
        <div class="container">
          <details>
            <summary>
              <span class="demo-pill">Preview</span>
              <span class="demo-text">You’re viewing a demo built from a sample of real data.</span>
              <span class="demo-text-short">Demo with sample data.</span>
              <span class="demo-more">Details</span>
            </summary>
            <p>
              It includes 50 bills, all current members, 6 roll-call votes, recent Boston City Council matters,
              Massachusetts legislators and two example discussions. Accounts, following, the feed and Find my reps
              switch on once the database is connected
              {POLIS_SITE_ID ? '; the example discussions are an open preview anyone can try.' : '.'}
            </p>
          </details>
        </div>
      </div>
    )}
    {subnav && subnavItems.length > 0 && (
      <nav class:list={['subnav', { 'is-trail': subnav.trail }]} aria-label={subnav.label}>
        <ul class="container">
          {subnavItems.map((item) => (
            <li>
              <a
                href={href(item.path)}
                aria-current={
                  item.key.startsWith('state-') || (item.key !== 'states' && here.item?.key === item.key)
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <main id="main" class:list={['container', { 'has-subnav': subnavItems.length > 0 }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          {/* A small surprise: the mark plays the roll call (the loading animation) once. */}
          <button type="button" class="brand brand-egg" id="brand-egg" title="Call the roll">
            <LoaderMark class="brand-mark" />
            <span>{SITE_NAME}</span>
          </button>
          <p>
            Free, nonpartisan and open source. No ads, no tracking. Built so anyone can follow their government and have
            a say.
          </p>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false">
            <span class="theme-icon" aria-hidden="true"></span>
            <span>Dark mode</span>
          </button>
        </div>
        <nav class="footer-col" aria-label="About">
          <h2>About</h2>
          <ul>
            <li>
              <a href={href('privacy/')}>Privacy</a>
            </li>
            <li>
              <a href={href('moderation/')}>Discussion rules</a>
            </li>
            <li>
              <a href={href('status/')}>Data status</a>
            </li>
            <li>
              <a href="https://github.com/jackhale98/commonhall">Source code</a>
            </li>
            {!DEMO && (
              <li class="admin-item">
                <AdminLink client:idle />
              </li>
            )}
          </ul>
        </nav>
        <div class="footer-col footer-sources">
          <h2>Data from</h2>
          <ul>
            {sources.map((source) => (
              <li>
                <a href={source.url}>{source.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </footer>
    <script>
      const egg = document.getElementById('brand-egg');
      egg?.addEventListener('click', () => {
        if (egg.classList.contains('is-playing')) return;
        egg.classList.add('is-playing');
        // Stop once the ballot has struck and the room has applauded (82% of the 3 s
        // roll call), before the seats empty out. The still logo looks the same as
        // that frame, so the hand-over is seamless.
        window.setTimeout(() => egg.classList.remove('is-playing'), 2460);
      });
    </script>
    <script>
      const button = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const sync = () => button?.setAttribute('aria-pressed', String(isDark()));
      sync();
      button?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage unavailable (private mode); the choice lasts for this page only.
        }
        sync();
      });
    </script>
    <script is:inline>
      // Expanding menu on narrow screens: toggle, close on Escape or when a link is chosen.
      (function () {
        const button = document.getElementById('menu-toggle');
        const menu = document.getElementById('site-menu');
        if (!button || !menu) return;
        const set = (open) => {
          button.setAttribute('aria-expanded', String(open));
          menu.toggleAttribute('data-open', open);
        };
        button.addEventListener('click', () => {
          const open = button.getAttribute('aria-expanded') !== 'true';
          set(open);
          if (open) menu.querySelector('a, input')?.focus();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
            set(false);
            button.focus();
          }
        });
        menu.addEventListener('click', (e) => {
          if (e.target instanceof Element && e.target.closest('a')) set(false);
        });
        window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && set(false));

        // Wide screens: Congress and States & local open a small menu on click (not hover).
        const groups = [...menu.querySelectorAll('.nav-group-button')];
        const close = (except) => groups.forEach((g) => g !== except && g.setAttribute('aria-expanded', 'false'));
        groups.forEach((g) =>
          g.addEventListener('click', () => {
            const open = g.getAttribute('aria-expanded') !== 'true';
            close(g);
            g.setAttribute('aria-expanded', String(open));
          }),
        );
        document.addEventListener('click', (e) => {
          if (!(e.target instanceof Element) || !e.target.closest('.nav-group')) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const open = groups.find((g) => g.getAttribute('aria-expanded') === 'true');
          if (open) {
            close();
            open.focus();
          }
        });
        menu.addEventListener('focusout', (e) => {
          if (!(e.relatedTarget instanceof Element) || !e.relatedTarget.closest('.nav-group')) close();
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    position: relative;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    flex: none;
  }
  .brand-mark {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }
  .brand-seats {
    fill: var(--brand);
  }
  .brand-you {
    fill: var(--highlight);
  }
  .site-menu {
    flex: 1;
  }
  .phone-nav {
    display: none;
  }
  .nav-list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.75rem;
    white-space: nowrap;
    border-radius: 999px;
    color: var(--text-muted);
    font-weight: 560;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .nav-list a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .nav-list a[aria-current='page'],
  .nav-group-button.is-current {
    color: var(--brand-strong);
    background: var(--brand-soft);
  }
  .nav-group {
    position: relative;
  }
  .nav-group-label {
    display: none;
  }
  .nav-group-button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 40px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-weight: 560;
    white-space: nowrap;
    cursor: pointer;
  }
  .nav-group-button:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .nav-group-button svg {
    transition: transform 0.15s ease;
  }
  .nav-group-button[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .nav-pop {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 30;
    min-width: 12rem;
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 30px rgb(18 19 31 / 14%);
  }
  .nav-pop a {
    display: flex;
    width: 100%;
    border-radius: 10px;
  }
  /* Without scripts the menus open on keyboard focus; with them, on click. */
  :global(html:not(.js)) .nav-group:not(:focus-within) .nav-pop,
  :global(html.js) .nav-group-button[aria-expanded='false'] + .nav-pop {
    display: none;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }
  .menu-toggle {
    display: none;
  }
  /* Feed and account sit beside search as icons on wide screens, and in the menu on small ones. */
  .icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    color: var(--text-muted);
  }
  .icon-link:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .icon-link[aria-current='page'] {
    color: var(--brand-strong);
    background: var(--brand-soft);
  }
  .icon-link :global(.badge) {
    position: absolute;
    top: 2px;
    right: -2px;
    margin: 0;
  }
  @media (min-width: 64rem) {
    .nav-personal {
      display: none;
    }
  }
  /* Narrow desktops: tighter menu so every section fits beside the logo. */
  @media (min-width: 64rem) and (max-width: 72rem) {
    .nav-list a,
    .nav-group-button {
      padding-inline: 0.5rem;
    }
  }
  @media (max-width: 63.99rem) {
    .icon-link {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
      width: 44px;
      padding: 0;
      border-radius: 12px;
      background: var(--bg-raised);
      border-color: var(--border);
    }
    .menu-icon,
    .menu-icon::before,
    .menu-icon::after,
    .menu-icon > span {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }
    .menu-icon {
      position: relative;
      background: transparent;
    }
    .menu-icon::before,
    .menu-icon::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .menu-icon::before {
      top: -6px;
    }
    .menu-icon::after {
      top: 6px;
    }
    .menu-toggle[aria-expanded='true'] .menu-icon > span {
      opacity: 0;
    }
    .menu-toggle[aria-expanded='true'] .menu-icon::before {
      transform: translateY(6px) rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] .menu-icon::after {
      transform: translateY(-6px) rotate(-45deg);
    }
    .site-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--border);
      padding: var(--space-3) var(--space-4) var(--space-4);
      box-shadow: 0 18px 30px rgb(18 19 31 / 12%);
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    :global(html.js) .site-menu:not([data-open]) {
      display: none;
    }
    .nav-list {
      flex-direction: column;
    }
    .nav-list a {
      width: 100%;
      min-height: 48px;
      font-size: var(--step-1);
      border-radius: 12px;
    }
    /* Phones get their own menu (.phone-nav): headings over one link per row. */
    .wide-nav {
      display: none;
    }
    .phone-nav {
      display: grid;
