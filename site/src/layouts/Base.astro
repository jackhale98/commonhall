---
import '../styles/global.css';
import { DEMO, SITE_NAME } from '../lib/config';
import NavStatus from '../components/NavStatus';
import { href } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** Path of the current section, used to mark the active nav item. */
  section?: 'home' | 'bills' | 'members' | 'votes' | 'states' | 'discussions' | 'feed' | 'following' | 'account';
  noindex?: boolean;
}

const {
  title,
  description = 'Follow federal and state bills, legislators and votes.',
  section,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const sources = [
  { name: 'Congress.gov', url: 'https://api.congress.gov/' },
  { name: 'senate.gov', url: 'https://www.senate.gov/legislative/votes.htm' },
  { name: 'congress-legislators', url: 'https://github.com/unitedstates/congress-legislators' },
  { name: 'Open States', url: 'https://openstates.org/' },
  { name: 'Boston Legistar', url: 'https://boston.legistar.com/' },
  { name: 'the Census Geocoder', url: 'https://geocoding.geo.census.gov/' },
];
const nav = [
  { key: 'bills', label: 'Bills', path: 'bills/' },
  { key: 'members', label: 'Members', path: 'members/' },
  { key: 'votes', label: 'Votes', path: 'votes/' },
  { key: 'states', label: 'States & local', path: 'states/' },
  { key: 'discussions', label: 'Discuss', path: 'discussions/' },
  { key: 'feed', label: 'Feed', path: 'feed/' },
  { key: 'account', label: 'Account', path: 'account/' },
].filter((item) => !DEMO || !['feed', 'account'].includes(item.key));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint. Storage may be unavailable; ignore errors.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // Storage unavailable; fall back to the system theme.
      }
    </script>
    <script is:inline>
      // Photos load from their public sources; on error try data-fallback, then show initials.
      document.addEventListener(
        'error',
        (e) => {
          const img = e.target;
          if (!(img instanceof HTMLImageElement) || !img.classList.contains('photo')) return;
          if (img.dataset.fallback) {
            img.src = img.dataset.fallback;
            delete img.dataset.fallback;
            return;
          }
          const span = document.createElement('span');
          span.className = 'photo photo-fallback';
          span.setAttribute('aria-hidden', 'true');
          span.style.cssText = img.style.cssText;
          span.textContent = img.dataset.initials || '';
          img.replaceWith(span);
        },
        true,
      );
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href()}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 3 4 10h24L16 3Z" fill="currentColor" />
            <rect x="6" y="12" width="3" height="11" rx="1" fill="currentColor" />
            <rect x="12" y="12" width="3" height="11" rx="1" fill="currentColor" />
            <rect x="17" y="12" width="3" height="11" rx="1" fill="currentColor" />
            <rect x="23" y="12" width="3" height="11" rx="1" fill="currentColor" />
            <rect x="4" y="25" width="24" height="3" rx="1" fill="currentColor" />
          </svg>
          {SITE_NAME}
        </a>
        <nav aria-label="Main">
          <ul class="nav-list">
            {nav.map((item) => (
              <li>
                <a href={href(item.path)} aria-current={section === item.key ? 'page' : undefined}>
                  {item.label}
                  {item.key === 'feed' && <NavStatus client:idle />}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <form class="header-search" role="search" action={href('bills/')} method="get">
          <label for="site-search" class="visually-hidden">
            Search bills
          </label>
          <input id="site-search" name="q" type="search" placeholder="Search bills" autocomplete="off" />
          <button type="submit">Search</button>
        </form>
      </div>
    </header>
    {DEMO && (
      <div class="demo-banner" role="note">
        <div class="container">
          <strong>Demo.</strong> This preview uses a small sample of real data (50 bills, current members, 6 roll-call
          votes, recent Boston City Council matters and Massachusetts legislators) and two example discussions.
          Accounts, following, the feed, Find my reps and discussions are switched off until a database is connected.
        </div>
      </div>
    )}
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container cluster small muted">
        <span>
          Data from{' '}
          {sources.map((source, i) => (
            <>
              <a href={source.url}>{source.name}</a>
              {i < sources.length - 2 ? ', ' : i === sources.length - 2 ? ' and ' : '.'}
            </>
          ))}
        </span>
        <span>Free and open source. No ads, no tracking.</span>
        <a href={href('privacy/')}>Privacy</a>
        <a href={href('moderation/')}>Discussion rules</a>
        <button type="button" class="link-button" id="theme-toggle" aria-pressed="false">
          Toggle dark mode
        </button>
      </div>
    </footer>
    <script>
      const button = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const sync = () => button?.setAttribute('aria-pressed', String(isDark()));
      sync();
      button?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage unavailable (private mode); the choice lasts for this page only.
        }
        sync();
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    background: var(--header-bg);
    color: var(--header-text);
    box-shadow: 0 1px 0 rgb(0 0 0 / 20%);
  }
  @media (min-width: 60rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 5;
    }
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 800;
    letter-spacing: -0.01em;
    font-size: var(--step-1);
    color: var(--header-text);
    text-decoration: none;
  }
  .brand-mark {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--highlight);
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-1);
    color: var(--header-muted);
    font-weight: 600;
    text-decoration: none;
    box-shadow: inset 0 -3px 0 transparent;
  }
  .nav-list a:hover {
    color: var(--header-text);
  }
  .nav-list a[aria-current='page'] {
    color: var(--header-text);
    box-shadow: inset 0 -3px 0 var(--highlight);
  }
  .header-search input {
    background: rgb(255 255 255 / 10%);
    border-color: rgb(255 255 255 / 25%);
    color: var(--header-text);
  }
  .header-search input::placeholder {
    color: var(--header-muted);
  }
  .header-search button {
    background: var(--highlight);
    border-color: var(--highlight);
    color: #1d1300;
    font-weight: 700;
  }
  .site-header :focus-visible {
    outline-color: var(--highlight);
  }
  .header-search {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
    flex: 1 1 16rem;
    max-width: 24rem;
  }
  main {
    padding-block: var(--space-5) var(--space-7);
  }
  .demo-banner {
    background: var(--highlight-soft);
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-2);
    font-size: var(--step--1);
  }
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-raised);
    padding-block: var(--space-5);
  }
</style>
