---
/**
 * The header shared by Boston’s sub-pages: title, one-line lede and the tab row
 * (each tab is its own page, so it can be linked to and stays short).
 */
import { BOSTON_TABS, type BostonTab } from '../lib/local';
import { href } from '../lib/paths';
import PageTabs from './PageTabs.astro';

interface Props {
  current: BostonTab;
  /** One line under the title. */
  lede?: string;
}

const { current, lede } = Astro.props;
---

<header class="boston-head">
  <h1>Boston</h1>
  {lede && <p class="lede">{lede}</p>}
  <PageTabs
    label="Boston"
    fill
    tabs={BOSTON_TABS.map((t) => ({ label: t.label, href: href(t.path), current: t.key === current }))}
  />
</header>

<style>
  .boston-head h1 {
    margin-bottom: var(--space-2);
  }
  .boston-head .lede {
    font-size: var(--step-0);
    margin: 0 0 var(--space-3);
  }
</style>
