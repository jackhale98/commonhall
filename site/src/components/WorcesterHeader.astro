---
/** The header shared by Worcester's pages: title, an optional lede, and the tab row. */
import { href } from '../lib/paths';
import { WORCESTER_TABS, type WorcesterTab } from '../lib/worcester';
import PageTabs from './PageTabs.astro';

interface Props {
  current: WorcesterTab;
  lede?: string;
}

const { current, lede } = Astro.props;
---

<header class="city-head">
  <h1>Worcester</h1>
  {lede && <p class="lede">{lede}</p>}
  <PageTabs
    label="Worcester"
    fill
    tabs={WORCESTER_TABS.map((t) => ({ label: t.label, href: href(t.path), current: t.key === current }))}
  />
</header>

<style>
  .city-head h1 {
    margin-bottom: var(--space-2);
  }
  .city-head .lede {
    font-size: var(--step-0);
    margin: 0 0 var(--space-3);
  }
</style>
