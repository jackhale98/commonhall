---
/**
 * Boston committee hearings as rows: when, which committee (unless on its own
 * page), the dockets on the agenda, and links to the agenda and Legistar.
 */
import { committeeSlug } from '@civic/congress-client/boston-committees';
import { legistarMatterUrl } from '@civic/congress-client/legistar';
import { formatDate } from '../lib/format';
import type { BostonHearing } from '../lib/local';
import { localCommitteeHref, localMatterFallbackHref } from '../lib/paths';

interface Props {
  hearings: BostonHearing[];
  /** On a committee's own page: name only the other committee of a joint hearing. */
  committee?: string;
  upcoming?: boolean;
}

const { hearings, committee, upcoming = false } = Astro.props;
const FIRST_DOCKETS = 4;
---

<ul class="plain-rows hearing-list">
  {hearings.map((h) => {
    const others = h.committees.filter((c) => c !== committee);
    return (
      <li>
        <p class="hearing-when">
          <strong>{formatDate(h.date)}</strong>
          {h.time && ` · ${h.time}`}
          {others.length > 0 && (
            <>
              {' · '}
              {committee && 'Joint with '}
              {others.map((c, i) => (
                <>
                  {i > 0 && ' and '}
                  <a href={localCommitteeHref(committeeSlug(c))}>{c}</a>
                </>
              ))}
            </>
          )}
        </p>
        {h.items.length > 0 && (
          <ul class="docket-list small">
            {h.items.slice(0, FIRST_DOCKETS).map((i) => (
              <li>
                {i.matter_id ? (
                  <a
                    href={
                      i.stored
                        ? localMatterFallbackHref(i.matter_id)
                        : legistarMatterUrl('boston', Number(i.matter_id.replace(/^boston-/, '')))
                    }
                    rel={i.stored ? undefined : 'noopener'}
                  >
                    Docket #{i.file_number ?? '?'}
                  </a>
                ) : (
                  <span>Docket #{i.file_number ?? '?'}</span>
                )}
                : <span class="docket-title">{i.title}</span>
              </li>
            ))}
            {h.items.length > FIRST_DOCKETS && (
              <li class="muted">and {h.items.length - FIRST_DOCKETS} more on the agenda</li>
            )}
          </ul>
        )}
        <p class="cluster small hearing-links">
          {h.agenda_url && (
            <a href={h.agenda_url} rel="noopener">
              Agenda
            </a>
          )}
          {h.minutes_url && (
            <a href={h.minutes_url} rel="noopener">
              Minutes
            </a>
          )}
          {h.legistar_url && (
            <a href={h.legistar_url} rel="noopener">
              {upcoming ? 'Meeting details' : 'Legistar'}
            </a>
          )}
        </p>
      </li>
    );
  })}
</ul>

<style>
  .hearing-list > li {
    display: grid;
    gap: var(--space-1);
  }
  .hearing-list p {
    margin: 0;
  }
  .docket-list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.2rem;
  }
  .docket-list li {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .docket-title {
    color: var(--text-muted);
  }
  .hearing-links {
    gap: var(--space-1) var(--space-4);
  }
</style>
