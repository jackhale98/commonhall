---
/**
 * A city's council and committee meetings as compact rows: date and time, which
 * committee (or the full council), and links to the agenda and minutes.
 */
import { formatDate } from '../lib/format';
import { worcesterCommitteeHref } from '../lib/paths';
import type { CityMeeting } from '../lib/worcester';

interface Props {
  meetings: CityMeeting[];
  /** Committee slugs by name, to link committee meetings to their pages. */
  slugs?: Map<string, string>;
  /** Leave out this committee's name (on its own page). */
  committee?: string;
  upcoming?: boolean;
}

const { meetings, slugs = new Map(), committee, upcoming = false } = Astro.props;
---

<ul class="list city-meetings">
  {meetings.map((m) => {
    const others = m.committees.filter((c) => c !== committee);
    const name = (c: string) => (slugs.get(c) ? <a href={worcesterCommitteeHref(slugs.get(c)!)}>{c}</a> : c);
    return (
      <li class:list={{ cancelled: m.status === 'Cancelled' }}>
        <span>
          <strong>{formatDate(m.date)}</strong>
          {upcoming && m.time && ` · ${m.time}`} ·{' '}
          {m.committees.length === 0 ? (
            'City Council'
          ) : committee && others.length === 0 ? (
            'Committee meeting'
          ) : (
            <>
              {committee && 'Jointly with '}
              {others.map((c, i) => (
                <>
                  {i > 0 && ' and '}
                  {name(c)}
                </>
              ))}
            </>
          )}
          {m.status === 'Cancelled' && <span class="pill"> Cancelled</span>}
          {upcoming && m.location && <span class="small muted"> · {m.location}</span>}
        </span>
        <span class="cluster small">
          {m.agenda_url && (
            <a href={m.agenda_url} rel="noopener">
              Agenda
            </a>
          )}
          {m.minutes_url && (
            <a href={m.minutes_url} rel="noopener">
              Minutes
            </a>
          )}
        </span>
      </li>
    );
  })}
</ul>

<style>
  .city-meetings li {
    display: flex;
    gap: var(--space-1) var(--space-3);
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .city-meetings .cancelled strong {
    text-decoration: line-through;
  }
  .city-meetings .pill {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
