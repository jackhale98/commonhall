---
import { safeUrl } from '@civic/congress-client/safe-url';
/**
 * A city's council and committee meetings as rows: when, which committee (linked)
 * or the full council, cancellations, the dockets on a committee's agenda where the
 * city records them, and links to the agenda and minutes.
 */
import { legistarMatterUrl } from '@civic/congress-client/legistar';
import type { City } from '../lib/cities';
import type { CityMeeting } from '../lib/city';
import { formatDate } from '../lib/format';
import { idWithinCity } from '../lib/cities';
import { localCommitteeHref, localMatterFallbackHref } from '../lib/paths';

interface Props {
  city: City;
  meetings: CityMeeting[];
  /** Committee slugs by name, for links. */
  slugs: Map<string, string>;
  /** On a committee's own page: name only the other committee of a joint session. */
  committee?: string;
  upcoming?: boolean;
  /** Show the dockets on each committee agenda. */
  dockets?: boolean;
  /** Divided rows without the card look, for a list outside a panel. */
  plain?: boolean;
  /** With upcoming: the last council meeting, shown (by the script below) once every upcoming one has passed. */
  fallback?: CityMeeting;
}

const { city, meetings, slugs, committee, upcoming = false, dockets = false, plain = false, fallback } = Astro.props;
const rows = fallback ? [...meetings, fallback] : meetings;
const FIRST_DOCKETS = 4;
const session = city.committeeSession;
---

<ul class:list={[plain ? 'plain-rows' : 'list', 'meeting-list']} data-upcoming={upcoming || undefined}>
  {rows.map((m) => {
    const others = m.committees.filter((c) => c !== committee);
    const name = (c: string) => (slugs.get(c) ? <a href={localCommitteeHref(city, slugs.get(c)!)}>{c}</a> : c);
    // Boston files a hearing's subject in its location; only a council meeting's location is a place.
    const place = m.committees.length && city.locationIsSubject ? null : m.location;
    return (
      <li
        class:list={{ cancelled: m.status === 'Cancelled' }}
        data-date={m.date}
        data-council={m.committees.length === 0 || undefined}
        hidden={m === fallback || undefined}
      >
        <p class="meeting-when">
          <strong>{formatDate(m.date)}</strong>
          {(upcoming || committee) && m.time && ` · ${m.time}`} ·{' '}
          {m.committees.length === 0 ? (
            (city.councilBody ?? 'City Council')
          ) : committee && others.length === 0 ? (
            `Committee ${session}`
          ) : (
            <>
              {committee && 'Jointly with '}
              {others.map((c, i) => (
                <>
                  {i > 0 && ' and '}
                  {name(c)}
                </>
              ))}
              {!committee && ` ${others.length > 1 ? `joint ${session}` : session}`}
            </>
          )}
          {m.status === 'Cancelled' && <span class="small muted"> · Cancelled</span>}
          {upcoming && place && <span class="small muted"> · {place}</span>}
        </p>
        {dockets && m.items.length > 0 && (
          <ul class="docket-list small">
            {m.items.slice(0, FIRST_DOCKETS).map((i) => (
              <li>
                {i.matter_id && (i.stored || city.legistar) ? (
                  <a
                    href={
                      i.stored
                        ? localMatterFallbackHref(i.matter_id)
                        : legistarMatterUrl(city.legistar!, Number(idWithinCity(i.matter_id)))
                    }
                    rel={i.stored ? undefined : 'noopener'}
                  >
                    {city.docketPrefix ?? 'Docket #'}
                    {i.file_number ?? '?'}
                  </a>
                ) : (
                  <span>
                    {city.docketPrefix ?? 'Docket #'}
                    {i.file_number ?? '?'}
                  </span>
                )}
                : <span class="docket-title">{i.title}</span>
              </li>
            ))}
            {m.items.length > FIRST_DOCKETS && (
              <li class="muted">and {m.items.length - FIRST_DOCKETS} more on the agenda</li>
            )}
          </ul>
        )}
        <p class="cluster small meeting-links">
          {m.agenda_url && (
            <a href={safeUrl(m.agenda_url) ?? undefined} rel="noopener">
              Agenda
            </a>
          )}
          {m.minutes_url && (
            <a href={safeUrl(m.minutes_url) ?? undefined} rel="noopener">
              Minutes
            </a>
          )}
          {!m.agenda_url && !m.minutes_url && m.legistar_url && (
            <a href={safeUrl(m.legistar_url) ?? undefined} rel="noopener">
              Meeting details
            </a>
          )}
        </p>
      </li>
    );
  })}
</ul>

<script>
  // Pages are built once a day, so an "upcoming" meeting can have passed since. Hide
  // those in the browser; a list left empty hides its group ([data-upcoming-group]),
  // shows its [data-upcoming-none] note instead, or, with data-past-heading, keeps its
  // council meeting under that heading.
  const today = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD, the reader's day
  for (const list of document.querySelectorAll<HTMLElement>('ul[data-upcoming]')) {
    const rows = [...list.querySelectorAll<HTMLElement>(':scope > li[data-date]')];
    const passed = rows.filter((li) => li.dataset.date! < today);
    if (passed.length === 0) continue;
    for (const li of passed) li.hidden = true;
    if (passed.length < rows.length) continue;
    const group = list.closest<HTMLElement>('[data-upcoming-group]');
    if (!group) continue;
    const none = group.querySelector<HTMLElement>('[data-upcoming-none]');
    if (none) {
      none.hidden = false;
      list.closest<HTMLElement>('.panel')?.setAttribute('hidden', '');
      continue;
    }
    const heading = group.querySelector<HTMLElement>('[data-past-heading]');
    // The latest council meeting that has passed: an upcoming one, or the fallback row.
    const council = [...list.querySelectorAll<HTMLElement>(':scope > li[data-council]')]
      .filter((li) => li.dataset.date! < today)
      .sort((a, b) => b.dataset.date!.localeCompare(a.dataset.date!))[0];
    if (heading && council) {
      heading.textContent = heading.dataset.pastHeading!;
      council.hidden = false;
    } else {
      group.hidden = true;
    }
  }
</script>

<style>
  .meeting-list > li[hidden] {
    display: none;
  }
  /* Document links as tap-sized targets. */
  .meeting-links a {
    display: inline-block;
    padding-block: 0.35rem;
  }
  .meeting-list > li {
    display: grid;
    gap: var(--space-1);
  }
  .meeting-list p {
    margin: 0;
  }
  .meeting-list .cancelled strong {
    text-decoration: line-through;
  }
  .docket-list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.2rem;
  }
  .docket-list li {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .docket-title {
    color: var(--text-muted);
  }
  .meeting-links {
    gap: var(--space-1) var(--space-4);
  }
</style>
