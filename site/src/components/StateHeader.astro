---
/**
 * The header shared by a state's pages: its name and the tab row (Overview,
 * Legislature, Bills, Committees, Ballot questions, Budget, Governor, Courts, Congress, Local). Each tab
 * is its own page.
 */
import {
  loadBallotQuestions,
  loadMembers,
  loadStateBudgets,
  loadStateCommittees,
  loadStateCourtCases,
  loadStateLegislators,
  loadStateOrders,
} from '../lib/build-data';
import { LEGISLATURE_STATES, stateName } from '../lib/format';
import { stateTabs, type StateTab } from '../lib/state-tabs';
import PageTabs from './PageTabs.astro';

interface Props {
  code: string;
  current: StateTab;
}

const { code, current } = Astro.props;
const name = stateName(code);
const legislature = LEGISLATURE_STATES.includes(code);
const [members, legislators, committees, cases, orders, ballot, budgets] = await Promise.all([
  loadMembers(),
  loadStateLegislators(),
  loadStateCommittees(),
  loadStateCourtCases(),
  loadStateOrders(),
  loadBallotQuestions(),
  loadStateBudgets(),
]);
const tabs = stateTabs(code, current, {
  legislature,
  legislators: legislature ? (legislators.get(code)?.length ?? 0) : 0,
  committees: (committees.get(code) ?? []).filter((c) => c.classification !== 'subcommittee').length,
  congress: [...members.values()].filter((m) => m.current && m.state === code).length,
  orders: orders.get(code)?.length ?? 0,
  cases: cases.get(code)?.length ?? 0,
  ballot: ballot.get(code)?.length ?? 0,
  budget: budgets.has(code),
});
---

<h1>{name}</h1>
<PageTabs label={name} tabs={tabs} />
